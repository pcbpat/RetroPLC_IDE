<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RetroPLC.Shell"
             xmlns:theme="using:RetroPLC.Theme"
             x:Class="RetroPLC.Shell.App"
             RequestedThemeVariant="{x:Static theme:ThemeVariants.Dark}">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <theme:RetroPlcTheme />
    </Application.Styles>
</Application>
