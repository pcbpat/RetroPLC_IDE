<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        xmlns:icons="using:RetroPLC.Icons"
        x:Class="RetroPLC.Shell.Views.AddDataTypeWindow"
        Title="Add Data Type"
        Icon="avares://RetroPLC.Icons/Win98SE/SE98/mimes/32/text-x-generic.png"
        Width="520"
        Height="410"
        MinWidth="500"
        MinHeight="390"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CaretBrush"
                    Value="{DynamicResource {x:Static common:SystemColors.WindowTextBrushKey}}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,1,*,Auto">
        <Grid Grid.Row="0" Margin="18,15" ColumnDefinitions="42,*">
            <Image Width="32" Height="32"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="None"
                   Source="{x:Static icons:Se98Icons+Mimes+Size32.TextXGeneric}" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Create a new IEC 61131-3 derived data type" />
                <TextBlock Opacity="0.72"
                           Text="The declaration is stored as a Structured Text source file." />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}" />

        <Grid Grid.Row="2" Margin="18,14"
              RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="9">
            <Grid ColumnDefinitions="100,*">
                <TextBlock VerticalAlignment="Center" Text="Name:" />
                <TextBox x:Name="NameBox" Grid.Column="1" Text="NewType"
                         TextChanged="Input_OnChanged" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="100,*">
                <TextBlock VerticalAlignment="Center" Text="Kind:" />
                <ComboBox x:Name="KindBox" Grid.Column="1" SelectedIndex="0"
                          SelectionChanged="KindBox_OnSelectionChanged">
                    <ComboBoxItem Content="Structure" />
                    <ComboBoxItem Content="Enumeration" />
                    <ComboBoxItem Content="Alias" />
                    <ComboBoxItem Content="Subrange" />
                    <ComboBoxItem Content="Array" />
                </ComboBox>
            </Grid>

            <TextBlock x:Name="DefinitionLabel" Grid.Row="2" Text="Fields:" />
            <TextBox x:Name="DefinitionBox" Grid.Row="3"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,Monospace"
                     TextChanged="Input_OnChanged" />
            <TextBlock x:Name="DefinitionHelp" Grid.Row="4"
                       Opacity="0.72" TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="3"
                Padding="12,10"
                BorderBrush="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ValidationText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static common:SystemColors.HotTrackBrushKey}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddButton" Width="82" Content="Add" IsDefault="True"
                            Click="Add_OnClick" />
                    <Button Width="82" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
