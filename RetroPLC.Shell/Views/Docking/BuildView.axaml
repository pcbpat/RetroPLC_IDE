<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroPLC.Shell.ViewModels.Docking"
             xmlns:commonControls="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
             x:Class="RetroPLC.Shell.Views.Docking.BuildView"
             x:DataType="vm:BuildViewModel">
    <ListBox x:Name="OutputList"
             ItemsSource="{Binding Output}"
             AutoScrollToSelectedItem="False"
             FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,Monospace"
             FontSize="{DynamicResource RetroPLC.Shell.CodeTextSize}"
             Background="{DynamicResource {x:Static commonControls:SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static commonControls:SystemColors.WindowTextBrushKey}}"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.AllowAutoHide="False" />
</UserControl>
