<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroPLC.Shell.ViewModels.Docking"
             x:Class="RetroPLC.Shell.Views.Docking.AppearanceView"
             x:DataType="vm:AppearanceViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8" Spacing="8">
            <GroupBox Header="Color scheme">
                <CheckBox Margin="6"
                          Content="Dark mode"
                          IsChecked="{Binding Settings.IsDarkMode}" />
            </GroupBox>

            <GroupBox Header="Font">
                <Grid Margin="6"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center"
                               Text="Text size:" />
                    <ComboBox Grid.Column="1"
                              Width="80"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding Settings.TextSizes}"
                              SelectedItem="{Binding Settings.TextSize}" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
