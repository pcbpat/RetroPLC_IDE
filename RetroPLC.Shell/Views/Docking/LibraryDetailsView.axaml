<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RetroPLC.Shell.ViewModels.Docking"
             xmlns:commonControls="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
             x:Class="RetroPLC.Shell.Views.Docking.LibraryDetailsView"
             x:DataType="vm:LibraryDetailsViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="LibrarySymbolTemplate"
                      DataType="vm:LibrarySymbolInfo"
                      x:DataType="vm:LibrarySymbolInfo">
            <Grid Margin="3,2"
                  ToolTip.Tip="{Binding Documentation}">
                <StackPanel>
                    <TextBlock FontWeight="Bold"
                               Text="{Binding Name}" />
                    <TextBlock Foreground="{DynamicResource {x:Static commonControls:SystemColors.GrayTextBrushKey}}"
                               Text="{Binding Signature}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*"
          Background="{DynamicResource {x:Static commonControls:SystemColors.WindowBrushKey}}">
        <Border Padding="10"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static commonControls:SystemColors.ControlDarkBrushKey}}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Text="{Binding DisplayName}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Column="1"
                      Margin="20,0,0,0"
                      ColumnDefinitions="Auto,Auto"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="8">
                    <TextBlock FontWeight="Bold" Text="Version:" />
                    <TextBlock Grid.Column="1" Text="{Binding Version}" />
                    <TextBlock Grid.Row="1" FontWeight="Bold" Text="Namespace:" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Namespace}" />
                    <TextBlock Grid.Row="2" FontWeight="Bold" Text="Built in:" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IsBuiltIn}" />
                    <TextBlock Grid.Row="3" FontWeight="Bold" Text="Sources:" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SourceCount}" />
                    <TextBlock Grid.Row="4" FontWeight="Bold" Text="Archive:" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ArchiveSize}" />
                    <TextBlock Grid.Row="5" FontWeight="Bold" Text="Format:" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FormatVersion}" />
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="8">
            <TabItem Header="{Binding FunctionsHeader}">
                <ListBox ItemsSource="{Binding Functions}"
                         ItemTemplate="{StaticResource LibrarySymbolTemplate}" />
            </TabItem>
            <TabItem Header="{Binding FunctionBlocksHeader}">
                <ListBox ItemsSource="{Binding FunctionBlocks}"
                         ItemTemplate="{StaticResource LibrarySymbolTemplate}" />
            </TabItem>
            <TabItem Header="{Binding DataTypesHeader}">
                <ListBox ItemsSource="{Binding DataTypes}"
                         ItemTemplate="{StaticResource LibrarySymbolTemplate}" />
            </TabItem>
            <TabItem Header="{Binding GlobalsHeader}">
                <ListBox ItemsSource="{Binding Globals}"
                         ItemTemplate="{StaticResource LibrarySymbolTemplate}" />
            </TabItem>
            <TabItem Header="{Binding DependenciesHeader}">
                <ListBox ItemsSource="{Binding Dependencies}"
                         ItemTemplate="{StaticResource LibrarySymbolTemplate}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
