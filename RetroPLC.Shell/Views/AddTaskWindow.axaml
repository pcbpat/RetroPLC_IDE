<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        xmlns:icons="using:RetroPLC.Icons"
        x:Class="RetroPLC.Shell.Views.AddTaskWindow"
        Title="Add Task"
        Icon="avares://RetroPLC.Icons/Win98SE/SE98/apps/32/codeblocks.png"
        Width="480"
        Height="380"
        MinWidth="450"
        MinHeight="360"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CaretBrush"
                    Value="{DynamicResource {x:Static common:SystemColors.WindowTextBrushKey}}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,1,*,Auto">
        <Grid Grid.Row="0" Margin="18,15" ColumnDefinitions="42,*">
            <Image Width="32" Height="32"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="None"
                   Source="{x:Static icons:Se98Icons+Actions+Size32.Appointment}" />
            <StackPanel Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                <TextBlock Text="Create a new IEC 61131-3 Task" />
                <TextBlock Opacity="0.72"
                           Text="TASKs schedule PROGRAM instances inside a RESOURCE." />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}" />

        <Grid Grid.Row="2" Margin="18,14" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
            <Grid ColumnDefinitions="90,*">
                <TextBlock VerticalAlignment="Center" Text="Name:" />
                <TextBox x:Name="NameBox"
                         Grid.Column="1"
                         Text="Task"
                         TextChanged="NameBox_OnTextChanged" />
            </Grid>

            <GroupBox Grid.Row="1" Header="Trigger" Padding="12,9">
                <Grid ColumnDefinitions="Auto,190,12,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <RadioButton x:Name="CyclicButton"
                                 Grid.Row="0" Grid.Column="0"
                                 GroupName="TriggerType"
                                 Content="Cyclic"
                                 IsChecked="True"
                                 IsCheckedChanged="Trigger_OnChecked" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="Interval:" />
                    <TextBox x:Name="IntervalBox"
                             Grid.Row="0" Grid.Column="3"
                             Text="T#20ms"
                             TextChanged="NameBox_OnTextChanged" />

                    <RadioButton x:Name="InterruptButton"
                                 Grid.Row="1" Grid.Column="0"
                                 GroupName="TriggerType"
                                 Content="Interrupt"
                                 IsCheckedChanged="Trigger_OnChecked" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="SINGLE:" />
                    <TextBox x:Name="EventExpressionBox"
                             Grid.Row="1" Grid.Column="3"
                             Text="TRUE"
                             IsEnabled="False"
                             TextChanged="NameBox_OnTextChanged" />
                </Grid>
            </GroupBox>

            <Grid Grid.Row="2" ColumnDefinitions="90,*">
                <TextBlock VerticalAlignment="Center" Text="Priority:" />
                <TextBox x:Name="PriorityBox"
                         Grid.Column="1"
                         Text="1"
                         TextChanged="NameBox_OnTextChanged" />
            </Grid>

            <TextBlock Grid.Row="3"
                       Opacity="0.72"
                       Text="Cyclic tasks repeat at the interval; interrupt tasks fire on the SINGLE expression."
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="4"
                       Opacity="0.72"
                       Text="Priority: lower numbers run first." />
        </Grid>

        <Border Grid.Row="3"
                Padding="12,10"
                BorderBrush="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ValidationText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static common:SystemColors.HotTrackBrushKey}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AddButton" Width="82" Content="Add" IsDefault="True" Click="Add_OnClick" />
                    <Button Width="82" Content="Cancel" IsCancel="True" Click="Cancel_OnClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
