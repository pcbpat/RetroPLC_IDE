<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        x:Class="RetroPLC.Shell.Views.RenameSymbolWindow"
        Title="Rename Symbol"
        Width="420"
        Height="175"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="CaretBrush"
                    Value="{DynamicResource {x:Static common:SystemColors.WindowTextBrushKey}}" />
        </Style>
    </Window.Styles>

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <TextBlock Text="New symbol name:" />
        <TextBox x:Name="NameBox"
                 Grid.Row="1"
                 TextChanged="NameBox_OnTextChanged" />
        <TextBlock x:Name="ValidationText"
                   Grid.Row="2"
                   Foreground="{DynamicResource {x:Static common:SystemColors.HotTrackBrushKey}}" />
        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button x:Name="RenameButton"
                    Width="86"
                    Content="Rename"
                    IsDefault="True"
                    Click="Rename_OnClick" />
            <Button Width="86"
                    Content="Cancel"
                    IsCancel="True"
                    Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
