<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="using:RetroPLC.Theme"
        xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:search="clr-namespace:AvaloniaEdit.Search;assembly=AvaloniaEdit"
        xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
        x:Class="RetroPLC.Theme.RetroPlcTheme">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- RetroPLC.Light currently uses the unmodified Classic palette.
                     This dictionary is the extension point for future light overrides. -->
                <ResourceDictionary x:Key="{x:Static theme:ThemeVariants.Light}" />

                <!-- Missing resources fall back through RetroPLC.Dark's parent,
                     ClassicTheme.Classic, and then Avalonia's Light variant. -->
                <ResourceDictionary x:Key="{x:Static theme:ThemeVariants.Dark}">
                    <Color x:Key="{x:Static common:SystemColors.ActiveBorderColorKey}">#484848</Color>
                    <Color x:Key="{x:Static common:SystemColors.ActiveCaptionColorKey}">#000073</Color>
                    <Color x:Key="{x:Static common:SystemColors.ActiveCaptionTextColorKey}">#FFFFFF</Color>
                    <Color x:Key="{x:Static common:SystemColors.AppWorkspaceColorKey}">#181818</Color>
                    <Color x:Key="{x:Static common:SystemColors.ControlColorKey}">#303030</Color>
                    <Color x:Key="{x:Static common:SystemColors.ControlDarkColorKey}">#1B1B1B</Color>
                    <Color x:Key="{x:Static common:SystemColors.ControlDarkDarkColorKey}">#080808</Color>
                    <Color x:Key="{x:Static common:SystemColors.ControlLightColorKey}">#505050</Color>
                    <Color x:Key="{x:Static common:SystemColors.ControlLightLightColorKey}">#707070</Color>
                    <Color x:Key="{x:Static common:SystemColors.ControlTextColorKey}">#F0F0F0</Color>
                    <Color x:Key="{x:Static common:SystemColors.DesktopColorKey}">#0D0D21</Color>
                    <Color x:Key="{x:Static common:SystemColors.GradientActiveCaptionColorKey}">#094C78</Color>
                    <Color x:Key="{x:Static common:SystemColors.GradientInactiveCaptionColorKey}">#052F4A</Color>
                    <Color x:Key="{x:Static common:SystemColors.GrayTextColorKey}">#8A8A8A</Color>
                    <Color x:Key="{x:Static common:SystemColors.HighlightColorKey}">#000073</Color>
                    <Color x:Key="{x:Static common:SystemColors.HighlightTextColorKey}">#FFFFFF</Color>
                    <Color x:Key="{x:Static common:SystemColors.HotTrackColorKey}">#1084D0</Color>
                    <Color x:Key="{x:Static common:SystemColors.InactiveBorderColorKey}">#3C3C3C</Color>
                    <Color x:Key="{x:Static common:SystemColors.InactiveCaptionColorKey}">#000037</Color>
                    <Color x:Key="{x:Static common:SystemColors.InactiveCaptionTextColorKey}">#D0D0D0</Color>
                    <Color x:Key="{x:Static common:SystemColors.InfoColorKey}">#383426</Color>
                    <Color x:Key="{x:Static common:SystemColors.InfoTextColorKey}">#F0F0F0</Color>
                    <Color x:Key="{x:Static common:SystemColors.MenuColorKey}">#303030</Color>
                    <Color x:Key="{x:Static common:SystemColors.MenuBarColorKey}">#303030</Color>
                    <Color x:Key="{x:Static common:SystemColors.MenuHighlightColorKey}">#000073</Color>
                    <Color x:Key="{x:Static common:SystemColors.MenuTextColorKey}">#F0F0F0</Color>
                    <Color x:Key="{x:Static common:SystemColors.ScrollBarColorKey}">#383838</Color>
                    <Color x:Key="{x:Static common:SystemColors.WindowColorKey}">#1E1E1E</Color>
                    <Color x:Key="{x:Static common:SystemColors.WindowFrameColorKey}">#080808</Color>
                    <Color x:Key="{x:Static common:SystemColors.WindowTextColorKey}">#F0F0F0</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Dock 12 drag previews are not covered by the upstream Classic theme. -->
            <ControlTheme x:Key="{x:Type DragPreviewWindow}"
                          TargetType="DragPreviewWindow"
                          BasedOn="{StaticResource {x:Type Window}}">
                <Setter Property="WindowDecorations" Value="None" />
                <Setter Property="ShowInTaskbar" Value="False" />
                <Setter Property="CanResize" Value="False" />
                <Setter Property="ShowActivated" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="TransparencyLevelHint" Value="Transparent" />
                <Setter Property="SizeToContent" Value="WidthAndHeight" />
                <Setter Property="MaxWidth" Value="480" />
                <Setter Property="MaxHeight" Value="360" />
                <Setter Property="Topmost" Value="True" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </ControlTheme>
            <ControlTheme x:Key="{x:Type DragPreviewControl}"
                          TargetType="DragPreviewControl">
                <Setter Property="Template">
                    <ControlTemplate>
                        <Border Padding="8,5"
                                Background="{DynamicResource {x:Static common:SystemColors.ControlBrushKey}}"
                                BorderBrush="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="{ReflectionBinding Title}" />
                                <TextBlock Opacity="0.7" Text="{TemplateBinding Status}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <ClassicTheme FontAliasing="False" />
    <StyleInclude Source="avares://Classic.Avalonia.Theme.Dock/Classic.axaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />

    <Style Selector="edit|TextEditor">
        <Setter Property="Background"
                Value="{DynamicResource {x:Static common:SystemColors.WindowBrushKey}}" />
        <Setter Property="Foreground"
                Value="{DynamicResource {x:Static common:SystemColors.ControlTextBrushKey}}" />
        <Setter Property="LineNumbersForeground"
                Value="{DynamicResource {x:Static common:SystemColors.GrayTextBrushKey}}" />
    </Style>

    <!-- AvaloniaEdit's Simple theme maps SearchPanel to SimpleTheme resource
         names. Rebind it to the Classic system palette used by RetroPLC. -->
    <Style Selector="search|SearchPanel">
        <Setter Property="Background"
                Value="{DynamicResource {x:Static common:SystemColors.ControlBrushKey}}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}" />
        <Setter Property="Foreground"
                Value="{DynamicResource {x:Static common:SystemColors.ControlTextBrushKey}}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="common|StatusBar">
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.StatusBarHeight}" />
    </Style>
    <Style Selector="ToolTabStripItem">
        <Setter Property="MinHeight" Value="{DynamicResource RetroPLC.Shell.DockTabMinHeight}" />
    </Style>
    <Style Selector="DocumentTabStripItem">
        <Setter Property="MinHeight" Value="{DynamicResource RetroPLC.Shell.DockTabMinHeight}" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Button">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.DockButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.DockButtonSize}" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToolChromeControl /template/ Button:pointerover">
        <Setter Property="Background" Value="#20000000" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Button:pressed">
        <Setter Property="Background" Value="#40000000" />
    </Style>
    <Style Selector="DocumentTabStripItem /template/ Button#PART_CloseButton">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.DockButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.DockButtonSize}" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Path#PART_ClosePath">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.DockCloseGlyphWidth}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.DockCloseGlyphHeight}" />
    </Style>
    <Style Selector="DocumentTabStripItem /template/ Path#PART_ClosePath">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.DockCloseGlyphWidth}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.DockCloseGlyphHeight}" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Path#PART_PinPath">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.DockPinGlyphWidth}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.DockPinGlyphHeight}" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style Selector="ToolChromeControl:pinned /template/ Path#PART_PinPath">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.DockPinGlyphHeight}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.DockPinGlyphWidth}" />
        <Setter Property="MinWidth" Value="9" />
        <Setter Property="MinHeight" Value="6" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Path#PART_MenuPath">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.DockMenuGlyphWidth}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.DockMenuGlyphHeight}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.MenuItemHeight}" />
        <Setter Property="Padding" Value="{DynamicResource RetroPLC.Shell.MenuItemPadding}" />
    </Style>
    <Style Selector="MenuItem:separator">
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.MenuSeparatorHeight}" />
    </Style>
    <Style Selector="MenuItem /template/ Path#rightArrow">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.MenuArrowWidth}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.MenuArrowHeight}" />
        <Setter Property="Stretch" Value="Fill" />
    </Style>
    <Style Selector="MenuItem /template/ ContentControl#PART_ToggleIconPresenter Path">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.MenuCheckSize}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.MenuCheckSize}" />
        <Setter Property="Stretch" Value="Fill" />
    </Style>
    <Style Selector="MenuItem /template/ ContentControl#PART_ToggleIconPresenter Ellipse">
        <Setter Property="Width" Value="{DynamicResource RetroPLC.Shell.MenuCheckSize}" />
        <Setter Property="Height" Value="{DynamicResource RetroPLC.Shell.MenuCheckSize}" />
    </Style>

    <Style Selector="DocumentControl /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToolControl /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static common:SystemColors.ControlDarkBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ProportionalStackPanelSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToolChromeControl /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="ToolChromeControl:floating /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Grid#PART_Grip">
        <Setter Property="Background" Value="{DynamicResource {x:Static common:SystemColors.InactiveCaptionBrushKey}}" />
    </Style>
    <Style Selector="ToolChromeControl:active /template/ Grid#PART_Grip">
        <Setter Property="Background" Value="{DynamicResource {x:Static common:SystemColors.ActiveCaptionBrushKey}}" />
    </Style>
    <Style Selector="ToolChromeControl /template/ TextBlock#PART_Title">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.InactiveCaptionTextBrushKey}}" />
    </Style>
    <Style Selector="ToolChromeControl:active /template/ TextBlock#PART_Title">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static common:SystemColors.ActiveCaptionTextBrushKey}}" />
    </Style>
    <Style Selector="ToolChromeControl /template/ Path">
        <Setter Property="Fill" Value="{DynamicResource {x:Static common:SystemColors.InactiveCaptionTextBrushKey}}" />
    </Style>
    <Style Selector="ToolChromeControl:active /template/ Path">
        <Setter Property="Fill" Value="{DynamicResource {x:Static common:SystemColors.ActiveCaptionTextBrushKey}}" />
    </Style>

    <Style Selector="DockTarget /template/ Panel#PART_TopIndicator">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Top" />
    </Style>
    <Style Selector="DockTarget /template/ Panel#PART_BottomIndicator">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Bottom" />
    </Style>
    <Style Selector="DockTarget /template/ Panel#PART_LeftIndicator">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Left" />
    </Style>
    <Style Selector="DockTarget /template/ Panel#PART_RightIndicator">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Right" />
    </Style>
    <Style Selector="DockTarget /template/ Panel#PART_CenterIndicator">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Fill" />
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_TopSelector">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Top" />
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_BottomSelector">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Bottom" />
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_LeftSelector">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Left" />
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_RightSelector">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Right" />
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_CenterSelector">
        <Setter Property="(DockProperties.IndicatorDockOperation)" Value="Fill" />
    </Style>
</Styles>
