      "kind": "functionBlock",
      "header": "class MC_READSTATUS {\npublic:\n    // In-Out\n    AXIS_REF_SM3 AXIS;\n    // Inputs\n    IEC_BOOL ENABLE;\n    // Outputs\n    IEC_BOOL VALID;\n    IEC_BOOL BUSY;\n    IEC_BOOL ERROR;\n    IEC_SMC_ERROR ERRORID;\n    IEC_BOOL DISABLED;\n    IEC_BOOL ERRORSTOP;\n    IEC_BOOL STOPPING;\n    IEC_BOOL STANDSTILL;\n    IEC_BOOL DISCRETEMOTION;\n    IEC_BOOL CONTINUOUSMOTION;\n    IEC_BOOL SYNCHRONIZEDMOTION;\n    IEC_BOOL HOMING;\n    IEC_BOOL CONSTANTVELOCITY;\n    IEC_BOOL ACCELERATING;\n    IEC_BOOL DECELERATING;\n    IEC_BOOL FBERROROCCURED;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    MC_READSTATUS();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~MC_READSTATUS() = default;\n};\n",
      "cpp": "MC_READSTATUS::MC_READSTATUS() {\n    // Initialize variables\n}\n\nvoid MC_READSTATUS::operator()() {\n    VALID = ENABLE;\n    BUSY = false;\n    if (ENABLE) {\n        DISABLED = AXIS.NAXISSTATE == SMC_AXIS_STATE::POWER_OFF;\n        ERRORSTOP = AXIS.NAXISSTATE == SMC_AXIS_STATE::ERRORSTOP;\n        STOPPING = AXIS.NAXISSTATE == SMC_AXIS_STATE::STOPPING;\n        STANDSTILL = AXIS.NAXISSTATE == SMC_AXIS_STATE::STANDSTILL;\n        DISCRETEMOTION = AXIS.NAXISSTATE == SMC_AXIS_STATE::DISCRETE_MOTION;\n        CONTINUOUSMOTION = AXIS.NAXISSTATE == SMC_AXIS_STATE::CONTINUOUS_MOTION;\n        SYNCHRONIZEDMOTION = AXIS.NAXISSTATE == SMC_AXIS_STATE::SYNCHRONIZED_MOTION;\n        HOMING = AXIS.NAXISSTATE == SMC_AXIS_STATE::HOMING;\n        ERROR = AXIS.BERROR;\n        FBERROROCCURED = AXIS.BERROR;\n        if (AXIS.BERROR) {\n            ERRORID = SMC_ERROR::SMC_DI_AXIS_ERROR;\n        } else {\n            ERRORID = SMC_ERROR::SMC_NO_ERROR;\n        }\n    }\n}\n",
