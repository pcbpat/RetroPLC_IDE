    "displayName": "PLCopen SoftMotion (Light)",
    "description": "CODESYS SoftMotion (SM3) compatible PLCopen Motion Control for CiA 402 servo drives. AXIS_REF_SM3 + MC_* blocks in LREAL technical units, over the OpenSML light SoftMotion engine (GPL-3.0, https://github.com/feecat/OpenSML) and S7RTT OTG (Apache-2.0, https://github.com/feecat/S7RTT)."
  },
  "chunks": [
    {
      "name": "OPENSML_AXIS",
      "kind": "type",
      "header": "struct OPENSML_AXIS {\n    IEC_UINT CONTROLWORD{};\n    IEC_SINT MODES_OF_OPERATION{};\n    IEC_DINT TARGET_POSITION{};\n    IEC_UDINT PROFILE_VELOCITY{};\n    IEC_DINT TARGET_VELOCITY{};\n    IEC_INT TARGET_TORQUE{};\n    IEC_UINT STATUSWORD{};\n    IEC_SINT MODES_OF_OPERATION_DISPLAY{};\n    IEC_INT TORQUE_ACTUAL_VALUE{};\n    IEC_DINT POSITION_ACTUAL_VALUE{};\n    IEC_DINT VELOCITY_ACTUAL_VALUE{};\n    IEC_INT CURRENT_ACTUAL_VALUE{};\n    IEC_DINT FOLLOWING_ERROR_ACTUAL_VALUE{};\n};\n\nusing IEC_OPENSML_AXIS = OPENSML_AXIS;\n",
      "cpp": "",
      "deps": []
    },
    {
      "name": "OPENSML_CONTROL",
      "kind": "type",
      "header": "struct OPENSML_CONTROL {\n    IEC_BOOL XAXISENABLE{};\n    IEC_BOOL XMOVEENABLE{};\n    IEC_BOOL XHOMEENABLE{};\n    IEC_BOOL XSIMULATION{};\n    IEC_BOOL XEMERGENCYSTOP = true;\n    IEC_BOOL JOGPOS{};\n    IEC_BOOL JOGNEG{};\n    IEC_LREAL JOGVELOCITY = 10;\n    IEC_LREAL LRACTUALPOSITION{};\n    IEC_LREAL LRFOLLOWPOSITION{};\n    IEC_LREAL LRFOLLOWVELOCITY = 20;\n    IEC_BOOL XFOLLOWENABLE{};\n    IEC_BOOL XERROR{};\n    IEC_BOOL XBUSY{};\n    IEC_BOOL XINPOSITION{};\n    IEC_BOOL XENABLED{};\n    IEC_BOOL XHOMEDONE{};\n    IEC_LREAL MAXVELOCITY = 100;\n    IEC_LREAL MAXACCELERATION = 1000;\n    IEC_LREAL MAXJERK = 10000;\n    IEC_LREAL CYCLETIME = 0.001;\n    IEC_LREAL SCALE = 4096;\n    OPENSML_AXIS AXIS{};\n};\n\nusing IEC_OPENSML_CONTROL = OPENSML_CONTROL;\n",
      "cpp": "",
      "deps": [
        {
          "library": "plcopen-softmotion",
          "name": "OPENSML_AXIS"
        }
      ]
    },
    {
