    {
      "name": "OPENSML_POWER",
      "kind": "functionBlock",
      "header": "class OPENSML_POWER {\npublic:\n    // In-Out\n    OPENSML_AXIS AXIS;\n    // Inputs\n    IEC_BOOL XENABLE;\n    IEC_BOOL XEMERGENCYSTOP;\n    // Outputs\n    IEC_BOOL XDONE;\n    IEC_BOOL XERROR;\n    // Local variables\n    IEC_INT ISTATE;\n    TON TONTIMEOUT;\n    IEC_TIME TTIMEOUT;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    OPENSML_POWER();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~OPENSML_POWER() = default;\n};\n",
      "cpp": "OPENSML_POWER::OPENSML_POWER()\n    : XEMERGENCYSTOP(true), TTIMEOUT(500000000LL)\n{\n    // Initialize variables\n}\n\nvoid OPENSML_POWER::operator()() {\n    AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 2)) | ((XEMERGENCYSTOP ? 1ULL : 0ULL) << 2);\n    switch (ISTATE) {\n        case 0:\n            XDONE = false;\n            XERROR = false;\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 0)) | ((false ? 1ULL : 0ULL) << 0);\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 1)) | ((false ? 1ULL : 0ULL) << 1);\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((false ? 1ULL : 0ULL) << 3);\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 7)) | ((false ? 1ULL : 0ULL) << 7);\n            if (XENABLE) {\n                if (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1)) {\n                    ISTATE = 10;\n                } else {\n                    ISTATE = 20;\n                }\n            }\n            break;\n        case 10:\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 7)) | ((true ? 1ULL : 0ULL) << 7);\n            TONTIMEOUT.IN = true;\n            TONTIMEOUT.PT = TTIMEOUT;\n            TONTIMEOUT();\n            TONTIMEOUT.ENO = true;\n            if ((TONTIMEOUT.Q) & (!((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) {\n                AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 7)) | ((false ? 1ULL : 0ULL) << 7);\n                TONTIMEOUT.IN = false;\n                TONTIMEOUT();\n                TONTIMEOUT.ENO = true;\n                ISTATE = 20;\n            } else if (TONTIMEOUT.Q) {\n                ISTATE = 999;\n            }\n            break;\n        case 20:\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 1)) | ((true ? 1ULL : 0ULL) << 1);\n            TONTIMEOUT.IN = true;\n            TONTIMEOUT.PT = TTIMEOUT;\n            TONTIMEOUT();\n            TONTIMEOUT.ENO = true;\n            if (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 0) & 1)) {\n                TONTIMEOUT.IN = false;\n                TONTIMEOUT();\n                TONTIMEOUT.ENO = true;\n                ISTATE = 30;\n            } else if (TONTIMEOUT.Q) {\n                ISTATE = 999;\n            }\n            break;\n        case 30:\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 0)) | ((true ? 1ULL : 0ULL) << 0);\n            TONTIMEOUT.IN = true;\n            TONTIMEOUT.PT = TTIMEOUT;\n            TONTIMEOUT();\n            TONTIMEOUT.ENO = true;\n            if (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1)) {\n                TONTIMEOUT.IN = false;\n                TONTIMEOUT();\n                TONTIMEOUT.ENO = true;\n                ISTATE = 40;\n            } else if (TONTIMEOUT.Q) {\n                ISTATE = 999;\n            }\n            break;\n        case 40:\n            AXIS.TARGET_POSITION = AXIS.POSITION_ACTUAL_VALUE;\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((true ? 1ULL : 0ULL) << 3);\n            TONTIMEOUT.IN = true;\n            TONTIMEOUT.PT = TTIMEOUT;\n            TONTIMEOUT();\n            TONTIMEOUT.ENO = true;\n            if (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1)) {\n                TONTIMEOUT.IN = false;\n                TONTIMEOUT();\n                TONTIMEOUT.ENO = true;\n                ISTATE = 50;\n            } else if (TONTIMEOUT.Q) {\n                ISTATE = 999;\n            }\n            break;\n        case 50:\n            XDONE = true;\n            if (!XENABLE) {\n                AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((false ? 1ULL : 0ULL) << 3);\n                ISTATE = 0;\n            }\n            if (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1)) {\n                ISTATE = 999;\n            }\n            break;\n        case 999:\n            TONTIMEOUT.IN = false;\n            TONTIMEOUT();\n            TONTIMEOUT.ENO = true;\n            XERROR = true;\n            if (!XENABLE) {\n                ISTATE = 0;\n            }\n            break;\n    }\n}\n",
