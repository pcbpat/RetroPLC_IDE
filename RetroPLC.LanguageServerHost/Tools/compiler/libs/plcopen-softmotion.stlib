      SE = SD;\n                            MFLAG = true;\n                        }\n                        SA = SB;\n                        FA = FB;\n                        if (ABS(SD) > TOL1) {\n                            SB = SB + SD;\n                        } else {\n                            if (XM > 0.0) {\n                                SB = SB + TOL1;\n                            } else {\n                                SB = SB - TOL1;\n                            }\n                        }\n                        FB = FC_S7RTT_CALCTRAJDIST(SB, C_VEL, C_ACC, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX) - DIST_REQ;\n                        if ((((FB > 0.0) & (FC > 0.0))) | (((FB < 0.0) & (FC < 0.0)))) {\n                            SC = SA;\n                            FC = FA;\n                            SD = SB - SA;\n                            SE = SD;\n                            MFLAG = true;\n                        }\n                    }\n                    __strucpp_loop_exit_9: ;\n                    BEST_V = SB;\n                }\n            }\n            SHAPE_CNT = FC_S7RTT_BUILDPROFILE(C_VEL, C_ACC, BEST_V, LIMITS.FACCMAX, LIMITS.FJERKMAX, T_SHAPE_BUF, J_SHAPE_BUF);\n            for (I = 1; I <= SHAPE_CNT; I++) {\n                if (SEGMENTCOUNT < 32) {\n                    SEGMENTCOUNT = SEGMENTCOUNT + 1;\n                    TRAJECTORY.at(SEGMENTCOUNT).FDURATION = T_SHAPE_BUF.at(I);\n                    TRAJECTORY.at(SEGMENTCOUNT).FJERK = J_SHAPE_BUF.at(I);\n                }\n                C_POS = C_POS + C_VEL * T_SHAPE_BUF.at(I) + 0.5 * C_ACC * T_SHAPE_BUF.at(I) * T_SHAPE_BUF.at(I) + (1.0 / 6.0) * J_SHAPE_BUF.at(I) * T_SHAPE_BUF.at(I) * T_SHAPE_BUF.at(I) * T_SHAPE_BUF.at(I);\n                C_VEL = C_VEL + C_ACC * T_SHAPE_BUF.at(I) + 0.5 * J_SHAPE_BUF.at(I) * T_SHAPE_BUF.at(I) * T_SHAPE_BUF.at(I);\n                C_ACC = C_ACC + J_SHAPE_BUF.at(I) * T_SHAPE_BUF.at(I);\n            }\n            C_ACC = 0.0;\n            SIM_P = C_POS;\n            SIM_V = C_VEL;\n            SIM_A = 0.0;\n            SHAPE_CNT = FC_S7RTT_BUILDPROFILE(SIM_V, SIM_A, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX, T_SHAPE_BUF, J_SHAPE_BUF);\n            for (K = 1; K <= SHAPE_CNT; K++) {\n                SIM_P = SIM_P + SIM_V * T_SHAPE_BUF.at(K) + 0.5 * SIM_A * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) + (1.0 / 6.0) * J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                SIM_V = SIM_V + SIM_A * T_SHAPE_BUF.at(K) + 0.5 * J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                SIM_A = SIM_A + J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n            }\n            GAP = TARGETPOS - SIM_P;\n            if ((ABS(C_VEL) > EPS_VAL) & (ABS(GAP) > EPS_DIST)) {\n                T_CRUISE = GAP / C_VEL;\n                if (T_CRUISE > EPS_TIME) {\n                    if (SEGMENTCOUNT < 32) {\n                        SEGMENTCOUNT = SEGMENTCOUNT + 1;\n                        TRAJECTORY.at(SEGMENTCOUNT).FDURATION = T_CRUISE;\n                        TRAJECTORY.at(SEGMENTCOUNT).FJERK = 0.0;\n                    }\n                    C_POS = C_POS + C_VEL * T_CRUISE;\n                }\n            }\n            SHAPE_CNT = FC_S7RTT_BUILDPROFILE(C_VEL, C_ACC, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX, T_SHAPE_BUF, J_SHAPE_BUF);\n            for (I = 1; I <= SHAPE_CNT; I++) {\n                if (SEGMENTCOUNT < 32) {\n                    SEGMENTCOUNT = SEGMENTCOUNT + 1;\n                    TRAJECTORY.at(SEGMENTCOUNT).FDURATION = T_SHAPE_BUF.at(I);\n                    TRAJECTORY.at(SEGMENTCOUNT).FJERK = J_SHAPE_BUF.at(I);\n                }\n            }\n        }\n    }\n    if ((SEGMENTCOUNT > 0) & (!MODEVELOCITY)) {\n        C_POS = STARTSTATE.FPOS;\n        C_VEL = STARTSTATE.FVEL;\n        C_ACC = STARTSTATE.FACC;\n        REF_IDX = -1;\n        MAX_DT = -1.0;\n        for (I = 1; I <= SEGMENTCOUNT; I++) {\n            T_REC = TRAJECTORY.at(I).FDURATION;\n            J_RESTORE = TRAJECTORY.at(I).FJERK;\n            if ((ABS(J_RESTORE) < MATH_EPS) & (ABS(C_ACC) < EPS_ACC)) {\n                if (T_REC > MAX_DT) {\n                    MAX_DT = T_REC;\n                    REF_IDX = I;\n                    V_CRUISE_START = C_VEL;\n                }\n            }\n            C_POS = C_POS + C_VEL * T_REC + 0.5 * C_ACC * T_REC * T_REC + (1.0 / 6.0) * J_RESTORE * T_REC * T_REC * T_REC;\n            C_VEL = C_VEL + C_ACC * T_REC + 0.5 * J_RESTORE * T_REC * T_REC;\n            C_ACC = C_ACC + J_RESTORE * T_REC;\n        }\n        GAP = TARGETPOS - C_POS;\n        if (((REF_IDX != -1) & (ABS(GAP) > EPS_DIST)) & (ABS(V_CRUISE_START) > EPS_VAL)) {\n            DT_FIX = GAP / V_CRUISE_START;\n            TRAJECTORY.at(REF_IDX).FDURATION = TRAJECTORY.at(REF_IDX).FDURATION + DT_FIX;\n            if (TRAJECTORY.at(REF_IDX).FDURATION < EPS_TIME) {\n                TRAJECTORY.at(REF_IDX).FDURATION = EPS_TIME;\n            }\n        }\n    }\n    C_POS = STARTSTATE.FPOS;\n    C_VEL = STARTSTATE.FVEL;\n    C_ACC = STARTSTATE.FACC;\n    for (I = 1; I <= SEGMENTCOUNT; I++) {\n        TRAJECTORY.at(I).FPOS = C_POS;\n        TRAJECTORY.at(I).FVEL = C_VEL;\n        TRAJECTORY.at(I).FACC = C_ACC;\n        T_REC = TRAJECTORY.at(I).FDURATION;\n        J_RESTORE = TRAJECTORY.at(I).FJERK;\n        C_POS = C_POS + C_VEL * T_REC + 0.5 * C_ACC * T_REC * T_REC + (1.0 / 6.0) * J_RESTORE * T_REC * T_REC * T_REC;\n        C_VEL = C_VEL + C_ACC * T_REC + 0.5 * J_RESTORE * T_REC * T_REC;\n        C_ACC = C_ACC + J_RESTORE * T_REC;\n    }\n    if (SEGMENTCOUNT == 0) {\n        TRAJECTORY.at(1) = STARTSTATE;\n        TRAJECTORY.at(1).FDURATION = 0;\n        TRAJECTORY.at(1).FJERK = 0;\n        TRAJECTORY.at(1).FACC = 0;\n        SEGMENTCOUNT = 1;\n    }\n    DONE = true;\n    DONE = true;\n}\n",
