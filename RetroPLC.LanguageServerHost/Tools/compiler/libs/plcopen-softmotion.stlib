      "header": "class OPENSML_PROFILEVELOCITY {\npublic:\n    // In-Out\n    OPENSML_AXIS AXIS;\n    // Inputs\n    IEC_BOOL XENABLE;\n    IEC_DINT DITARGETVELOCITY;\n    // Outputs\n    IEC_BOOL XERROR;\n    // Local variables\n    IEC_INT ISTATE;\n    TON TONTIMEOUT;\n    IEC_TIME TTIMEOUT;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    OPENSML_PROFILEVELOCITY();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~OPENSML_PROFILEVELOCITY() = default;\n};\n",
      "cpp": "OPENSML_PROFILEVELOCITY::OPENSML_PROFILEVELOCITY()\n    : TTIMEOUT(200000000LL)\n{\n    // Initialize variables\n}\n\nvoid OPENSML_PROFILEVELOCITY::operator()() {\n    switch (ISTATE) {\n        case 0:\n            XERROR = false;\n            if (((((XENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY == 3)) & (!((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) {\n                ISTATE = 10;\n            } else if (((XENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY != 3)) {\n                AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((false ? 1ULL : 0ULL) << 3);\n                ISTATE = 10;\n            } else if (XENABLE) {\n                ISTATE = 999;\n            }\n            break;\n        case 10:\n            AXIS.MODES_OF_OPERATION = 3;\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((AXIS.MODES_OF_OPERATION_DISPLAY == 3 ? 1ULL : 0ULL) << 3);\n            if ((((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1)) & (AXIS.MODES_OF_OPERATION_DISPLAY == 3)) {\n                ISTATE = 20;\n            }\n            break;\n        case 20:\n            AXIS.TARGET_VELOCITY = DITARGETVELOCITY;\n            if (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1)) {\n                ISTATE = 999;\n            } else if (!XENABLE) {\n                AXIS.TARGET_VELOCITY = 0;\n                ISTATE = 0;\n            }\n            break;\n        case 999:\n            AXIS.TARGET_VELOCITY = 0;\n            TONTIMEOUT.IN = false;\n            TONTIMEOUT();\n            TONTIMEOUT.ENO = true;\n            XERROR = true;\n            if (!XENABLE) {\n                ISTATE = 0;\n            }\n            break;\n    }\n}\n",
