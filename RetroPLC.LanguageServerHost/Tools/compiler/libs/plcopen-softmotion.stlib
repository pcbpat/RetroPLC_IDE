      "header": "class MC_RESET {\npublic:\n    // In-Out\n    AXIS_REF_SM3 AXIS;\n    // Inputs\n    IEC_BOOL EXECUTE;\n    // Outputs\n    IEC_BOOL DONE;\n    IEC_BOOL BUSY;\n    IEC_BOOL ERROR;\n    IEC_SMC_ERROR ERRORID;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    MC_RESET();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~MC_RESET() = default;\n};\n",
      "cpp": "MC_RESET::MC_RESET() {\n    // Initialize variables\n}\n\nvoid MC_RESET::operator()() {\n    AXIS.DRIVE.CONTROLWORD = (AXIS.DRIVE.CONTROLWORD & ~(1ULL << 7)) | ((EXECUTE ? 1ULL : 0ULL) << 7);\n    DONE = (EXECUTE) & (!((static_cast<uint64_t>(AXIS.DRIVE.STATUSWORD) >> 3) & 1));\n    BUSY = (EXECUTE) & (((static_cast<uint64_t>(AXIS.DRIVE.STATUSWORD) >> 3) & 1));\n    ERROR = false;\n    ERRORID = SMC_ERROR::SMC_NO_ERROR;\n}\n",
