    {
      "name": "OPENSML_PROFILEPOSITION",
      "kind": "functionBlock",
      "header": "class OPENSML_PROFILEPOSITION {\npublic:\n    // In-Out\n    OPENSML_AXIS AXIS;\n    // Inputs\n    IEC_BOOL XENABLE;\n    IEC_BOOL XEXECUTE;\n    IEC_BOOL XCONTINUEMOVE;\n    IEC_BOOL XRELATIVEMODE;\n    IEC_DINT DITARGETPOSITION;\n    IEC_UDINT UDIPROFILEVELOCITY;\n    // Outputs\n    IEC_BOOL XDONE;\n    IEC_BOOL XBUSY;\n    IEC_BOOL XMOVING;\n    IEC_BOOL XERROR;\n    // Local variables\n    IEC_INT ISTATE;\n    TON TONTIMEOUT;\n    IEC_TIME TTIMEOUT;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    OPENSML_PROFILEPOSITION();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~OPENSML_PROFILEPOSITION() = default;\n};\n",
      "cpp": "OPENSML_PROFILEPOSITION::OPENSML_PROFILEPOSITION()\n    : TTIMEOUT(200000000LL)\n{\n    // Initialize variables\n}\n\nvoid OPENSML_PROFILEPOSITION::operator()() {\n    AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 5)) | ((XCONTINUEMOVE ? 1ULL : 0ULL) << 5);\n    AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 6)) | ((XRELATIVEMODE ? 1ULL : 0ULL) << 6);\n    AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 4)) | (((XEXECUTE) & (ISTATE == 20) ? 1ULL : 0ULL) << 4);\n    XBUSY = ((ISTATE == 20) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 12) & 1))) & (!((static_cast<uint64_t>(AXIS.STATUSWORD) >> 10) & 1));\n    XDONE = ((ISTATE == 20) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 10) & 1))) & (!((static_cast<uint64_t>(AXIS.STATUSWORD) >> 13) & 1));\n    XMOVING = !((static_cast<uint64_t>(AXIS.STATUSWORD) >> 14) & 1);\n    switch (ISTATE) {\n        case 0:\n            XDONE = false;\n            XBUSY = false;\n            XERROR = false;\n            if (((((XENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY == 1)) & (!((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) {\n                ISTATE = 10;\n            } else if (((XENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY != 1)) {\n                AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((false ? 1ULL : 0ULL) << 3);\n                ISTATE = 10;\n            } else if (XENABLE) {\n                ISTATE = 999;\n            }\n            break;\n        case 10:\n            AXIS.MODES_OF_OPERATION = 1;\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((AXIS.MODES_OF_OPERATION_DISPLAY == 1 ? 1ULL : 0ULL) << 3);\n            if ((((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1)) & (AXIS.MODES_OF_OPERATION_DISPLAY == 1)) {\n                ISTATE = 20;\n            }\n            break;\n        case 20:\n            AXIS.PROFILE_VELOCITY = UDIPROFILEVELOCITY;\n            AXIS.TARGET_POSITION = DITARGETPOSITION;\n            if ((((static_cast<uint64_t>(AXIS.STATUSWORD) >> 13) & 1)) | (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) {\n                ISTATE = 999;\n            } else if (!XENABLE) {\n                AXIS.PROFILE_VELOCITY = 0;\n                AXIS.TARGET_POSITION = 0;\n                ISTATE = 0;\n            }\n            break;\n        case 999:\n            AXIS.PROFILE_VELOCITY = 0;\n            AXIS.TARGET_POSITION = 0;\n            TONTIMEOUT.IN = false;\n            TONTIMEOUT();\n            TONTIMEOUT.ENO = true;\n            XERROR = true;\n            if (!XENABLE) {\n                ISTATE = 0;\n            }\n            break;\n    }\n}\n",
      "deps": [
