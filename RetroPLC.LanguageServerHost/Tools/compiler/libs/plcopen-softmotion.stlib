    {
      "name": "SM_DRIVE_GENERICDS402",
      "kind": "functionBlock",
      "header": "class SM_DRIVE_GENERICDS402 {\npublic:\n    // In-Out\n    AXIS_REF_SM3 AXIS;\n    // Inputs\n    IEC_UINT WSTATUSWORD;\n    IEC_SINT SIMODESDISPLAY;\n    IEC_DINT DIACTUALPOSITION;\n    IEC_DINT DIACTUALVELOCITY;\n    IEC_INT IACTUALTORQUE;\n    IEC_BOOL BONLINE;\n    // Outputs\n    IEC_UINT WCONTROLWORD;\n    IEC_SINT SIMODES;\n    IEC_DINT DITARGETPOSITION;\n    IEC_UDINT UDIPROFILEVELOCITY;\n    IEC_DINT DITARGETVELOCITY;\n    IEC_INT ITARGETTORQUE;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    SM_DRIVE_GENERICDS402();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~SM_DRIVE_GENERICDS402() = default;\n};\n",
      "cpp": "SM_DRIVE_GENERICDS402::SM_DRIVE_GENERICDS402()\n    : BONLINE(true)\n{\n    // Initialize variables\n}\n\nvoid SM_DRIVE_GENERICDS402::operator()() {\n    AXIS.DRIVE.STATUSWORD = WSTATUSWORD;\n    AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY = SIMODESDISPLAY;\n    AXIS.DRIVE.POSITION_ACTUAL_VALUE = DIACTUALPOSITION;\n    AXIS.DRIVE.VELOCITY_ACTUAL_VALUE = DIACTUALVELOCITY;\n    AXIS.DRIVE.TORQUE_ACTUAL_VALUE = IACTUALTORQUE;\n    if (AXIS.DWRATIOTECHUNITSDENOM == static_cast<IEC_DWORD>(0)) {\n        AXIS.DWRATIOTECHUNITSDENOM = static_cast<IEC_DWORD>(1);\n    }\n    AXIS.FINCPERUNIT = AXIS.FSCALEFACTOR * TO_LREAL(AXIS.IRATIOTECHUNITSNUM) / TO_LREAL(AXIS.DWRATIOTECHUNITSDENOM);\n    if (AXIS.FINCPERUNIT == 0.0) {\n        AXIS.FINCPERUNIT = 1.0;\n    }\n    AXIS.FACTPOSITION = TO_LREAL(AXIS.DRIVE.POSITION_ACTUAL_VALUE) / AXIS.FINCPERUNIT;\n    AXIS.FACTVELOCITY = TO_LREAL(AXIS.DRIVE.VELOCITY_ACTUAL_VALUE) / AXIS.FINCPERUNIT;\n    AXIS.FACTTORQUE = TO_LREAL(AXIS.DRIVE.TORQUE_ACTUAL_VALUE);\n    AXIS.BYREALCONTROLLERMODE = TO_BYTE(AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY);\n    AXIS.BCOMMUNICATION = BONLINE;\n    AXIS.WCOMMUNICATIONSTATE = TO_WORD(AXIS.DRIVE.STATUSWORD);\n    AXIS.BREGULATORREALSTATE = ((static_cast<uint64_t>(AXIS.DRIVE.STATUSWORD) >> 2) & 1);\n    AXIS.BDRIVESTARTREALSTATE = !((static_cast<uint64_t>(AXIS.DRIVE.STATUSWORD) >> 5) & 1);\n    AXIS.BERROR = ((static_cast<uint64_t>(AXIS.DRIVE.STATUSWORD) >> 3) & 1);\n    if (!BONLINE) {\n        AXIS.DWERRORID = static_cast<IEC_DWORD>(1);\n        AXIS.NAXISSTATE = SMC_AXIS_STATE::ERRORSTOP;\n    } else if (AXIS.BERROR) {\n        AXIS.DWERRORID = static_cast<IEC_DWORD>(2);\n        AXIS.NAXISSTATE = SMC_AXIS_STATE::ERRORSTOP;\n    } else {\n        AXIS.DWERRORID = static_cast<IEC_DWORD>(0);\n        if (!((static_cast<uint64_t>(AXIS.DRIVE.STATUSWORD) >> 2) & 1)) {\n            AXIS.NAXISSTATE = SMC_AXIS_STATE::POWER_OFF;\n        } else if (((static_cast<uint64_t>(AXIS.DRIVE.STATUSWORD) >> 14) & 1)) {\n            AXIS.NAXISSTATE = SMC_AXIS_STATE::STANDSTILL;\n        } else if (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY == 3) {\n            AXIS.NAXISSTATE = SMC_AXIS_STATE::CONTINUOUS_MOTION;\n        } else if (AXIS.DRIVE.MODES_OF_OPERATION_DISPLAY == 6) {\n            AXIS.NAXISSTATE = SMC_AXIS_STATE::HOMING;\n        } else {\n            AXIS.NAXISSTATE = SMC_AXIS_STATE::DISCRETE_MOTION;\n        }\n    }\n    WCONTROLWORD = AXIS.DRIVE.CONTROLWORD;\n    SIMODES = AXIS.DRIVE.MODES_OF_OPERATION;\n    DITARGETPOSITION = AXIS.DRIVE.TARGET_POSITION;\n    UDIPROFILEVELOCITY = AXIS.DRIVE.PROFILE_VELOCITY;\n    DITARGETVELOCITY = AXIS.DRIVE.TARGET_VELOCITY;\n    ITARGETTORQUE = AXIS.DRIVE.TARGET_TORQUE;\n}\n",
