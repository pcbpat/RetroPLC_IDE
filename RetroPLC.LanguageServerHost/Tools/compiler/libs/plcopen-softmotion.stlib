      "name": "OPENSML_AXISCONTROLLER",
      "kind": "functionBlock",
      "header": "class OPENSML_AXISCONTROLLER {\npublic:\n    // In-Out\n    OPENSML_AXIS AXIS;\n    OPENSML_CONTROL CONTROL;\n    // Local variables\n    OPENSML_POWER POWER;\n    OPENSML_HOME HOME;\n    IEC_INT ISTATE;\n    FB_S7RTT_OTG OTG;\n    IEC_BOOL INTERFACETYPE;\n    IEC_LREAL JOGVEL;\n    IEC_LREAL MOVEVEL;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    OPENSML_AXISCONTROLLER();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~OPENSML_AXISCONTROLLER() = default;\n};\n",
      "cpp": "OPENSML_AXISCONTROLLER::OPENSML_AXISCONTROLLER() {\n    // Initialize variables\n}\n\nvoid OPENSML_AXISCONTROLLER::operator()() {\n    POWER.AXIS = AXIS;\n    POWER.XENABLE = CONTROL.XAXISENABLE;\n    POWER.XEMERGENCYSTOP = CONTROL.XEMERGENCYSTOP;\n    POWER();\n    POWER.ENO = true;\n    AXIS = POWER.AXIS;\n    CONTROL.XENABLED = POWER.XDONE;\n    HOME.AXIS = AXIS;\n    HOME.XENABLE = (CONTROL.XHOMEENABLE) & (!CONTROL.XMOVEENABLE);\n    HOME();\n    HOME.ENO = true;\n    AXIS = HOME.AXIS;\n    CONTROL.XHOMEDONE = HOME.XDONE;\n    CONTROL.XINPOSITION = false;\n    if (CONTROL.XSIMULATION) {\n        AXIS.POSITION_ACTUAL_VALUE = AXIS.TARGET_POSITION;\n    }\n    CONTROL.LRACTUALPOSITION = TO_LREAL(AXIS.POSITION_ACTUAL_VALUE) / CONTROL.SCALE;\n    switch (ISTATE) {\n        case 0:\n            CONTROL.XERROR = false;\n            if (((((CONTROL.XMOVEENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY == 8)) & (!((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) {\n                ISTATE = 10;\n            } else if (((CONTROL.XMOVEENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY != 8)) {\n                AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((false ? 1ULL : 0ULL) << 3);\n                ISTATE = 10;\n            } else if ((CONTROL.XMOVEENABLE) & (CONTROL.XSIMULATION)) {\n                ISTATE = 20;\n            } else if (CONTROL.XMOVEENABLE) {\n                ISTATE = 999;\n            }\n            break;\n        case 10:\n            AXIS.MODES_OF_OPERATION = 8;\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((AXIS.MODES_OF_OPERATION_DISPLAY == 8 ? 1ULL : 0ULL) << 3);\n            OTG.CURRENTPOSITION = TO_LREAL(AXIS.POSITION_ACTUAL_VALUE) / CONTROL.SCALE;\n            if ((((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1)) & (AXIS.MODES_OF_OPERATION_DISPLAY == 8)) {\n                ISTATE = 20;\n            }\n            break;\n        case 20:\n            if ((CONTROL.JOGPOS) & (!CONTROL.XFOLLOWENABLE)) {\n                INTERFACETYPE = 1;\n                JOGVEL = MIN(CONTROL.JOGVELOCITY, CONTROL.MAXVELOCITY);\n            } else if ((CONTROL.JOGNEG) & (!CONTROL.XFOLLOWENABLE)) {\n                INTERFACETYPE = 1;\n                JOGVEL = MAX(-CONTROL.JOGVELOCITY, -CONTROL.MAXVELOCITY);\n            } else {\n                INTERFACETYPE = 1;\n                JOGVEL = 0;\n            }\n            if ((CONTROL.XFOLLOWENABLE) & (CONTROL.LRFOLLOWVELOCITY > 0)) {\n                INTERFACETYPE = 0;\n                MOVEVEL = MIN(CONTROL.LRFOLLOWVELOCITY, CONTROL.MAXVELOCITY);\n            } else {\n                MOVEVEL = CONTROL.MAXVELOCITY;\n            }\n            OTG.CONTROLINTERFACE = INTERFACETYPE;\n            OTG.TARGETPOSITION = CONTROL.LRFOLLOWPOSITION;\n            OTG.TARGETVELOCITY = JOGVEL;\n            OTG.CYCLETIME = CONTROL.CYCLETIME;\n            OTG.MAXVELOCITY = MOVEVEL;\n            OTG.MAXACCELERATION = CONTROL.MAXACCELERATION;\n            OTG.MAXJERK = CONTROL.MAXJERK;\n            OTG();\n            OTG.ENO = true;\n            if (OTG.NEWPOSITION >= 0) {\n                AXIS.TARGET_POSITION = TO_DINT(OTG.NEWPOSITION * CONTROL.SCALE);\n            } else {\n                AXIS.TARGET_POSITION = -TO_DINT(-OTG.NEWPOSITION * CONTROL.SCALE);\n            }\n            CONTROL.XINPOSITION = ABS(OTG.NEWPOSITION - CONTROL.LRACTUALPOSITION) < 0.01;\n            if (((((((static_cast<uint64_t>(AXIS.STATUSWORD) >> 13) & 1)) | (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) | (OTG.XERROR)) | (POWER.XERROR)) | (HOME.XERROR)) {\n                ISTATE = 999;\n            } else if (!CONTROL.XMOVEENABLE) {\n                ISTATE = 0;\n            }\n            break;\n        case 999:\n            CONTROL.XERROR = true;\n            if (!CONTROL.XMOVEENABLE) {\n                ISTATE = 0;\n            }\n            break;\n    }\n}\n",
      "deps": [
        {
          "library": "plcopen-softmotion",
          "name": "FB_S7RTT_OTG"
        },
        {
          "library": "plcopen-softmotion",
          "name": "OPENSML_AXIS"
        },
        {
          "library": "plcopen-softmotion",
          "name": "OPENSML_CONTROL"
        },
        {
          "library": "plcopen-softmotion",
          "name": "OPENSML_HOME"
        },
        {
          "library": "plcopen-softmotion",
          "name": "OPENSML_POWER"
        }
      ]
    },
    {
      "name": "FC_S7RTT_ATTIME",
      "kind": "function",
      "header": "ST_MOTIONSTATE FC_S7RTT_ATTIME(Array1D<ST_MOTIONSTATE, 1, 32> TRAJECTORY, IEC_INT SEGCOUNT, IEC_LREAL ELAPSEDTIME);",
      "cpp": "ST_MOTIONSTATE FC_S7RTT_ATTIME(Array1D<ST_MOTIONSTATE, 1, 32> TRAJECTORY, IEC_INT SEGCOUNT, IEC_LREAL ELAPSEDTIME) {\n    ST_MOTIONSTATE FC_S7RTT_ATTIME_result;\n    IEC_INT I;\n    IEC_LREAL T_REM;\n    IEC_LREAL T;\n    IEC_LREAL J;\n    IEC_LREAL P0;\n    IEC_LREAL V0;\n    IEC_LREAL A0;\n    IEC_INT LAST_IDX;\n    if (SEGCOUNT <= 0) {\n        FC_S7RTT_ATTIME_result.FPOS = TRAJECTORY.at(1).FPOS;\n        FC_S7RTT_ATTIME_result.FVEL = 0.0;\n        FC_S7RTT_ATTIME_result.FACC = 0.0;\n        return FC_S7RTT_ATTIME_result;\n    }\n    if (ELAPSEDTIME <= 0.0) {\n        FC_S7RTT_ATTIME_result = TRAJECTORY.at(1);\n        FC_S7RTT_ATTIME_result.FDURATION = 0.0;\n        FC_S7RTT_ATTIME_result.FJERK = 0.0;\n        return FC_S7RTT_ATTIME_result;\n    }\n    T_REM = ELAPSEDTIME;\n    for (I = 1; I <= SEGCOUNT; I++) {\n        if (T_REM <= TRAJECTORY.at(I).FDURATION) {\n            T = T_REM;\n            J = TRAJECTORY.at(I).FJERK;\n            P0 = TRAJECTORY.at(I).FPOS;\n            V0 = TRAJECTORY.at(I).FVEL;\n            A0 = TRAJECTORY.at(I).FACC;\n            FC_S7RTT_ATTIME_result.FPOS = P0 + V0 * T + 0.5 * A0 * T * T + (1.0 / 6.0) * J * T * T * T;\n            FC_S7RTT_ATTIME_result.FVEL = V0 + A0 * T + 0.5 * J * T * T;\n            FC_S7RTT_ATTIME_result.FACC = A0 + J * T;\n            FC_S7RTT_ATTIME_result.FJERK = J;\n            FC_S7RTT_ATTIME_result.FDURATION = 0.0;\n            return FC_S7RTT_ATTIME_result;\n        } else {\n            T_REM = T_REM - TRAJECTORY.at(I).FDURATION;\n        }\n    }\n    LAST_IDX = SEGCOUNT;\n    T = TRAJECTORY.at(LAST_IDX).FDURATION;\n    J = TRAJECTORY.at(LAST_IDX).FJERK;\n    P0 = TRAJECTORY.at(LAST_IDX).FPOS;\n    V0 = TRAJECTORY.at(LAST_IDX).FVEL;\n    A0 = TRAJECTORY.at(LAST_IDX).FACC;\n    P0 = P0 + V0 * T + 0.5 * A0 * T * T + (1.0 / 6.0) * J * T * T * T;\n    V0 = V0 + A0 * T + 0.5 * J * T * T;\n    FC_S7RTT_ATTIME_result.FPOS = P0 + V0 * T_REM;\n    FC_S7RTT_ATTIME_result.FVEL = V0;\n    FC_S7RTT_ATTIME_result.FACC = 0.0;\n    FC_S7RTT_ATTIME_result.FJERK = 0.0;\n    FC_S7RTT_ATTIME_result.FDURATION = 0.0;\n    return FC_S7RTT_ATTIME_result;\n}\n",
      "deps": [
        {
          "library": "plcopen-softmotion",
          "name": "ST_MOTIONSTATE"
        }
      ]
    },
    {
      "name": "FC_S7RTT_BUILDPROFILE",
      "kind": "function",
      "header": "IEC_INT FC_S7RTT_BUILDPROFILE(IEC_LREAL IN_V_START, IEC_LREAL IN_A_START, IEC_LREAL IN_V_TARGET, IEC_LREAL IN_A_MAX, IEC_LREAL IN_J_MAX, Array1D<IEC_LREAL, 1, 5>& OUT_TIME, Array1D<IEC_LREAL, 1, 5>& OUT_JERK);",
      "cpp": "IEC_INT FC_S7RTT_BUILDPROFILE(IEC_LREAL IN_V_START, IEC_LREAL IN_A_START, IEC_LREAL IN_V_TARGET, IEC_LREAL IN_A_MAX, IEC_LREAL IN_J_MAX, Array1D<IEC_LREAL, 1, 5>& OUT_TIME, Array1D<IEC_LREAL, 1, 5>& OUT_JERK) {\n    IEC_INT FC_S7RTT_BUILDPROFILE_result;\n    IEC_LREAL ACC_CLAMPED;\n    IEC_LREAL T_TO_ZERO;\n    IEC_LREAL J_RESTORE;\n    IEC_LREAL V_MIN_FEASIBLE;\n    IEC_LREAL DIRECTION;\n    IEC_LREAL V0_MOD;\n    IEC_LREAL A0_MOD;\n    IEC_LREAL V1_MOD;\n    IEC_LREAL T1_MAX;\n    IEC_LREAL T3_MAX;\n    IEC_LREAL DV_INFLECTION;\n    IEC_LREAL DV_REQ;\n    IEC_LREAL DV_MISSING;\n    IEC_LREAL TERM;\n    IEC_LREAL A_PEAK;\n    IEC_LREAL T1;\n    IEC_LREAL T2;\n    IEC_LREAL T3;\n    IEC_INT CNT;\n    IEC_LREAL EPS = 1e-10;\n    CNT = 0;\n    ACC_CLAMPED = IN_A_START;\n    if (ACC_CLAMPED > IN_A_MAX) {\n        ACC_CLAMPED = IN_A_MAX;\n    }\n    if (ACC_CLAMPED < -IN_A_MAX) {\n        ACC_CLAMPED = -IN_A_MAX;\n    }\n    T_TO_ZERO = ABS(ACC_CLAMPED) / IN_J_MAX;\n    if (ABS(ACC_CLAMPED) > EPS) {\n        if (ACC_CLAMPED > 0.0) {\n            J_RESTORE = -IN_J_MAX;\n        } else {\n            J_RESTORE = IN_J_MAX;\n        }\n    } else {\n        J_RESTORE = 0.0;\n    }\n    V_MIN_FEASIBLE = IN_V_START + ACC_CLAMPED * T_TO_ZERO + 0.5 * J_RESTORE * T_TO_ZERO * T_TO_ZERO;\n    DIRECTION = 1.0;\n    if (IN_V_TARGET < V_MIN_FEASIBLE - EPS) {\n        DIRECTION = -1.0;\n    }\n    V0_MOD = IN_V_START * DIRECTION;\n    A0_MOD = ACC_CLAMPED * DIRECTION;\n    V1_MOD = IN_V_TARGET * DIRECTION;\n    T1_MAX = (IN_A_MAX - A0_MOD) / IN_J_MAX;\n    if (T1_MAX < 0.0) {\n        T1_MAX = 0.0;\n    }\n    T3_MAX = IN_A_MAX / IN_J_MAX;\n    DV_INFLECTION = (A0_MOD * T1_MAX + 0.5 * IN_J_MAX * T1_MAX * T1_MAX) + (IN_A_MAX * T3_MAX - 0.5 * IN_J_MAX * T3_MAX * T3_MAX);\n    DV_REQ = V1_MOD - V0_MOD;\n    if (DV_REQ > DV_INFLECTION) {\n        DV_MISSING = DV_REQ - DV_INFLECTION;\n        T2 = DV_MISSING / IN_A_MAX;\n        T1 = T1_MAX;\n        T3 = T3_MAX;\n    } else {\n        TERM = IN_J_MAX * DV_REQ + 0.5 * A0_MOD * A0_MOD;\n        if (TERM < 0.0) {\n            TERM = 0.0;\n        }\n        A_PEAK = SQRT(TERM);\n        T1 = (A_PEAK - A0_MOD) / IN_J_MAX;\n        if (T1 < 0.0) {\n            T1 = 0.0;\n        }\n        T3 = A_PEAK / IN_J_MAX;\n        if (T3 < 0.0) {\n            T3 = 0.0;\n        }\n        T2 = 0.0;\n    }\n    if (T1 > EPS) {\n        CNT = CNT + 1;\n        OUT_TIME.at(CNT) = T1;\n        OUT_JERK.at(CNT) = DIRECTION * IN_J_MAX;\n    }\n    if (T2 > EPS) {\n        CNT = CNT + 1;\n        OUT_TIME.at(CNT) = T2;\n        OUT_JERK.at(CNT) = 0.0;\n    }\n    if (T3 > EPS) {\n        CNT = CNT + 1;\n        OUT_TIME.at(CNT) = T3;\n        OUT_JERK.at(CNT) = -DIRECTION * IN_J_MAX;\n    }\n    FC_S7RTT_BUILDPROFILE_result = CNT;\n    return FC_S7RTT_BUILDPROFILE_result;\n}\n",
      "deps": []
    },
    {
      "name": "FC_S7RTT_CALCTRAJDIST",
      "kind": "function",
      "header": "IEC_LREAL FC_S7RTT_CALCTRAJDIST(IEC_LREAL V_PEAK, IEC_LREAL START_V, IEC_LREAL START_A, IEC_LREAL TARGET_V, IEC_LREAL A_MAX, IEC_LREAL J_MAX);",
      "cpp": "IEC_LREAL FC_S7RTT_CALCTRAJDIST(IEC_LREAL V_PEAK, IEC_LREAL START_V, IEC_LREAL START_A, IEC_LREAL TARGET_V, IEC_LREAL A_MAX, IEC_LREAL J_MAX) {\n    IEC_LREAL FC_S7RTT_CALCTRAJDIST_result;\n    Array1D<IEC_LREAL, 1, 5> T_BUF;\n    Array1D<IEC_LREAL, 1, 5> J_BUF;\n    IEC_INT CNT;\n    IEC_INT I;\n    IEC_LREAL V_CURR;\n    IEC_LREAL A_CURR;\n    IEC_LREAL DIST_TOTAL;\n    IEC_LREAL T_SEG;\n    IEC_LREAL J_SEG;\n    DIST_TOTAL = 0.0;\n    V_CURR = START_V;\n    A_CURR = START_A;\n    CNT = FC_S7RTT_BUILDPROFILE(V_CURR, A_CURR, V_PEAK, A_MAX, J_MAX, T_BUF, J_BUF);\n    for (I = 1; I <= CNT; I++) {\n        T_SEG = T_BUF.at(I);\n        J_SEG = J_BUF.at(I);\n        DIST_TOTAL = DIST_TOTAL + V_CURR * T_SEG + 0.5 * A_CURR * T_SEG * T_SEG + (1.0 / 6.0) * J_SEG * T_SEG * T_SEG * T_SEG;\n        V_CURR = V_CURR + A_CURR * T_SEG + 0.5 * J_SEG * T_SEG * T_SEG;\n        A_CURR = A_CURR + J_SEG * T_SEG;\n    }\n    CNT = FC_S7RTT_BUILDPROFILE(V_CURR, A_CURR, TARGET_V, A_MAX, J_MAX, T_BUF, J_BUF);\n    for (I = 1; I <= CNT; I++) {\n        T_SEG = T_BUF.at(I);\n        J_SEG = J_BUF.at(I);\n        DIST_TOTAL = DIST_TOTAL + V_CURR * T_SEG + 0.5 * A_CURR * T_SEG * T_SEG + (1.0 / 6.0) * J_SEG * T_SEG * T_SEG * T_SEG;\n        V_CURR = V_CURR + A_CURR * T_SEG + 0.5 * J_SEG * T_SEG * T_SEG;\n        A_CURR = A_CURR + J_SEG * T_SEG;\n    }\n    FC_S7RTT_CALCTRAJDIST_result = DIST_TOTAL;\n    return FC_S7RTT_CALCTRAJDIST_result;\n}\n",
      "deps": [
        {
          "library": "plcopen-softmotion",
          "name": "FC_S7RTT_BUILDPROFILE"
        }
      ]
    }
  ],
  "dependencies": [
    {
      "name": "iec-standard-fb",
      "version": "1.0.0"
    }
  ],
  "sources": [
    {
      "fileName": "opensml_axis.st",
      "source": "(*\n * OpenSML_Axis — CiA 402 axis reference structure.\n *\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\n * Each field maps 1:1 onto a CiA 402 drive object exchanged over the\n * fieldbus (e.g. EtherCAT PDOs). Outputs (%Q) are written by the motion\n * blocks; inputs (%I) are read from the drive each scan.\n *)\nTYPE OpenSML_Axis :\nSTRUCT\n\t(* Outputs -> drive *)\n\tControlWord : UINT;                 (* 0x6040 *)\n\tModes_of_operation : SINT;          (* 0x6060 *)\n\tTarget_Position : DINT;             (* 0x607A *)\n\tProfile_Velocity : UDINT;           (* 0x6081 *)\n\tTarget_Velocity : DINT;             (* 0x60FF *)\n\tTarget_torque : INT;                (* 0x6071 *)\n\t(* Inputs <- drive *)\n\tStatusWord : UINT;                  (* 0x6041 *)\n\tModes_of_operation_display : SINT;  (* 0x6061 *)\n\tTorque_Actual_Value : INT;          (* 0x6077 *)\n\tPosition_Actual_Value : DINT;       (* 0x6064 *)\n\tVelocity_Actual_Value : DINT;       (* 0x606C *)\n\tCurrent_Actual_Value : INT;         (* 0x6078 *)\n\tFollowing_Error_Actual_Value : DINT;(* 0x60F4 *)\nEND_STRUCT\nEND_TYPE\n"
    },
    {
      "fileName": "opensml_control.st",
      "source": "(*\n * OpenSML_Control — aggregate axis command/status structure.\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\n *)\nTYPE OpenSML_Control :\nSTRUCT\n\txAxisEnable: BOOL;//Axis Hardware Enable\n\txMoveEnable: BOOL;//Jog&Pos Movement Enable\n\txHomeEnable: BOOL;//Home Function Enable\n\txSimulation: BOOL;//Simulation Mode\n\txEmergencyStop: BOOL:=TRUE;//Emergency Stop\n\t\n\tJogPos: BOOL;//Jog Positive\n\tJogNeg: BOOL;//Jog Negative\n\tJogVelocity: LREAL:=10;//Jog Velocity\n\t\n\tlrActualPosition: LREAL;//Actual Position Feedback\n\t\n\tlrFollowPosition: LREAL;//Follow Target Position, Can be set to new value at any time\n\tlrFollowVelocity: LREAL:=20;//Follow Move Velocity, Can be set to new value at any time\n\txFollowEnable: BOOL;//Follow Move Enable\n\n\txError: BOOL;//Error\n\txBusy: BOOL;//Busy, Normal Working State\n\txInPosition: BOOL;//In Position\n\txEnabled: BOOL;//Axis Hardware Enabled\n\txHomeDone: BOOL;//Axis Home Done\n\t\n\tMaxVelocity: LREAL:=100;//Max Velocity\n\tMaxAcceleration: LREAL:=1000;//Max Acceleration\n\tMaxJerk: LREAL:=10000;//Max Jerk\n\tCycleTime: LREAL:=0.001;//Task Cycle Time, 0.001 = 1ms\n\tScale: LREAL:=16#1000;//Scale\n\t\n\tAxis:OpenSML_Axis;//Axis Reference\nEND_STRUCT\nEND_TYPE\n"
    },
    {
      "fileName": "s7rtt_types.st",
      "source": "(*\n * S7RTT motion-state / limits structures.\n * Vendored from S7RTT (https://github.com/feecat/S7RTT), Apache-2.0.\n * Converted from PLCopen XML. Single-axis 7-segment S-curve OTG.\n *)\n\nTYPE ST_MotionLimits :\nSTRUCT\n\tfVelMax : LREAL;\n\tfAccMax : LREAL;\n\tfJerkMax : LREAL;\nEND_STRUCT\nEND_TYPE\n\nTYPE ST_MotionState :\nSTRUCT\n\tfDuration : LREAL := 0.0;\n\tfPos : LREAL := 0.0;\n\tfVel : LREAL := 0.0;\n\tfAcc : LREAL := 0.0;\n\tfJerk : LREAL := 0.0;\nEND_STRUCT\nEND_TYPE\n"
    },
    {
      "fileName": "s7rtt_functions.st",
      "source": "(*\n * S7RTT trajectory helper functions (AtTime / BuildProfile / CalcTrajDist).\n * Vendored from S7RTT (https://github.com/feecat/S7RTT), Apache-2.0.\n * Converted from PLCopen XML. Single-axis 7-segment S-curve OTG.\n *)\n\nFUNCTION FC_S7RTT_AtTime : ST_MotionState\nVAR_INPUT\n\tTrajectory : ARRAY[1..32] OF ST_MotionState;\n\tSegCount : INT;\n\tElapsedTime : LREAL;\nEND_VAR\nVAR\n\ti : INT;\n\tt_rem : LREAL;\n\tt : LREAL;\n\tj : LREAL;\n\tp0 : LREAL;\n\tv0 : LREAL;\n\ta0 : LREAL;\n\tlast_idx : INT;\nEND_VAR\n\nIF SegCount <= 0 THEN\n    // No trajectory, return first state\n    FC_S7RTT_AtTime.fPos := Trajectory[1].fPos; FC_S7RTT_AtTime.fVel := 0.0; FC_S7RTT_AtTime.fAcc := 0.0;\n    RETURN;\nEND_IF;\n\nIF ElapsedTime <= 0.0 THEN\n     // Return Initial State from First Segment\n     FC_S7RTT_AtTime := Trajectory[1]; \n     FC_S7RTT_AtTime.fDuration := 0.0;\n     FC_S7RTT_AtTime.fJerk := 0.0;\n     RETURN;\nEND_IF;\n\nt_rem := ElapsedTime;\n\nFOR i := 1 TO SegCount DO\n\tIF t_rem <= Trajectory[i].fDuration THEN\n\t\tt := t_rem;\n\t\tj := Trajectory[i].fJerk;\n\t\t// Use pre-calculated state at segment start\n\t\tp0 := Trajectory[i].fPos;\n\t\tv0 := Trajectory[i].fVel;\n\t\ta0 := Trajectory[i].fAcc;\n\n\t\tFC_S7RTT_AtTime.fPos := p0 + v0 * t + 0.5 * a0 * t*t + (1.0/6.0) * j * t*t*t;\n\t\tFC_S7RTT_AtTime.fVel := v0 + a0 * t + 0.5 * j * t*t;\n\t\tFC_S7RTT_AtTime.fAcc := a0 + j * t;\n\t\tFC_S7RTT_AtTime.fJerk := j;\n\t\tFC_S7RTT_AtTime.fDuration := 0.0;\n\t\tRETURN;\n\tELSE\n\t\tt_rem := t_rem - Trajectory[i].fDuration;\n\tEND_IF;\nEND_FOR;\n\n// Time is beyond end of trajectory\n// Calculate Final State of last segment\nlast_idx := SegCount;\nt := Trajectory[last_idx].fDuration;\nj := Trajectory[last_idx].fJerk;\np0 := Trajectory[last_idx].fPos;\nv0 := Trajectory[last_idx].fVel;\na0 := Trajectory[last_idx].fAcc;\n\np0 := p0 + v0 * t + 0.5 * a0 * t*t + (1.0/6.0) * j * t*t*t;\nv0 := v0 + a0 * t + 0.5 * j * t*t;\n\n// Hold Final Position (assuming v=target, a=0 at end)\n// Linear projection if Velocity is non-zero\nFC_S7RTT_AtTime.fPos := p0 + v0 * t_rem;\nFC_S7RTT_AtTime.fVel := v0;\nFC_S7RTT_AtTime.fAcc := 0.0;\nFC_S7RTT_AtTime.fJerk := 0.0;\nFC_S7RTT_AtTime.fDuration := 0.0;\nEND_FUNCTION\n\nFUNCTION FC_S7RTT_BuildProfile : INT\nVAR_INPUT\n\tin_v_start : LREAL;\n\tin_a_start : LREAL;\n\tin_v_target : LREAL;\n\tin_a_max : LREAL;\n\tin_j_max : LREAL;\nEND_VAR\nVAR_IN_OUT\n\tout_time : ARRAY[1..5] OF LREAL;\n\tout_jerk : ARRAY[1..5] OF LREAL;\nEND_VAR\nVAR\n\tacc_clamped : LREAL;\n\tt_to_zero : LREAL;\n\tj_restore : LREAL;\n\tv_min_feasible : LREAL;\n\tdirection : LREAL;\n\tv0_mod : LREAL;\n\ta0_mod : LREAL;\n\tv1_mod : LREAL;\n\tt1_max : LREAL;\n\tt3_max : LREAL;\n\tdv_inflection : LREAL;\n\tdv_req : LREAL;\n\tdv_missing : LREAL;\n\tterm : LREAL;\n\ta_peak : LREAL;\n\tt1 : LREAL;\n\tt2 : LREAL;\n\tt3 : LREAL;\n\tcnt : INT;\n\tEPS : LREAL := 1E-10;\nEND_VAR\n\ncnt := 0;\n\n// 1. Clamp initial acceleration to limits\nacc_clamped := in_a_start;\nIF acc_clamped > in_a_max THEN acc_clamped := in_a_max; END_IF;\nIF acc_clamped < -in_a_max THEN acc_clamped := -in_a_max; END_IF;\n\n// 2. Check feasibility (can we stop?)\nt_to_zero := ABS(acc_clamped) / in_j_max;\nIF ABS(acc_clamped) > EPS THEN\n    IF acc_clamped > 0.0 THEN j_restore := -in_j_max; ELSE j_restore := in_j_max; END_IF;\nELSE\n    j_restore := 0.0;\nEND_IF;\n\nv_min_feasible := in_v_start + acc_clamped * t_to_zero + 0.5 * j_restore * t_to_zero * t_to_zero;\n\n// 3. Determine direction\ndirection := 1.0;\nIF in_v_target < v_min_feasible - EPS THEN\n    direction := -1.0;\nEND_IF;\n\n// 4. Normalize to positive quadrant\nv0_mod := in_v_start * direction;\na0_mod := acc_clamped * direction;\nv1_mod := in_v_target * direction;\n\nt1_max := (in_a_max - a0_mod) / in_j_max;\nIF t1_max < 0.0 THEN t1_max := 0.0; END_IF;\n\nt3_max := in_a_max / in_j_max;\n\n// Velocity change at inflection (max accel reached)\ndv_inflection := (a0_mod * t1_max + 0.5 * in_j_max * t1_max * t1_max) +\n                 (in_a_max * t3_max - 0.5 * in_j_max * t3_max * t3_max);\n\ndv_req := v1_mod - v0_mod;\n\n// 5. Calculate profile times\nIF dv_req > dv_inflection THEN\n    // Trapezoidal (Constant Acceleration Phase)\n    dv_missing := dv_req - dv_inflection;\n    t2 := dv_missing / in_a_max;\n    t1 := t1_max;\n    t3 := t3_max;\nELSE\n    // Triangular (No Constant Acceleration)\n    term := in_j_max * dv_req + 0.5 * a0_mod * a0_mod;\n    IF term < 0.0 THEN term := 0.0; END_IF;\n    a_peak := SQRT(term);\n    \n    t1 := (a_peak - a0_mod) / in_j_max;\n    IF t1 < 0.0 THEN t1 := 0.0; END_IF;\n    \n    t3 := a_peak / in_j_max;\n    IF t3 < 0.0 THEN t3 := 0.0; END_IF;\n    \n    t2 := 0.0;\nEND_IF;\n\n// 6. Output Segments\nIF t1 > EPS THEN\n    cnt := cnt + 1; out_time[cnt] := t1; out_jerk[cnt] := direction * in_j_max;\nEND_IF;\nIF t2 > EPS THEN\n    cnt := cnt + 1; out_time[cnt] := t2; out_jerk[cnt] := 0.0;\nEND_IF;\nIF t3 > EPS THEN\n    cnt := cnt + 1; out_time[cnt] := t3; out_jerk[cnt] := -direction * in_j_max;\nEND_IF;\n\nFC_S7RTT_BuildProfile := cnt;\nEND_FUNCTION\n\nFUNCTION FC_S7RTT_CalcTrajDist : LREAL\nVAR_INPUT\n\tv_peak : LREAL;\n\tstart_v : LREAL;\n\tstart_a : LREAL;\n\ttarget_v : LREAL;\n\ta_max : LREAL;\n\tj_max : LREAL;\nEND_VAR\nVAR\n\tt_buf : ARRAY[1..5] OF LREAL;\n\tj_buf : ARRAY[1..5] OF LREAL;\n\tcnt : INT;\n\ti : INT;\n\tv_curr : LREAL;\n\ta_curr : LREAL;\n\tdist_total : LREAL;\n\tt_seg : LREAL;\n\tj_seg : LREAL;\nEND_VAR\n\ndist_total := 0.0;\nv_curr := start_v;\na_curr := start_a;\n\n// Phase 1: Start -> Peak Velocity\ncnt := FC_S7RTT_BuildProfile(v_curr, a_curr, v_peak, a_max, j_max, t_buf, j_buf);\nFOR i := 1 TO cnt DO\n\tt_seg := t_buf[i];\n\tj_seg := j_buf[i];\n    // Standard kinematic integration: p = p0 + v0*t + 0.5*a0*t^2 + 1/6*j*t^3\n\tdist_total := dist_total + v_curr * t_seg + 0.5 * a_curr * t_seg*t_seg + (1.0/6.0) * j_seg * t_seg*t_seg*t_seg;\n\tv_curr := v_curr + a_curr * t_seg + 0.5 * j_seg * t_seg*t_seg;\n\ta_curr := a_curr + j_seg * t_seg;\nEND_FOR;\n\n// Phase 2: Peak Velocity -> Target Velocity\ncnt := FC_S7RTT_BuildProfile(v_curr, a_curr, target_v, a_max, j_max, t_buf, j_buf);\nFOR i := 1 TO cnt DO\n\tt_seg := t_buf[i];\n\tj_seg := j_buf[i];\n\tdist_total := dist_total + v_curr * t_seg + 0.5 * a_curr * t_seg*t_seg + (1.0/6.0) * j_seg * t_seg*t_seg*t_seg;\n\tv_curr := v_curr + a_curr * t_seg + 0.5 * j_seg * t_seg*t_seg;\n\ta_curr := a_curr + j_seg * t_seg;\nEND_FOR;\n\nFC_S7RTT_CalcTrajDist := dist_total;\nEND_FUNCTION\n"
    },
    {
      "fileName": "s7rtt_blocks.st",
      "source": "(*\n * S7RTT online trajectory generator: FB_S7RTT_OTG + FB_S7RTT_Plan.\n * Vendored from S7RTT (https://github.com/feecat/S7RTT), Apache-2.0.\n * Converted from PLCopen XML. Single-axis 7-segment S-curve OTG.\n *)\n\nFUNCTION_BLOCK FB_S7RTT_OTG\nVAR_INPUT\n\tControlInterface : BOOL := FALSE;\n\tTargetPosition : LREAL;\n\tTargetVelocity : LREAL := 0;\n\tCycleTime : LREAL := 0.001;\n\tMaxVelocity : LREAL := 10;\n\tMaxAcceleration : LREAL := 10;\n\tMaxJerk : LREAL := 10;\n\tCurrentPosition : LREAL;\nEND_VAR\nVAR_OUTPUT\n\tNewPosition : LREAL;\n\tNewVelocity : LREAL;\n\tNewAcceleration : LREAL;\n\txError : BOOL;\nEND_VAR\nVAR\n\t_ControlInterface : BOOL;\n\t_TargetPosition : LREAL;\n\t_TargetVelocity : LREAL;\n\t_CycleTime : LREAL;\n\t_MaxVelocity : LREAL;\n\t_MaxAcceleration : LREAL;\n\t_MaxJerk : LREAL;\n\t_CurrentPosition : LREAL;\n\txExecute : BOOL;\n\tfbS7Planner : FB_S7RTT_Plan;\n\tstS7Limits : ST_MotionLimits;\n\tstS7Start : ST_MotionState;\n\tstS7Result : ST_MotionState;\n\tfS7Timer : LREAL;\nEND_VAR\n\n// check if input changed\nIF (ControlInterface <> _ControlInterface) OR\n\t(TargetPosition <> _TargetPosition) OR\n\t(TargetVelocity <> _TargetVelocity) OR\n\t(CycleTime <> _CycleTime) OR\n\t(MaxVelocity <> _MaxVelocity) OR\n\t(MaxAcceleration <> _MaxAcceleration) OR\n\t(MaxJerk <> _MaxJerk) OR\n\t(CurrentPosition <> _CurrentPosition) THEN\n\t\n\tIF CurrentPosition <> _CurrentPosition THEN\n\t\tstS7Start.fPos := CurrentPosition;\n\t\tstS7Result.fPos := CurrentPosition;\n\t\t_CurrentPosition := CurrentPosition;\n\tEND_IF\n\t_ControlInterface := ControlInterface;\n\t_TargetPosition := TargetPosition;\n\t_TargetVelocity := TargetVelocity;\n\t_CycleTime := CycleTime;\n\t_MaxVelocity := MaxVelocity;\n\t_MaxAcceleration := MaxAcceleration;\n\t_MaxJerk := MaxJerk;\n\t\n\txExecute:=TRUE;\nEND_IF\n\n// main logic\nIF xExecute THEN\n    stS7Start.fPos := stS7Result.fPos;\n    stS7Start.fVel := stS7Result.fVel;\n    stS7Start.fAcc := stS7Result.fAcc;\n    stS7Start.fDuration := 0.0;\n    \n    stS7Limits.fVelMax := MaxVelocity;\n    stS7Limits.fAccMax := MaxAcceleration;\n    stS7Limits.fJerkMax := MaxJerk;\n    \n    fbS7Planner.ModeVelocity := ControlInterface;\n    fbS7Planner.StartState := stS7Start;\n    fbS7Planner.TargetPos := TargetPosition;\n    fbS7Planner.TargetVel := TargetVelocity; \n    fbS7Planner.Limits := stS7Limits;\n    \n    fS7Timer := 0.0;\nEND_IF\n\nfbS7Planner(Execute:=xExecute,Error=>xError);\n\nxExecute := FALSE;\n\nfS7Timer := fS7Timer + CycleTime;\n\nstS7Result := FC_S7RTT_AtTime(\n\tTrajectory := fbS7Planner.Trajectory, \n\tSegCount := fbS7Planner.SegmentCount, \n\tElapsedTime := fS7Timer\n);\n\nNewPosition:=stS7Result.fPos;\nNewVelocity:=stS7Result.fVel;\nNewAcceleration:=stS7Result.fAcc;\nEND_FUNCTION_BLOCK\n\nFUNCTION_BLOCK FB_S7RTT_Plan\nVAR_INPUT\n\tExecute : BOOL;\n\tModeVelocity : BOOL;\n\tStartState : ST_MotionState;\n\tTargetPos : LREAL;\n\tTargetVel : LREAL;\n\tLimits : ST_MotionLimits;\nEND_VAR\nVAR_OUTPUT\n\tDone : BOOL;\n\tError : BOOL;\n\tSegmentCount : INT;\n\tTrajectory : ARRAY[1..32] OF ST_MotionState;\nEND_VAR\nVAR\n\ttrig_exec : BOOL;\n\tprev_exec : BOOL;\n\tc_pos : LREAL;\n\tc_vel : LREAL;\n\tc_acc : LREAL;\n\ti : INT;\n\tk : INT;\n\tdist_req : LREAL;\n\tt_rec : LREAL;\n\tgap : LREAL;\n\td_upper : LREAL;\n\td_lower : LREAL;\n\tt_cruise : LREAL;\n\titer : INT;\n\tsa : LREAL;\n\tsb : LREAL;\n\tsc : LREAL;\n\tfa : LREAL;\n\tfb : LREAL;\n\tfc : LREAL;\n\tsd : LREAL;\n\tse : LREAL;\n\ttol1 : LREAL;\n\txm : LREAL;\n\tmin1 : LREAL;\n\tmin2 : LREAL;\n\tfCoefP : LREAL;\n\tfCoefQ : LREAL;\n\tfCoefR : LREAL;\n\tfCoefS : LREAL;\n\tmflag : BOOL;\n\tuse_optimal : BOOL;\n\topt_success : BOOL;\n\tj_idx : INT;\n\tj_apply : LREAL;\n\tsearch_horizon : LREAL;\n\tt_est : LREAL;\n\tsim_p : LREAL;\n\tsim_v : LREAL;\n\tsim_a : LREAL;\n\tlimit_a : LREAL;\n\tdist_to_lim : LREAL;\n\tt_ramp : LREAL;\n\tt_hold : LREAL;\n\tsat_dt : LREAL;\n\tsat_j : LREAL;\n\tvalid_curr : BOOL;\n\tbest_t_curr : LREAL;\n\tdur_curr : LREAL;\n\twinner_found : BOOL;\n\twinner_dur : LREAL;\n\twinner_t : LREAL;\n\twinner_j : LREAL;\n\tbest_v : LREAL;\n\tv_mid : LREAL;\n\ta_mid : LREAL;\n\tv_inertial : LREAL;\n\td_inertial : LREAL;\n\tt_to_zero : LREAL;\n\tj_restore : LREAL;\n\tt_shape_buf : ARRAY[1..5] OF LREAL;\n\tj_shape_buf : ARRAY[1..5] OF LREAL;\n\tshape_cnt : INT;\n\tref_idx : INT;\n\tmax_dt : LREAL;\n\tdt_fix : LREAL;\n\tv_cruise_start : LREAL;\n\tEPS_TIME : LREAL := 1E-10;\n\tEPS_VAL : LREAL := 1E-10;\n\tEPS_ACC : LREAL := 1E-10;\n\tEPS_DIST : LREAL := 1E-10;\n\tMATH_EPS : LREAL := 1E-10;\n\tSOLVER_TOL : LREAL := 1E-10;\n\tSOLVER_EPS : LREAL := 2.22E-16;\n\tSOLVER_COARSE : LREAL := 0.0001;\n\tMAX_ITER : INT := 50;\nEND_VAR\n\n// ==============================================================================\n// File Name:    FB_S7RTT_Plan.st\n// Author:       feecat\n// Version:      V1.8.1\n// Description:  Simple 7seg Real-Time Trajectory Generator\n// Website:      https://github.com/feecat/S7RTT\n// License:      Apache License Version 2.0\n// ==============================================================================\n//\n// Licensed under the Apache License, Version 2.0 (the \"License\");\n// you may not use this file except in compliance with the License.\n// You may obtain a copy of the License at\n//\n//     http://www.apache.org/licenses/LICENSE-2.0\n//\n// Unless required by applicable law or agreed to in writing, software\n// distributed under the License is distributed on an \"AS IS\" BASIS,\n// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n// See the License for the specific language governing permissions and\n// limitations under the License.\n// ==============================================================================\n\ntrig_exec := Execute AND NOT prev_exec;\nprev_exec := Execute;\n\nIF NOT Execute THEN\n\tDone := FALSE; Error := FALSE; RETURN;\nEND_IF\n\nIF NOT trig_exec THEN RETURN; END_IF;\n\n// --- Initialization ---\nDone := FALSE;\nError := FALSE;\nSegmentCount := 0;\nopt_success := FALSE;\n\nIF Limits.fVelMax <= 0.0 OR Limits.fAccMax <= 0.0 OR Limits.fJerkMax <= 0.0 THEN\n\tError := TRUE; RETURN;\nEND_IF;\n\nc_pos := StartState.fPos; c_vel := StartState.fVel; c_acc := StartState.fAcc;\n\n// ========================================================\n// 1. Acceleration Recovery (Safety Decel)\n// ========================================================\nIF c_acc > Limits.fAccMax + EPS_ACC THEN\n\t// Positive Saturation: Accel is too high positive, must reduce\n\tj_restore := -Limits.fJerkMax;\n\tlimit_a := Limits.fAccMax;\n\tt_rec := (c_acc - limit_a) / (-j_restore);\n\t\n\tIF t_rec > EPS_TIME THEN\n\t\tSegmentCount := SegmentCount + 1;\n\t\tTrajectory[SegmentCount].fDuration := t_rec;\n\t\tTrajectory[SegmentCount].fJerk     := j_restore;\n\t\t// Integ State\n\t\tc_pos := c_pos + c_vel * t_rec + 0.5 * c_acc * t_rec*t_rec + (1.0/6.0) * j_restore * t_rec*t_rec*t_rec;\n\t\tc_vel := c_vel + c_acc * t_rec + 0.5 * j_restore * t_rec*t_rec;\n\t\tc_acc := limit_a;\n\tEND_IF;\n\t\nELSIF c_acc < -Limits.fAccMax - EPS_ACC THEN\n\t// Negative Saturation: Accel is too low negative, must increase\n\tj_restore := Limits.fJerkMax;\n\tlimit_a := -Limits.fAccMax;\n\tt_rec := (c_acc - limit_a) / (-j_restore); // Note: -j_restore here implies dividing by -JerkMax which is negative\n\t\n\tIF t_rec > EPS_TIME THEN\n\t\tSegmentCount := SegmentCount + 1;\n\t\tTrajectory[SegmentCount].fDuration := t_rec;\n\t\tTrajectory[SegmentCount].fJerk     := j_restore;\n\t\t// Integ State\n\t\tc_pos := c_pos + c_vel * t_rec + 0.5 * c_acc * t_rec*t_rec + (1.0/6.0) * j_restore * t_rec*t_rec*t_rec;\n\t\tc_vel := c_vel + c_acc * t_rec + 0.5 * j_restore * t_rec*t_rec;\n\t\tc_acc := limit_a;\n\tEND_IF;\nEND_IF;\n\n// ========================================================\n// 2. Plan Generation\n// ========================================================\nIF ModeVelocity THEN\n\t// --- Velocity Mode (Unchanged Logic, New Constants) ---\n\tv_mid := TargetVel; \n\tIF v_mid > Limits.fVelMax THEN v_mid := Limits.fVelMax; END_IF;\n\tIF v_mid < -Limits.fVelMax THEN v_mid := -Limits.fVelMax; END_IF;\n\n\tshape_cnt := FC_S7RTT_BuildProfile(c_vel, c_acc, v_mid, Limits.fAccMax, Limits.fJerkMax, t_shape_buf, j_shape_buf);\n\tIF shape_cnt > 0 THEN\n\t\tFOR i := 1 TO shape_cnt DO\n\t\t\tIF SegmentCount < 32 THEN\n\t\t\t\tSegmentCount := SegmentCount + 1;\n\t\t\t\tTrajectory[SegmentCount].fDuration := t_shape_buf[i];\n\t\t\t\tTrajectory[SegmentCount].fJerk     := j_shape_buf[i];\n\t\t\tEND_IF;\n\t\tEND_FOR;\n\tELSE\n\t\tFOR i := 1 TO 31 DO\n\t\t\tSegmentCount := SegmentCount + 1;\n\t\t\tTrajectory[SegmentCount].fDuration := 0;\n\t\t\tTrajectory[SegmentCount].fJerk     := 0;\n\t\tEND_FOR;\n\tEND_IF\nELSE\n\t// --- Position Mode ---\n\tdist_req := TargetPos - c_pos;\n\n\t// Capacity Check (Can we reach target without hitting velocity limits?)\n\t// Note: FC_S7RTT_CalcTrajDist returns distance traveled to reach TargetVel via +/- VelMax\n\td_upper := FC_S7RTT_CalcTrajDist(Limits.fVelMax, c_vel, c_acc, TargetVel, Limits.fAccMax, Limits.fJerkMax);\n\td_lower := FC_S7RTT_CalcTrajDist(-Limits.fVelMax, c_vel, c_acc, TargetVel, Limits.fAccMax, Limits.fJerkMax);\n\n\t// Decision: Cruise or Optimal?\n\tuse_optimal := TRUE;\n\tIF dist_req > d_upper + EPS_DIST THEN use_optimal := FALSE; END_IF;\n\tIF dist_req < d_lower - EPS_DIST THEN use_optimal := FALSE; END_IF;\n\n\t// ========================================================\n\t// 2.1 Time Optimal Solver (New V1.7 Feature)\n\t// ========================================================\n\tIF use_optimal THEN\n\t\twinner_found := FALSE;\n\t\twinner_dur := 1.0E10; // Init Large\n\t\t\n\t\t// Estimate search horizon\n\t\tt_est := (ABS(c_vel) + Limits.fVelMax) / Limits.fAccMax;\n\t\tIF t_est < 1.0 THEN t_est := 1.0; END_IF;\n\t\tsearch_horizon := t_est * 2.0 + 5.0;\n\n\t\t// Bidirectional Competition: Try +Jerk and -Jerk\n\t\tFOR j_idx := 0 TO 1 DO\n\t\t\tIF j_idx = 0 THEN j_apply := Limits.fJerkMax; ELSE j_apply := -Limits.fJerkMax; END_IF;\n\t\t\tvalid_curr := FALSE;\n\t\t\t\n\t\t\t// Brent Solver Setup: Range [0, search_horizon]\n\t\t\tsa := 0.0; sb := search_horizon;\n\t\t\t\n\t\t\t// --- Evaluate at sa (0.0) ---\n\t\t\t// Inline Simulation Block 1\n\t\t\tsim_p := c_pos; sim_v := c_vel; sim_a := c_acc; // Reset State\n\t\t\t// Integrate Saturated (t=0 -> no effect), then Build Profile\n\t\t\tshape_cnt := FC_S7RTT_BuildProfile(sim_v, sim_a, TargetVel, Limits.fAccMax, Limits.fJerkMax, t_shape_buf, j_shape_buf);\n\t\t\tFOR k:=1 TO shape_cnt DO \n\t\t\t\tsim_p := sim_p + sim_v*t_shape_buf[k] + 0.5*sim_a*t_shape_buf[k]*t_shape_buf[k] + (1.0/6.0)*j_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]; \n\t\t\t\tsim_v := sim_v + sim_a*t_shape_buf[k] + 0.5*j_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k];\n\t\t\t\tsim_a := sim_a + j_shape_buf[k]*t_shape_buf[k];\n\t\t\tEND_FOR;\n\t\t\tfa := sim_p - TargetPos; // Error at t=0\n\t\t\t\n\t\t\tIF ABS(fa) < SOLVER_COARSE THEN\n\t\t\t\tbest_t_curr := 0.0; valid_curr := TRUE;\n\t\t\tELSE\n\t\t\t\t// --- Evaluate at sb (horizon) ---\n\t\t\t\t// Inline Simulation Block 2\n\t\t\t\tsim_p := c_pos; sim_v := c_vel; sim_a := c_acc;\n\t\t\t\tlimit_a := Limits.fAccMax; IF j_apply < 0 THEN limit_a := -Limits.fAccMax; END_IF;\n\t\t\t\tdist_to_lim := limit_a - sim_a;\n\t\t\t\tIF (j_apply > 0 AND dist_to_lim > -MATH_EPS) OR (j_apply < 0 AND dist_to_lim < MATH_EPS) THEN t_ramp := dist_to_lim / j_apply; ELSE t_ramp := 0.0; END_IF;\n\t\t\t\t// Saturated Int (simplified logic for end of range)\n\t\t\t\tIF sb <= t_ramp THEN\n\t\t\t\t\tsim_p:=sim_p+sim_v*sb+0.5*sim_a*sb*sb+(1.0/6.0)*j_apply*sb*sb*sb; sim_v:=sim_v+sim_a*sb+0.5*j_apply*sb*sb; sim_a:=sim_a+j_apply*sb;\n\t\t\t\tELSE\n\t\t\t\t\tsim_p:=sim_p+sim_v*t_ramp+0.5*sim_a*t_ramp*t_ramp+(1.0/6.0)*j_apply*t_ramp*t_ramp*t_ramp; sim_v:=sim_v+sim_a*t_ramp+0.5*j_apply*t_ramp*t_ramp; sim_a:=sim_a+j_apply*t_ramp;\n\t\t\t\t\tsim_a:=limit_a; t_hold:=sb-t_ramp;\n\t\t\t\t\tsim_p:=sim_p+sim_v*t_hold+0.5*sim_a*t_hold*t_hold; sim_v:=sim_v+sim_a*t_hold;\n\t\t\t\tEND_IF;\n\t\t\t\tshape_cnt := FC_S7RTT_BuildProfile(sim_v, sim_a, TargetVel, Limits.fAccMax, Limits.fJerkMax, t_shape_buf, j_shape_buf);\n\t\t\t\tFOR k:=1 TO shape_cnt DO sim_p:=sim_p+sim_v*t_shape_buf[k]+0.5*sim_a*t_shape_buf[k]*t_shape_buf[k]+(1.0/6.0)*j_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]; sim_v:=sim_v+sim_a*t_shape_buf[k]+0.5*j_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]; sim_a:=sim_a+j_shape_buf[k]*t_shape_buf[k]; END_FOR;\n\t\t\t\tfb := sim_p - TargetPos;\n\n\t\t\t\t// Bounds Check\n\t\t\t\tIF fa * fb <= 0.0 THEN\n\t\t\t\t\t// Brent Loop\n\t\t\t\t\tsc := sa; fc := fa; sd := sb - sa; se := sd; mflag := TRUE;\n\t\t\t\t\tFOR iter := 1 TO MAX_ITER DO\n\t\t\t\t\t\tIF ABS(fc) < ABS(fb) THEN sa:=sb; sb:=sc; sc:=sa; fa:=fb; fb:=fc; fc:=fa; END_IF;\n\t\t\t\t\t\ttol1 := 2.0 * SOLVER_EPS * ABS(sb) + 0.5 * SOLVER_TOL; xm := 0.5 * (sc - sb);\n\t\t\t\t\t\tIF ABS(xm) <= tol1 OR fb = 0.0 THEN EXIT; END_IF;\n\t\t\t\t\t\tIF ABS(se) >= tol1 AND ABS(fa) > ABS(fb) THEN\n\t\t\t\t\t\t\tfCoefS := fb / fa;\n\t\t\t\t\t\t\tIF sa = sc THEN fCoefP := 2.0*xm*fCoefS; fCoefQ := 1.0-fCoefS;\n\t\t\t\t\t\t\tELSE fCoefQ := fa/fc; fCoefR := fb/fc; fCoefP := fCoefS*(2.0*xm*fCoefQ*(fCoefQ-fCoefR)-(sb-sa)*(fCoefR-1.0)); fCoefQ := (fCoefQ-1.0)*(fCoefR-1.0)*(fCoefS-1.0); END_IF;\n\t\t\t\t\t\t\tIF fCoefP > 0.0 THEN fCoefQ := -fCoefQ; END_IF; fCoefP := ABS(fCoefP);\n\t\t\t\t\t\t\tmin1 := 3.0*xm*fCoefQ - ABS(tol1*fCoefQ); min2 := ABS(se*fCoefQ);\n\t\t\t\t\t\t\tIF 2.0*fCoefP < min1 THEN\n\t\t\t\t\t\t\t\tIF mflag THEN IF 2.0*fCoefP < min2 THEN se:=sd; sd:=fCoefP/fCoefQ; mflag:=FALSE; ELSE sd:=xm; se:=sd; mflag:=TRUE; END_IF;\n\t\t\t\t\t\t\t\tELSE IF 2.0*fCoefP < ABS(sd*fCoefQ) THEN se:=sd; sd:=fCoefP/fCoefQ; mflag:=FALSE; ELSE sd:=xm; se:=sd; mflag:=TRUE; END_IF; END_IF;\n\t\t\t\t\t\t\tELSE sd:=xm; se:=sd; mflag:=TRUE; END_IF;\n\t\t\t\t\t\tELSE sd:=xm; se:=sd; mflag:=TRUE; END_IF;\n\t\t\t\t\t\tsa := sb; fa := fb;\n\t\t\t\t\t\tIF ABS(sd) > tol1 THEN sb:=sb+sd; ELSE IF xm > 0.0 THEN sb:=sb+tol1; ELSE sb:=sb-tol1; END_IF; END_IF;\n\t\t\t\t\t\t\n\t\t\t\t\t\t// --- Eval Function (t = sb) ---\n\t\t\t\t\t\t// Only necessary to update fb. Re-use simulation logic.\n\t\t\t\t\t\tsim_p := c_pos; sim_v := c_vel; sim_a := c_acc;\n\t\t\t\t\t\tlimit_a := Limits.fAccMax; IF j_apply < 0 THEN limit_a := -Limits.fAccMax; END_IF;\n\t\t\t\t\t\tdist_to_lim := limit_a - sim_a;\n\t\t\t\t\t\tIF (j_apply > 0 AND dist_to_lim > -MATH_EPS) OR (j_apply < 0 AND dist_to_lim < MATH_EPS) THEN t_ramp := dist_to_lim / j_apply; ELSE t_ramp := 0.0; END_IF;\n\t\t\t\t\t\tIF sb <= t_ramp THEN\n\t\t\t\t\t\t\tIF sb > EPS_TIME THEN sim_p:=sim_p+sim_v*sb+0.5*sim_a*sb*sb+(1.0/6.0)*j_apply*sb*sb*sb; sim_v:=sim_v+sim_a*sb+0.5*j_apply*sb*sb; sim_a:=sim_a+j_apply*sb; END_IF;\n\t\t\t\t\t\tELSE\n\t\t\t\t\t\t\tIF t_ramp > EPS_TIME THEN sim_p:=sim_p+sim_v*t_ramp+0.5*sim_a*t_ramp*t_ramp+(1.0/6.0)*j_apply*t_ramp*t_ramp*t_ramp; sim_v:=sim_v+sim_a*t_ramp+0.5*j_apply*t_ramp*t_ramp; sim_a:=sim_a+j_apply*t_ramp; END_IF;\n\t\t\t\t\t\t\tsim_a:=limit_a; t_hold:=sb-t_ramp;\n\t\t\t\t\t\t\tIF t_hold > EPS_TIME THEN sim_p:=sim_p+sim_v*t_hold+0.5*sim_a*t_hold*t_hold; sim_v:=sim_v+sim_a*t_hold; END_IF;\n\t\t\t\t\t\tEND_IF;\n\t\t\t\t\t\tshape_cnt := FC_S7RTT_BuildProfile(sim_v, sim_a, TargetVel, Limits.fAccMax, Limits.fJerkMax, t_shape_buf, j_shape_buf);\n\t\t\t\t\t\tFOR k:=1 TO shape_cnt DO sim_p:=sim_p+sim_v*t_shape_buf[k]+0.5*sim_a*t_shape_buf[k]*t_shape_buf[k]+(1.0/6.0)*j_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]; sim_v:=sim_v+sim_a*t_shape_buf[k]+0.5*j_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]; sim_a:=sim_a+j_shape_buf[k]*t_shape_buf[k]; END_FOR;\n\t\t\t\t\t\tfb := sim_p - TargetPos;\n\t\t\t\t\t\t// --- End Eval ---\n\t\t\t\t\t\t\n\t\t\t\t\t\tIF (fb > 0.0 AND fc > 0.0) OR (fb < 0.0 AND fc < 0.0) THEN sc := sa; fc := fa; sd := sb - sa; se := sd; mflag := TRUE; END_IF;\n\t\t\t\t\tEND_FOR;\n\t\t\t\t\tbest_t_curr := sb;\n\t\t\t\t\tIF ABS(fb) <= SOLVER_COARSE THEN valid_curr := TRUE; END_IF;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF;\n\t\t\t\n\t\t\t// Calculate Total Duration for Comparison\n\t\t\tIF valid_curr THEN\n\t\t\t\tdur_curr := 0.0;\n\t\t\t\t// Saturated Time\n\t\t\t\tlimit_a := Limits.fAccMax; IF j_apply < 0 THEN limit_a := -Limits.fAccMax; END_IF;\n\t\t\t\tdist_to_lim := limit_a - c_acc;\n\t\t\t\tIF (j_apply > 0 AND dist_to_lim > -MATH_EPS) OR (j_apply < 0 AND dist_to_lim < MATH_EPS) THEN t_ramp := dist_to_lim / j_apply; ELSE t_ramp := 0.0; END_IF;\n\t\t\t\tIF best_t_curr <= t_ramp THEN dur_curr := best_t_curr;\n\t\t\t\tELSE dur_curr := best_t_curr; // t_ramp + (t - t_ramp)\n\t\t\t\tEND_IF;\n\t\t\t\t// Sim to get intermediate state for remaining profile\n\t\t\t\tsim_p := c_pos; sim_v := c_vel; sim_a := c_acc;\n\t\t\t\tIF best_t_curr <= t_ramp THEN\n\t\t\t\t\tIF best_t_curr > EPS_TIME THEN sim_v:=sim_v+sim_a*best_t_curr+0.5*j_apply*best_t_curr*best_t_curr; sim_a:=sim_a+j_apply*best_t_curr; END_IF;\n\t\t\t\tELSE\n\t\t\t\t\tIF t_ramp > EPS_TIME THEN sim_v:=sim_v+sim_a*t_ramp+0.5*j_apply*t_ramp*t_ramp; sim_a:=sim_a+j_apply*t_ramp; END_IF;\n\t\t\t\t\tsim_a:=limit_a; t_hold:=best_t_curr-t_ramp;\n\t\t\t\t\tIF t_hold > EPS_TIME THEN sim_v:=sim_v+sim_a*t_hold; END_IF;\n\t\t\t\tEND_IF;\n\t\t\t\tshape_cnt := FC_S7RTT_BuildProfile(sim_v, sim_a, TargetVel, Limits.fAccMax, Limits.fJerkMax, t_shape_buf, j_shape_buf);\n\t\t\t\tFOR k:=1 TO shape_cnt DO dur_curr := dur_curr + t_shape_buf[k]; END_FOR;\n\t\t\t\t\n\t\t\t\t// Update Winner\n\t\t\t\tIF dur_curr < winner_dur THEN winner_dur := dur_curr; winner_t := best_t_curr; winner_j := j_apply; winner_found := TRUE; END_IF;\n\t\t\tEND_IF;\n\t\tEND_FOR;\n\t\t\n\t\t// Construct Winner\n\t\tIF winner_found THEN\n\t\t\topt_success := TRUE;\n\t\t\tlimit_a := Limits.fAccMax; IF winner_j < 0 THEN limit_a := -Limits.fAccMax; END_IF;\n\t\t\tdist_to_lim := limit_a - c_acc;\n\t\t\tIF (winner_j > 0 AND dist_to_lim > -MATH_EPS) OR (winner_j < 0 AND dist_to_lim < MATH_EPS) THEN t_ramp := dist_to_lim / winner_j; ELSE t_ramp := 0.0; END_IF;\n\t\t\t\n\t\t\tIF winner_t <= t_ramp THEN\n\t\t\t\tIF winner_t > EPS_TIME THEN\n\t\t\t\t\tIF SegmentCount < 32 THEN SegmentCount:=SegmentCount+1; Trajectory[SegmentCount].fDuration:=winner_t; Trajectory[SegmentCount].fJerk:=winner_j; END_IF;\n\t\t\t\t\tc_pos:=c_pos+c_vel*winner_t+0.5*c_acc*winner_t*winner_t+(1.0/6.0)*winner_j*winner_t*winner_t*winner_t; c_vel:=c_vel+c_acc*winner_t+0.5*winner_j*winner_t*winner_t; c_acc:=c_acc+winner_j*winner_t;\n\t\t\t\tEND_IF;\n\t\t\tELSE\n\t\t\t\tIF t_ramp > EPS_TIME THEN\n\t\t\t\t\tIF SegmentCount < 32 THEN SegmentCount:=SegmentCount+1; Trajectory[SegmentCount].fDuration:=t_ramp; Trajectory[SegmentCount].fJerk:=winner_j; END_IF;\n\t\t\t\t\tc_pos:=c_pos+c_vel*t_ramp+0.5*c_acc*t_ramp*t_ramp+(1.0/6.0)*winner_j*t_ramp*t_ramp*t_ramp; c_vel:=c_vel+c_acc*t_ramp+0.5*winner_j*t_ramp*t_ramp; c_acc:=c_acc+winner_j*t_ramp;\n\t\t\t\tEND_IF;\n\t\t\t\tc_acc := limit_a; t_hold := winner_t - t_ramp;\n\t\t\t\tIF t_hold > EPS_TIME THEN\n\t\t\t\t\tIF SegmentCount < 32 THEN SegmentCount:=SegmentCount+1; Trajectory[SegmentCount].fDuration:=t_hold; Trajectory[SegmentCount].fJerk:=0.0; END_IF;\n\t\t\t\t\tc_pos:=c_pos+c_vel*t_hold+0.5*c_acc*t_hold*t_hold; c_vel:=c_vel+c_acc*t_hold;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF;\n\t\t\tshape_cnt := FC_S7RTT_BuildProfile(c_vel, c_acc, TargetVel, Limits.fAccMax, Limits.fJerkMax, t_shape_buf, j_shape_buf);\n\t\t\tFOR i:=1 TO shape_cnt DO IF SegmentCount < 32 THEN SegmentCount:=SegmentCount+1; Trajectory[SegmentCount].fDuration:=t_shape_buf[i]; Trajectory[SegmentCount].fJerk:=j_shape_buf[i]; END_IF; END_FOR;\n\t\tEND_IF;\n\tEND_IF;\n\n\t// ========================================================\n\t// 2.2 Fallback / Cruise Logic (Original + Cruise)\n\t// ========================================================\n\tIF NOT opt_success THEN\n\t\t// If dist_req > d_upper, we Cruise at VMax. If < d_lower, at -VMax. \n\t\t// Otherwise, we solve for intermediate peak.\n\t\t\n\t\tIF dist_req > d_upper + EPS_DIST THEN best_v := Limits.fVelMax;\n\t\tELSIF dist_req < d_lower - EPS_DIST THEN best_v := -Limits.fVelMax;\n\t\tELSE\n\t\t\t// Bisection Solver (Original Logic, compacted)\n\t\t\tsa := -Limits.fVelMax; sb := Limits.fVelMax;\n\t\t\t// Calc Fa/Fb using helper function logic (Dist via profile)\n\t\t\t// Note: Assuming FC_S7RTT_CalcTrajDist calculates distance for a profile peaking at 'sa'/'sb' then going to TargetVel\n\t\t\tfa := FC_S7RTT_CalcTrajDist(sa, c_vel, c_acc, TargetVel, Limits.fAccMax, Limits.fJerkMax) - dist_req;\n\t\t\tfb := FC_S7RTT_CalcTrajDist(sb, c_vel, c_acc, TargetVel, Limits.fAccMax, Limits.fJerkMax) - dist_req;\n\t\t\t\n\t\t\tIF fa * fb > 0.0 THEN IF ABS(fa) < ABS(fb) THEN best_v := sa; ELSE best_v := sb; END_IF;\n\t\t\tELSE\n\t\t\t\tsc:=sa; fc:=fa; sd:=sb-sa; se:=sd; mflag:=TRUE;\n\t\t\t\tFOR iter := 1 TO MAX_ITER DO\n\t\t\t\t\tIF ABS(fc) < ABS(fb) THEN sa:=sb; sb:=sc; sc:=sa; fa:=fb; fb:=fc; fc:=fa; END_IF;\n\t\t\t\t\ttol1 := 2.0 * SOLVER_EPS * ABS(sb) + 0.5 * SOLVER_TOL; xm := 0.5 * (sc - sb);\n\t\t\t\t\tIF ABS(xm) <= tol1 OR fb = 0.0 THEN EXIT; END_IF;\n\t\t\t\t\tIF ABS(se) >= tol1 AND ABS(fa) > ABS(fb) THEN\n\t\t\t\t\t\tfCoefS := fb/fa;\n\t\t\t\t\t\tIF sa=sc THEN fCoefP:=2.0*xm*fCoefS; fCoefQ:=1.0-fCoefS; ELSE fCoefQ:=fa/fc; fCoefR:=fb/fc; fCoefP:=fCoefS*(2.0*xm*fCoefQ*(fCoefQ-fCoefR)-(sb-sa)*(fCoefR-1.0)); fCoefQ:=(fCoefQ-1.0)*(fCoefR-1.0)*(fCoefS-1.0); END_IF;\n\t\t\t\t\t\tIF fCoefP > 0.0 THEN fCoefQ:=-fCoefQ; END_IF; fCoefP:=ABS(fCoefP); min1:=3.0*xm*fCoefQ-ABS(tol1*fCoefQ); min2:=ABS(se*fCoefQ);\n\t\t\t\t\t\tIF 2.0*fCoefP < min1 THEN IF mflag THEN IF 2.0*fCoefP < min2 THEN se:=sd; sd:=fCoefP/fCoefQ; mflag:=FALSE; ELSE sd:=xm; se:=sd; mflag:=TRUE; END_IF; ELSE IF 2.0*fCoefP < ABS(sd*fCoefQ) THEN se:=sd; sd:=fCoefP/fCoefQ; mflag:=FALSE; ELSE sd:=xm; se:=sd; mflag:=TRUE; END_IF; END_IF; ELSE sd:=xm; se:=sd; mflag:=TRUE; END_IF;\n\t\t\t\t\tELSE sd:=xm; se:=sd; mflag:=TRUE; END_IF;\n\t\t\t\t\tsa:=sb; fa:=fb; IF ABS(sd) > tol1 THEN sb:=sb+sd; ELSE IF xm > 0.0 THEN sb:=sb+tol1; ELSE sb:=sb-tol1; END_IF; END_IF;\n\t\t\t\t\tfb := FC_S7RTT_CalcTrajDist(sb, c_vel, c_acc, TargetVel, Limits.fAccMax, Limits.fJerkMax) - dist_req;\n\t\t\t\t\tIF (fb > 0.0 AND fc > 0.0) OR (fb < 0.0 AND fc < 0.0) THEN sc:=sa; fc:=fa; sd:=sb-sa; se:=sd; mflag:=TRUE; END_IF;\n\t\t\t\tEND_FOR;\n\t\t\t\tbest_v := sb;\n\t\t\tEND_IF;\n\t\tEND_IF;\n\n\t\t// Generate fallback profile\n\t\tshape_cnt := FC_S7RTT_BuildProfile(c_vel, c_acc, best_v, Limits.fAccMax, Limits.fJerkMax, t_shape_buf, j_shape_buf);\n\t\tFOR i:=1 TO shape_cnt DO\n\t\t\tIF SegmentCount < 32 THEN SegmentCount:=SegmentCount+1; Trajectory[SegmentCount].fDuration:=t_shape_buf[i]; Trajectory[SegmentCount].fJerk:=j_shape_buf[i]; END_IF;\n\t\t\tc_pos:=c_pos+c_vel*t_shape_buf[i]+0.5*c_acc*t_shape_buf[i]*t_shape_buf[i]+(1.0/6.0)*j_shape_buf[i]*t_shape_buf[i]*t_shape_buf[i]*t_shape_buf[i];\n\t\t\tc_vel:=c_vel+c_acc*t_shape_buf[i]+0.5*j_shape_buf[i]*t_shape_buf[i]*t_shape_buf[i]; c_acc:=c_acc+j_shape_buf[i]*t_shape_buf[i];\n\t\tEND_FOR;\n\t\t// Add Cruise if needed (gap logic)\n\t\tc_acc := 0.0; \n\t\t// Sim fwd\n\t\tsim_p := c_pos; sim_v := c_vel; sim_a := 0.0;\n\t\tshape_cnt := FC_S7RTT_BuildProfile(sim_v, sim_a, TargetVel, Limits.fAccMax, Limits.fJerkMax, t_shape_buf, j_shape_buf);\n\t\tFOR k:=1 TO shape_cnt DO sim_p:=sim_p+sim_v*t_shape_buf[k]+0.5*sim_a*t_shape_buf[k]*t_shape_buf[k]+(1.0/6.0)*j_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]; sim_v:=sim_v+sim_a*t_shape_buf[k]+0.5*j_shape_buf[k]*t_shape_buf[k]*t_shape_buf[k]; sim_a:=sim_a+j_shape_buf[k]*t_shape_buf[k]; END_FOR;\n\t\tgap := TargetPos - sim_p;\n\t\tIF ABS(c_vel) > EPS_VAL AND ABS(gap) > EPS_DIST THEN\n\t\t\tt_cruise := gap / c_vel;\n\t\t\tIF t_cruise > EPS_TIME THEN\n\t\t\t\tIF SegmentCount < 32 THEN SegmentCount:=SegmentCount+1; Trajectory[SegmentCount].fDuration:=t_cruise; Trajectory[SegmentCount].fJerk:=0.0; END_IF;\n\t\t\t\tc_pos := c_pos + c_vel * t_cruise;\n\t\t\tEND_IF;\n\t\tEND_IF;\n\t\t// Final Decel\n\t\tshape_cnt := FC_S7RTT_BuildProfile(c_vel, c_acc, TargetVel, Limits.fAccMax, Limits.fJerkMax, t_shape_buf, j_shape_buf);\n\t\tFOR i:=1 TO shape_cnt DO IF SegmentCount < 32 THEN SegmentCount:=SegmentCount+1; Trajectory[SegmentCount].fDuration:=t_shape_buf[i]; Trajectory[SegmentCount].fJerk:=j_shape_buf[i]; END_IF; END_FOR;\n\tEND_IF;\nEND_IF;\n\n// ========================================================\n// 2.5 Trajectory Refinement (Precision Fix)\n// ========================================================\nIF SegmentCount > 0 AND NOT ModeVelocity THEN\n\tc_pos := StartState.fPos; c_vel := StartState.fVel; c_acc := StartState.fAcc;\n\tref_idx := -1; max_dt := -1.0;\n\tFOR i := 1 TO SegmentCount DO\n\t\tt_rec := Trajectory[i].fDuration; j_restore := Trajectory[i].fJerk;\n\t\tIF ABS(j_restore) < MATH_EPS AND ABS(c_acc) < EPS_ACC THEN IF t_rec > max_dt THEN max_dt:=t_rec; ref_idx:=i; v_cruise_start:=c_vel; END_IF; END_IF;\n\t\tc_pos:=c_pos+c_vel*t_rec+0.5*c_acc*t_rec*t_rec+(1.0/6.0)*j_restore*t_rec*t_rec*t_rec; c_vel:=c_vel+c_acc*t_rec+0.5*j_restore*t_rec*t_rec; c_acc:=c_acc+j_restore*t_rec;\n\tEND_FOR;\n\tgap := TargetPos - c_pos;\n\tIF ref_idx <> -1 AND ABS(gap) > EPS_DIST AND ABS(v_cruise_start) > EPS_VAL THEN\n\t\tdt_fix := gap / v_cruise_start;\n\t\tTrajectory[ref_idx].fDuration := Trajectory[ref_idx].fDuration + dt_fix;\n\t\tIF Trajectory[ref_idx].fDuration < EPS_TIME THEN Trajectory[ref_idx].fDuration := EPS_TIME; END_IF;\n\tEND_IF;\nEND_IF;\n\n// ========================================================\n// 3. Final Pass\n// ========================================================\nc_pos := StartState.fPos; c_vel := StartState.fVel; c_acc := StartState.fAcc;\nFOR i := 1 TO SegmentCount DO\n\tTrajectory[i].fPos := c_pos; Trajectory[i].fVel := c_vel; Trajectory[i].fAcc := c_acc;\n\tt_rec := Trajectory[i].fDuration; j_restore := Trajectory[i].fJerk;\n\tc_pos:=c_pos+c_vel*t_rec+0.5*c_acc*t_rec*t_rec+(1.0/6.0)*j_restore*t_rec*t_rec*t_rec; c_vel:=c_vel+c_acc*t_rec+0.5*j_restore*t_rec*t_rec; c_acc:=c_acc+j_restore*t_rec;\nEND_FOR;\n\nIF SegmentCount = 0 THEN\n\tTrajectory[1]:= StartState;\n\tTrajectory[1].fDuration := 0; Trajectory[1].fJerk := 0; Trajectory[1].fAcc := 0;\n\tSegmentCount := 1;\nEND_IF\n\nDone := TRUE;\nDone := TRUE;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "opensml_power.st",
      "source": "(*\n * MC_Power power stage / CiA402 enable sequence\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\n * Part of the strucpp plcopen-softmotion bundled library.\n *)\nFUNCTION_BLOCK OpenSML_Power\nVAR_IN_OUT\n\tAxis:OpenSML_Axis;\nEND_VAR\nVAR_INPUT\n\txEnable: BOOL;\n\txEmergencyStop: BOOL:=TRUE;\nEND_VAR\nVAR_OUTPUT\n\txDone: BOOL;\n\txError: BOOL;\nEND_VAR\nVAR\n\tiState:INT;\n\ttonTimeout:TON;\n\ttTimeOut:TIME:=T#500MS;\nEND_VAR\n\n\n(*\nMC_Power\nCan Also be used MC_Reset, just trigger xEnable.\nIt is Highly Recommend to use OpenSML_Stop to force stop movements.\n*)\nAxis.ControlWord.2:=xEmergencyStop;//QuickStop\nCASE iState OF\n\t0://start\n\t\txDone:=FALSE;\n\t\txError:=FALSE;\n\t\tAxis.ControlWord.0:=FALSE;//SwitchOn\n\t\tAxis.ControlWord.1:=FALSE;//EnableVoltage\n\t\tAxis.ControlWord.3:=FALSE;//EnableOperation\n\t\tAxis.ControlWord.7:=FALSE;//FaultReset\n\t\tIF xEnable THEN\n\t\t\tIF Axis.StatusWord.3 THEN iState:=10;//If there have error, Reset first\n\t\t\tELSE iState:=20;//No error, go go\n\t\t\tEND_IF\n\t\tEND_IF\n\t10://reset\n\t\tAxis.ControlWord.7:=TRUE;//bit7 faultreset\n\t\ttonTimeout(IN:=TRUE,PT:=tTimeOut);\n\t\tIF tonTimeout.Q AND NOT Axis.StatusWord.3 THEN//not fault\n\t\t\tAxis.ControlWord.7:=FALSE;//bit7 faultreset\n\t\t\ttonTimeout(IN:=FALSE);\n\t\t\tiState:=20;\n\t\tELSIF tonTimeout.Q THEN iState:=999;//error\n\t\tEND_IF\n\t20://Enable Voltage\n\t\tAxis.ControlWord.1:=TRUE;\n\t\ttonTimeout(IN:=TRUE,PT:=tTimeOut);\n\t\tIF Axis.StatusWord.0 THEN//ReadyToSwitchOn\n\t\t\ttonTimeout(IN:=FALSE);\n\t\t\tiState:=30;\n\t\tELSIF tonTimeout.Q THEN iState:=999;//error\n\t\tEND_IF\n\t30://Switch ON\n\t\tAxis.ControlWord.0:=TRUE;\n\t\ttonTimeout(IN:=TRUE,pt:=tTimeOut);\n\t\tIF Axis.StatusWord.1 THEN\n\t\t\ttonTimeout(IN:=FALSE);\n\t\t\tiState:=40;\n\t\tELSIF tonTimeout.Q THEN iState:=999;//error\n\t\tEND_IF\n\t40://EnableOperation\n\t\tAxis.Target_Position:=Axis.Position_Actual_Value;\n\t\tAxis.ControlWord.3:=TRUE;\n\t\ttonTimeout(IN:=TRUE,pt:=tTimeOut);\n\t\tIF Axis.StatusWord.2 THEN\n\t\t\ttonTimeout(IN:=FALSE);\n\t\t\tiState:=50;\n\t\tELSIF tonTimeout.Q THEN iState:=999;//error\n\t\tEND_IF\n\t50://Success\n\t\txDone:=TRUE;\n\t\tIF NOT xEnable THEN\n\t\t\tAxis.ControlWord.3:=FALSE;\n\t\t\tiState:=0;\n\t\tEND_IF\n\t\tIF Axis.StatusWord.3 THEN\n\t\t\tiState:=999;//Error when running\n\t\tEND_IF\n\t999://Error wait\n\t\ttonTimeout(IN:=FALSE);\n\t\txError:=TRUE;\n\t\tIF NOT xEnable THEN\n\t\t\tiState:=0;\n\t\tEND_IF\nEND_CASE\n\n\n\n\n\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "opensml_home.st",
      "source": "(*\n * Homing (CiA402 mode 6)\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\n * Part of the strucpp plcopen-softmotion bundled library.\n *)\nFUNCTION_BLOCK OpenSML_Home\nVAR_IN_OUT\n\tAxis:OpenSML_Axis;\nEND_VAR\nVAR_INPUT\n\txEnable:BOOL;\nEND_VAR\nVAR_OUTPUT\n\txDone:BOOL;\n\txError:BOOL;\nEND_VAR\nVAR\n\tiState:INT;\n\ttonTimeout:TON;\n\tPos_Old:DINT;\nEND_VAR\n\n\n\n(*\nHome Function Block\nNeed Manually Write To SDO:\n607C: Home Offset\n6098: Home method\n6099: Home Speeds*\n609A: Home Acceleration\n\n6099.01 - Home Speed for Search Limit Switch\n6099.02 - Home Speed for Index Pulse\n*)\nCASE iState OF\n\t0:\n\t\txDone:=FALSE;\n\t\txError:=FALSE;\n\t\tIF xEnable AND Axis.StatusWord.1 AND Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 6 AND NOT Axis.StatusWord.3 THEN//ready\n\t\t\tiState:=10;//go go\n\t\tELSIF xEnable AND Axis.StatusWord.1 AND Axis.Modes_of_operation_display <> 6 THEN//need switch mode\n\t\t\tAxis.ControlWord.3:=FALSE;//drop down operation enabled\n\t\t\tiState:=10;\n\t\tELSIF xEnable THEN\n\t\t\tiState:=999;//error\n\t\tEND_IF\n\t10:\n\t\tAxis.ControlWord.4 := FALSE;//Reset reference bit\n\t\tAxis.Modes_of_operation:=6;//Home Mode\n\t\tAxis.ControlWord.3:=Axis.Modes_of_operation_display=6;//Success change mode, enable operation\n\t\tIF Axis.StatusWord.2 THEN//Operation Enabled\n\t\t\tiState:=20;\n\t\tEND_IF\n\t20:\n\t\tAxis.ControlWord.4 := TRUE;//start reference\n\t\ttonTimeout(IN:=axis.Position_Actual_Value = Pos_Old, pt:=T#10S);//If Position didnt change, error\n\t\tPos_Old:=Axis.Position_Actual_Value;\n\t\tIF Axis.StatusWord.12 THEN//If HomeAttained, Success\n\t\t\ttonTimeout(IN:=FALSE);\n\t\t\tAxis.ControlWord.4:=FALSE;\n\t\t\tAxis.Target_Position:=Axis.Position_Actual_Value;\n\t\t\tiState:=30;\n\t\tELSIF tonTimeout.Q OR NOT xEnable OR Axis.StatusWord.3 OR Axis.StatusWord.13 THEN iState:=999;//error\n\t\tEND_IF\n\t30:\n\t\txDone:=TRUE;\n\t\tIF NOT xEnable THEN//Wait next home\n\t\t\tiState:=0;\n\t\tEND_IF\n\t999:\n\t\ttonTimeout(IN:=FALSE);\n\t\tAxis.ControlWord.4:=FALSE;\n\t\txError:=TRUE;\n\t\tIF NOT xEnable THEN\n\t\t\tiState:=0;\n\t\tEND_IF\nEND_CASE\n\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "opensml_profile_position.st",
      "source": "(*\n * Profile Position mode (CiA402 mode 1)\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\n * Part of the strucpp plcopen-softmotion bundled library.\n *)\nFUNCTION_BLOCK OpenSML_ProfilePosition\nVAR_IN_OUT\n\tAxis:OpenSML_Axis;\nEND_VAR\nVAR_INPUT\n\txEnable:BOOL;\n\txExecute: BOOL;\n\txContinueMove: BOOL;\n\txRelativeMode: BOOL;\n\tdiTargetPosition:DINT;\n\tudiProfileVelocity:UDINT;\nEND_VAR\nVAR_OUTPUT\n\txDone: BOOL;\n\txBusy: BOOL;\n\txMoving: BOOL;\n\txError: BOOL;\nEND_VAR\nVAR\n\tiState:INT;\n\ttonTimeout:TON;\n\ttTimeOut:TIME:=T#200MS;\nEND_VAR\n\n\n(*\nProfile Position Mode (=1)\nManually Write To SDO or Write To PDO If Needed:\n6083: Profile Acceleration\n6084: Profile Deceleration\n6085: Quick Stop Deceleration\n*)\n//Settings\nAxis.ControlWord.5:=xContinueMove;//It means if 1st positon not arrived and there got 2st position, It Will No Deceleration And continues the movements.\nAxis.ControlWord.6:=xRelativeMode;//0 is Absolute, 1 is Relative\nAxis.ControlWord.4:=xExecute AND iState = 20;\nxBusy:=iState=20 AND Axis.StatusWord.12 AND NOT Axis.StatusWord.10;//Acknowledge and not Reached\nxDone:=iState=20 AND Axis.StatusWord.10 AND NOT Axis.StatusWord.13;//Target Reached and not Following Error\nxMoving:=NOT Axis.StatusWord.14;//Not Standstill\n\nCASE iState OF\n\t0://start\n\t\txDone:=FALSE;\n\t\txBusy:=FALSE;\n\t\txError:=FALSE;\n\t\tIF xEnable AND Axis.StatusWord.1 AND Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 1 AND NOT Axis.StatusWord.3 THEN//ready\n\t\t\tiState:=10;//go go\n\t\tELSIF xEnable AND Axis.StatusWord.1 AND Axis.Modes_of_operation_display <> 1 THEN//need switch mode\n\t\t\tAxis.ControlWord.3:=FALSE;//drop down operation enabled\n\t\t\tiState:=10;\n\t\tELSIF xEnable THEN\n\t\t\tiState:=999;//error\n\t\tEND_IF\n\t10://Set Mode\n\t\tAxis.Modes_of_operation:=1;//Profile Position Mode\n\t\tAxis.ControlWord.3:=Axis.Modes_of_operation_display=1;//Success change mode, enable operation\n\t\tIF Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 1 THEN//Operation Enabled, Mode Changed success\n\t\t\tiState:=20;\n\t\tEND_IF\n\t20://Movement\n\t\tAxis.Profile_Velocity:=udiProfileVelocity;\n\t\tAxis.Target_Position:=diTargetPosition;\n\t\tIF Axis.StatusWord.13 OR Axis.StatusWord.3 THEN//Axis Error\n\t\t\tiState:=999;\n\t\tELSIF NOT xEnable THEN\n\t\t\tAxis.Profile_Velocity:=0;\n\t\t\tAxis.Target_Position:=0;\n\t\t\tiState:=0;\n\t\tEND_IF\n\t999://Error wait\n\t\tAxis.Profile_Velocity:=0;\n\t\tAxis.Target_Position:=0;\n\t\ttonTimeout(IN:=FALSE);\n\t\txError:=TRUE;\n\t\tIF NOT xEnable THEN\n\t\t\tiState:=0;\n\t\tEND_IF\nEND_CASE\n\n\n\n\n\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "opensml_profile_velocity.st",
      "source": "(*\n * Profile Velocity mode (CiA402 mode 3)\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\n * Part of the strucpp plcopen-softmotion bundled library.\n *)\nFUNCTION_BLOCK OpenSML_ProfileVelocity\nVAR_IN_OUT\n\tAxis:OpenSML_Axis;\nEND_VAR\nVAR_INPUT\n\txEnable:BOOL;\n\tdiTargetVelocity:DINT;\nEND_VAR\nVAR_OUTPUT\n\txError: BOOL;\nEND_VAR\nVAR\n\tiState:INT;\n\ttonTimeout:TON;\n\ttTimeOut:TIME:=T#200MS;\nEND_VAR\n\n\n\n(*\nProfile Velocity Mode (=3)\nManually Write To SDO or Write To PDO If Needed:\n6083: Profile Acceleration\n6084: Profile Deceleration\n6085: Quick Stop Deceleration\n*)\nCASE iState OF\n\t0://start\n\t\txError:=FALSE;\n\t\tIF xEnable AND Axis.StatusWord.1 AND Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 3 AND NOT Axis.StatusWord.3 THEN//ready\n\t\t\tiState:=10;//go go\n\t\tELSIF xEnable AND Axis.StatusWord.1 AND Axis.Modes_of_operation_display <> 3 THEN//need switch mode\n\t\t\tAxis.ControlWord.3:=FALSE;//drop down operation enabled\n\t\t\tiState:=10;\n\t\tELSIF xEnable THEN\n\t\t\tiState:=999;//error\n\t\tEND_IF\n\t10://Set Mode\n\t\tAxis.Modes_of_operation:=3;//Profile Velocity Mode\n\t\tAxis.ControlWord.3:=Axis.Modes_of_operation_display=3;//Success change mode, enable operation\n\t\tIF Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 3 THEN//Operation Enabled, Mode Changed success\n\t\t\tiState:=20;\n\t\tEND_IF\n\t20://Movement\n\t\tAxis.Target_Velocity:=diTargetVelocity;\n\t\tIF Axis.StatusWord.3 THEN\n\t\t\tiState:=999;\n\t\tELSIF NOT xEnable THEN\n\t\t\tAxis.Target_Velocity:=0;\n\t\t\tiState:=0;\n\t\tEND_IF\n\t999://Error wait\n\t\tAxis.Target_Velocity:=0;\n\t\ttonTimeout(IN:=FALSE);\n\t\txError:=TRUE;\n\t\tIF NOT xEnable THEN\n\t\t\tiState:=0;\n\t\tEND_IF\nEND_CASE\n\n\n\n\n\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "opensml_stop.st",
      "source": "(*\n * Software stop (halt bit)\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\n * Part of the strucpp plcopen-softmotion bundled library.\n *)\nFUNCTION_BLOCK OpenSML_Stop\nVAR_IN_OUT\n\tAxis:OpenSML_Axis;\nEND_VAR\nVAR_INPUT\n\txStop: BOOL;\nEND_VAR\nVAR_OUTPUT\nEND_VAR\nVAR\nEND_VAR\n\n\n\n(*\nMC_Stop\nSoftware Stop, True=Stop\n*)\nAxis.ControlWord.8:=xStop;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "opensml_sync_position.st",
      "source": "(*\n * OpenSML Cyclic Synchronous Position (CiA402 mode 8) via S7RTT OTG.\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\n *)\nFUNCTION_BLOCK OpenSML_SyncPosition\r\nVAR_IN_OUT\r\n\tAxis:OpenSML_Axis;\r\nEND_VAR\r\nVAR_INPUT\r\n\tMaxVelocity :LREAL:=2000;\r\n\tMaxAcceleration :LREAL:=200;\r\n\tMaxJerk :LREAL:=200;\r\n\tCycleTime:LREAL:=0.001;//0.001 = 1ms\r\n\r\n\tTargetPosition :LREAL;\r\n\txEnable: BOOL;\r\n\tlrScale:LREAL:=1.0;\n\txSimulation: BOOL;\t// added: referenced in body but undeclared upstream\r\nEND_VAR\r\nVAR_OUTPUT\r\n\txError: BOOL;\r\nEND_VAR\r\nVAR\r\n\totg : FB_S7RTT_OTG;\r\n\tiState:INT;\r\n\t\r\nEND_VAR\r\n\r\n\r\n(*\r\nCyclic Synchronous Position Mode (=8)\r\nSet 6060(Op mode) and 60C2(Interpolation time period) at Startup Parameters.\r\n\r\n#####################################\r\nNEED StruckigLight Library for Quadratic Velocity Ramp Calculate.\r\n\r\nIf in movement, Please DO NOT Drop down xEnable.\r\n#####################################\r\n*)\r\n\r\nCASE iState OF\r\n\t0://start\r\n\t\txError:=FALSE;\r\n\t\tIF xEnable AND Axis.StatusWord.1 AND Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 8 AND NOT Axis.StatusWord.3 THEN//ready\r\n\t\t\tiState:=10;//go go\r\n\t\tELSIF xEnable AND Axis.StatusWord.1 AND Axis.Modes_of_operation_display <> 8 THEN//need switch mode\r\n\t\t\tAxis.ControlWord.3:=FALSE;//drop down operation enabled, motor could free move\r\n\t\t\tiState:=10;\r\n\t\tELSIF xSimulation THEN\r\n\t\t\tiState:=20;\r\n\t\tELSIF xEnable THEN\r\n\t\t\tiState:=999;//error\r\n\t\tEND_IF\r\n\t10://Set Mode\r\n\t\tAxis.Modes_of_operation:=8;//Cyclic Synchronous Position Mode\r\n\t\tAxis.ControlWord.3:=Axis.Modes_of_operation_display=8;//Success change mode, enable operation\r\n\t\totg.CurrentPosition:=DINT_TO_LREAL(Axis.Position_Actual_Value) / lrScale;//Write actual position to otg\r\n\t\tIF Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 8 THEN//Operation Enabled, Mode Changed success\r\n\t\t\tiState:=20;\r\n\t\tEND_IF\r\n\t20://Movement\r\n\t\totg(\r\n\t\t\tControlInterface:= FALSE , \r\n\t\t\tTargetPosition:= TargetPosition , \r\n\t\t\tTargetVelocity:= 0 , \r\n\t\t\tCycleTime:= CycleTime,\r\n\t\t\tMaxVelocity:= MaxVelocity , \r\n\t\t\tMaxAcceleration:= MaxAcceleration , \r\n\t\t\tMaxJerk:= MaxJerk);//accept new position and going on\r\n\t\t\t\r\n\t\tIF otg.NewPosition >= 0 THEN\r\n\t\t\tAxis.Target_Position := LREAL_TO_DINT(otg.NewPosition * lrScale);\r\n\t\tELSE\r\n\t\t\tAxis.Target_Position := - LREAL_TO_DINT( - otg.NewPosition * lrScale);//it fix negative overflow problem.\r\n\t\tEND_IF\r\n\t\t\r\n\t\tIF Axis.StatusWord.13 OR Axis.StatusWord.3 OR otg.xError THEN//Axis Error\r\n\t\t\tiState:=999;\r\n\t\tELSIF NOT xEnable THEN\r\n\t\t\tiState:=0;\r\n\t\tEND_IF\r\n\t999://Error wait\r\n\t\txError:=TRUE;\r\n\t\tIF NOT xEnable THEN\r\n\t\t\tiState:=0;\r\n\t\tEND_IF\r\nEND_CASE\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "opensml_sync_velocity.st",
      "source": "(*\n * OpenSML Cyclic Synchronous Velocity via S7RTT OTG (streams position in mode 8).\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\n *)\nFUNCTION_BLOCK OpenSML_SyncVelocity\r\nVAR_IN_OUT\r\n\tAxis:OpenSML_Axis;\r\nEND_VAR\r\nVAR_INPUT\r\n\tMaxVelocity :LREAL:=2000;\r\n\tMaxAcceleration :LREAL:=200;\r\n\tMaxJerk :LREAL:=200;\r\n\tCycleTime:LREAL:=0.001;//0.001 = 1ms\r\n\r\n\tTargetVelocity :LREAL;\r\n\txEnable: BOOL;\r\n\tlrScale:LREAL:=1.0;\r\n\txSimulation: BOOL;\r\nEND_VAR\r\nVAR_OUTPUT\r\n\txError: BOOL;\r\nEND_VAR\r\nVAR\r\n\totg : FB_S7RTT_OTG;\r\n\tiState:INT;\r\n\t\r\nEND_VAR\r\n\r\n\r\n(*\r\nNormally we use CSP(=8) as CSV(=9) cus mostly servo dont have TargetVelocity PDO by default.\r\nIf you really want use CSV mode, Please connect OpenSML_SyncVelocity.otg.NewVelocity to TargetVelocity PDO after scale.\r\n\r\nCyclic Synchronous Position Mode (=8)\r\nSet 6060(Op mode) and 60C2(Interpolation time period) at Startup Parameters.\r\n\r\n#####################################\r\nNEED StruckigLight Library for Quadratic Velocity Ramp Calculate.\r\n\r\nIf in movement, Please DO NOT Drop down xEnable.\r\n#####################################\r\n*)\r\nCASE iState OF\r\n\t0://start\r\n\t\txError:=FALSE;\r\n\t\tIF xEnable AND Axis.StatusWord.1 AND Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 8 AND NOT Axis.StatusWord.3 THEN//ready\r\n\t\t\tiState:=10;//go go\r\n\t\tELSIF xEnable AND Axis.StatusWord.1 AND Axis.Modes_of_operation_display <> 8 THEN//need switch mode\r\n\t\t\tAxis.ControlWord.3:=FALSE;//drop down operation enabled, motor could free move\r\n\t\t\tiState:=10;\r\n\t\tELSIF xSimulation THEN\r\n\t\t\tiState:=20;\r\n\t\tELSIF xEnable THEN\r\n\t\t\tiState:=999;//error\r\n\t\tEND_IF\r\n\t10://Set Mode\r\n\t\tAxis.Modes_of_operation:=8;//Cyclic Synchronous Position Mode\r\n\t\tAxis.ControlWord.3:=Axis.Modes_of_operation_display=8;//Success change mode, enable operation\r\n\t\totg.CurrentPosition:=DINT_TO_LREAL(Axis.Position_Actual_Value) / lrScale;//Write actual position to otg\r\n\t\tIF Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 8 THEN//Operation Enabled, Mode Changed success\r\n\t\t\tiState:=20;\r\n\t\tEND_IF\r\n\t20://Movement\r\n\t\totg(\r\n\t\t\tControlInterface:= TRUE , \r\n\t\t\tTargetPosition:= 0 , \r\n\t\t\tTargetVelocity:= TargetVelocity , \r\n\t\t\tCycleTime:=CycleTime,\r\n\t\t\tMaxVelocity:= MaxVelocity , \r\n\t\t\tMaxAcceleration:= MaxAcceleration , \r\n\t\t\tMaxJerk:= MaxJerk);//accept new velocity and going on\r\n\t\t\t\r\n\t\tIF otg.NewPosition >= 0 THEN\r\n\t\t\tAxis.Target_Position := LREAL_TO_DINT(otg.NewPosition * lrScale);\r\n\t\tELSE\r\n\t\t\tAxis.Target_Position := - LREAL_TO_DINT( - otg.NewPosition * lrScale);//it fix negative overflow problem.\r\n\t\tEND_IF\r\n\t\t\r\n\t\tIF Axis.StatusWord.13 OR Axis.StatusWord.3 OR otg.xError THEN//Axis Error\r\n\t\t\tiState:=999;\r\n\t\tELSIF NOT xEnable THEN\r\n\t\t\tiState:=0;\r\n\t\tEND_IF\r\n\t999://Error wait\r\n\t\txError:=TRUE;\r\n\t\tIF NOT xEnable THEN\r\n\t\t\tiState:=0;\r\n\t\tEND_IF\r\nEND_CASE\r\n\r\n\r\n\r\n\r\n\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "opensml_axis_controller.st",
      "source": "(*\r\n * OpenSML_AxisController — high-level jog/follow controller over OpenSML_Control.\r\n * Vendored from OpenSML (https://github.com/feecat/OpenSML), GPL-3.0.\r\n *)\r\nFUNCTION_BLOCK OpenSML_AxisController\r\nVAR_IN_OUT\r\n\tAxis:OpenSML_Axis;\r\n\tControl:OpenSML_Control;\r\nEND_VAR\r\nVAR\r\n\tPower:OpenSML_Power;\r\n\tHome:OpenSML_Home;\r\n\tiState:INT;\r\n\totg : FB_S7RTT_OTG;\r\n\tInterfaceType:BOOL;\r\n\tJogVel:LREAL;\r\n\tMoveVel:LREAL;\r\nEND_VAR\r\n\r\n\r\n\r\n\r\nPower(\r\n\tAxis:=Axis , \r\n\txEnable:=Control.xAxisEnable , \r\n\txEmergencyStop:=Control.xEmergencyStop ,\r\n\txDone=>Control.xEnabled );\r\n\r\nHome(\r\n\tAxis:=Axis , \r\n\txEnable:=Control.xHomeEnable AND NOT Control.xMoveEnable ,\r\n\txDone=>Control.xHomeDone );\r\n\r\n(*\r\nCyclic Synchronous Position Mode (=8)\r\nSet 6060(Op mode) and 60C2(Interpolation time period) at Startup Parameters.\r\n\r\n#####################################\r\nNEED StruckigLight Library for Quadratic Velocity Ramp Calculate.\r\n\r\nIf in movement, Please DO NOT Drop down xEnable.\r\n#####################################\r\n*)\r\n\r\nControl.xInPosition:=FALSE;\r\n\r\nIF control.xSimulation THEN\r\n\tAxis.Position_Actual_Value:=Axis.Target_Position;\r\nEND_IF\r\n\r\ncontrol.lrActualPosition:=DINT_TO_LREAL(Axis.Position_Actual_Value) / Control.Scale;\r\n\r\nCASE iState OF\r\n\t0://start\r\n\t\tControl.xError:=FALSE;\r\n\t\tIF Control.xMoveEnable AND Axis.StatusWord.1 AND Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 8 AND NOT Axis.StatusWord.3 THEN//ready\r\n\t\t\tiState:=10;//go go\r\n\t\tELSIF Control.xMoveEnable AND Axis.StatusWord.1 AND Axis.Modes_of_operation_display <> 8 THEN//need switch mode\r\n\t\t\tAxis.ControlWord.3:=FALSE;//drop down operation enabled, motor could free move\r\n\t\t\tiState:=10;\r\n\t\tELSIF Control.xMoveEnable AND Control.xSimulation THEN\r\n\t\t\tiState:=20;\r\n\t\tELSIF Control.xMoveEnable THEN\r\n\t\t\tiState:=999;//error\r\n\t\tEND_IF\r\n\t10://Set Mode\r\n\t\tAxis.Modes_of_operation:=8;//Cyclic Synchronous Position Mode\r\n\t\tAxis.ControlWord.3:=Axis.Modes_of_operation_display=8;//Success change mode, enable operation\r\n\t\totg.CurrentPosition:=DINT_TO_LREAL(Axis.Position_Actual_Value) / Control.Scale;//Write actual position to otg\r\n\t\tIF Axis.StatusWord.2 AND Axis.Modes_of_operation_display = 8 THEN//Operation Enabled, Mode Changed success\r\n\t\t\tiState:=20;\r\n\t\tEND_IF\r\n\t20://Movement\r\n\t\tIF Control.JogPos AND NOT Control.xFollowEnable THEN\r\n\t\t\tInterfaceType:=1;\r\n\t\t\tJogVel:=MIN(Control.JogVelocity, Control.MaxVelocity);\r\n\t\tELSIF Control.JogNeg AND NOT Control.xFollowEnable THEN\r\n\t\t\tInterfaceType:=1;\r\n\t\t\tJogVel:=MAX(-Control.JogVelocity, -Control.MaxVelocity);\r\n\t\tELSE\r\n\t\t\tInterfaceType:=1;\r\n\t\t\tJogVel:=0;\r\n\t\tEND_IF\r\n\t\t\r\n\t\tIF Control.xFollowEnable AND Control.lrFollowVelocity > 0 THEN\r\n\t\t\tInterfaceType:=0;\r\n\t\t\tMoveVel:=MIN(Control.lrFollowVelocity, Control.MaxVelocity);\r\n\t\tELSE\r\n\t\t\tMoveVel:= Control.MaxVelocity;\r\n\t\tEND_IF\r\n\t\t\r\n\t\totg(\r\n\t\t\tControlInterface:= InterfaceType,\r\n\t\t\tTargetPosition:= Control.lrFollowPosition , \r\n\t\t\tTargetVelocity:= JogVel , \r\n\t\t\tCycleTIme:= Control.CycleTime,\r\n\t\t\tMaxVelocity:= MoveVel,//Control.para.MaxVelocity , \r\n\t\t\tMaxAcceleration:= Control.MaxAcceleration , \r\n\t\t\tMaxJerk:= Control.MaxJerk);//accept new position and going on\r\n\t\t\t\r\n\t\tIF otg.NewPosition >= 0 THEN\r\n\t\t\tAxis.Target_Position := LREAL_TO_DINT(otg.NewPosition * Control.Scale);\r\n\t\tELSE\r\n\t\t\tAxis.Target_Position := - LREAL_TO_DINT( - otg.NewPosition * Control.Scale);//it fix negative overflow problem.\r\n\t\tEND_IF\r\n\t\t\r\n\t\tControl.xInPosition := ABS(otg.NewPosition - Control.lrActualPosition) < 0.01;\r\n\t\t\r\n\t\tIF Axis.StatusWord.13 OR Axis.StatusWord.3 OR otg.xError OR Power.xError OR Home.xError THEN//Axis Error\r\n\t\t\tiState:=999;\r\n\t\tELSIF NOT Control.xMoveEnable THEN\r\n\t\t\tiState:=0;\r\n\t\tEND_IF\r\n\t999://Error wait\r\n\t\tControl.xError:=TRUE;\r\n\t\tIF NOT Control.xMoveEnable THEN\r\n\t\t\tiState:=0;\r\n\t\tEND_IF\r\nEND_CASE\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nEND_FUNCTION_BLOCK\r\n"
    },
    {
      "fileName": "sm3_enums.st",
      "source": "(*\n * CODESYS SoftMotion (SM3) compatible enum types.\n *\n * Values follow CODESYS SM3_Basic / SM3_Error so that ported application code\n * comparing against these names/values behaves identically. This is the\n * single-axis CiA 402 subset (see docs/PLCOPEN_SOFTMOTION_ETHERCAT_PLAN.md).\n *)\n\n(* PLCopen axis state (AXIS_REF_SM3.nAxisState) *)\nTYPE SMC_AXIS_STATE : (\n\tpower_off := 0,\n\terrorstop := 1,\n\tstopping := 2,\n\tstandstill := 3,\n\tdiscrete_motion := 4,\n\tcontinuous_motion := 5,\n\tsynchronized_motion := 6,\n\thoming := 7\n); END_TYPE\n\n(* Controller mode (AXIS_REF_SM3.byControllerMode / SMC_SetControllerMode) *)\nTYPE SMC_CONTROLLER_MODE : (\n\tSMC_nocontrol := 0,\n\tSMC_torque := 1,\n\tSMC_velocity := 2,\n\tSMC_position := 3,\n\tSMC_current := 4\n); END_TYPE\n\n(* Movement direction for MC_MoveAbsolute / MC_MoveVelocity (modulo axes) *)\nTYPE MC_DIRECTION : (\n\tmcd_negative := -1,\n\tmcd_current := 0,\n\tmcd_positive := 1,\n\tmcd_shortest := 2,\n\tmcd_fastest := 3\n); END_TYPE\n\n(* Buffering behaviour relative to a preceding motion command *)\nTYPE MC_BUFFER_MODE : (\n\tmcbm_aborting := 0,\n\tmcbm_buffered := 1,\n\tmcbm_blending_low := 2,\n\tmcbm_blending_previous := 3,\n\tmcbm_blending_next := 4,\n\tmcbm_blending_high := 5\n); END_TYPE\n\n(* Homing mode (subset — the CiA 402 relevant ones) *)\nTYPE SMC_HOMING_MODE : (\n\tsmc_hm_direct := 0,\n\tsmc_hm_limit_switch := 1,\n\tsmc_hm_reference_pulse := 2,\n\tsmc_hm_drive_internal := 35\n); END_TYPE\n\n(*\n * Error identifier (MC_*.ErrorID). Single-axis CiA 402 subset of CODESYS\n * SMC_ERROR (the 0..~500 drive-interface / limits / controller-mode /\n * FB-input band). Values match CODESYS where documented.\n *)\nTYPE SMC_ERROR : (\n\tSMC_NO_ERROR := 0,\n\tSMC_DI_GENERAL_COMMUNICATION_ERROR := 1,\n\tSMC_DI_AXIS_ERROR := 2,\n\tSMC_DI_SWLIMITS_EXCEEDED := 10,\n\tSMC_DI_HWLIMITS_EXCEEDED := 11,\n\tSMC_DI_HALT_OR_QUICKSTOP_NOT_SUPPORTED := 12,\n\tSMC_DI_VOLTAGE_DISABLED := 13,\n\tSMC_DI_FIELDBUS_LOST_SYNCRONITY := 14,\n\tSMC_DI_COMMUNICATION_INTERRUPTED := 15,\n\tSMC_REGULATOR_OR_START_NOT_SET := 20,\n\tSMC_WRONG_CONTROLLER_MODE := 21,\n\tSMC_FB_WASNT_CALLED_DURING_MOTION := 22,\n\tSMC_AXIS_IS_NO_AXIS_REF := 23,\n\tSMC_AXIS_REF_CHANGED_DURING_OPERATION := 24,\n\tSMC_FB_ACTIVE_AXIS_DISABLED := 25,\n\tSMC_AXIS_NOT_READY_FOR_MOTION := 26,\n\tSMC_NicNyet_ERROR := 30,\n\tSMC_MA_INVALID_ACCDEC_VALUES := 110,\n\tSMC_MA_INVALID_DIRECTION := 111,\n\tSMC_MV_INVALID_VELACC_VALUES := 120,\n\tSMC_MV_DIRECTION_NOT_APPLICABLE := 121,\n\tSMC_H_AXIS_WASNT_STANDING_STILL := 130,\n\tSMC_H_AXIS_DIDNT_START_HOMING := 131,\n\tSMC_H_HOMING_TIMEOUT := 132,\n\tSMC_R_NO_ERROR_TO_RESET := 140,\n\tSMC_R_DRIVE_DOESNT_ANSWER := 141,\n\tSMC_STOP_ERROR_DURING_STOP := 150,\n\tSMC_3SH_INVALID_VELACC_VALUES := 160\n); END_TYPE\n"
    },
    {
      "fileName": "sm3_axis_ref.st",
      "source": "(*\n * AXIS_REF_SM3 — CODESYS SoftMotion-compatible axis reference.\n *\n * Application code declares an axis of this type (the EtherCAT drive's name),\n * passes it to MC_* blocks by VAR_IN_OUT, and reads/writes its fields\n * (fActPosition, nAxisState, …) — exactly as in CODESYS. It is a STRUCT (not an\n * FB): real CODESYS application code never calls axis methods (those are all\n * driver-internal). All positions/velocities are in technical (user) units;\n * the embedded `Drive` carries the raw CiA 402 PDO words in increments, and\n * SM_Drive_GenericDS402 bridges between them each scan.\n *)\nTYPE AXIS_REF_SM3 :\nSTRUCT\n\t(* --- Command (written by MC_* blocks, in technical units) --- *)\n\tfSetPosition : LREAL;              (* commanded position [u] *)\n\tfSetVelocity : LREAL;              (* commanded velocity [u/s] *)\n\tfSetAcceleration : LREAL;          (* commanded acceleration [u/s2] *)\n\tfSetDeceleration : LREAL;          (* commanded deceleration [u/s2] *)\n\tfSetJerk : LREAL;                  (* commanded jerk [u/s3] *)\n\tbRegulatorOn : BOOL;               (* power-stage enable command *)\n\tbDriveStart : BOOL;                (* quick-stop release command *)\n\tbyControllerMode : BYTE;           (* SMC_CONTROLLER_MODE as BYTE *)\n\n\t(* --- Feedback (updated by the drive bridge, in technical units) --- *)\n\tfActPosition : LREAL;              (* actual position [u] *)\n\tfActVelocity : LREAL;              (* actual velocity [u/s] *)\n\tfActTorque : LREAL;                (* actual torque *)\n\tnAxisState : SMC_AXIS_STATE;       (* PLCopen axis state *)\n\tbRegulatorRealState : BOOL;        (* real power-stage state *)\n\tbDriveStartRealState : BOOL;       (* real quick-stop-released state *)\n\tbyRealControllerMode : BYTE;       (* actual controller mode *)\n\n\t(* --- Error / communication --- *)\n\tbError : BOOL;\n\tdwErrorID : DWORD;                 (* SMC_ERROR as DWORD *)\n\tbCommunication : BOOL;\n\twCommunicationState : WORD;\n\n\t(* --- Scaling (increments <-> technical units) --- *)\n\tiRatioTechUnitsNum : DINT := 1;    (* CODESYS param 1052 *)\n\tdwRatioTechUnitsDenom : DWORD := 1;(* CODESYS param 1051 *)\n\tfScalefactor : LREAL := 1.0;       (* CODESYS param 1054 *)\n\tfIncPerUnit : LREAL := 1.0;        (* derived: increments per user unit *)\n\n\t(* --- Axis configuration --- *)\n\tfPositionPeriod : LREAL := 360.0;  (* modulo period [u] *)\n\tbModulo : BOOL;                    (* TRUE = rotary/modulo axis *)\n\tfSWLimitPositive : LREAL;\n\tfSWLimitNegative : LREAL;\n\tbSWLimitEnable : BOOL;\n\tfCycleTime : LREAL := 0.01;        (* task cycle [s], for OTG *)\n\n\t(* --- Raw CiA 402 interface (increments) bridged to the drive PDOs --- *)\n\tDrive : OpenSML_Axis;\nEND_STRUCT\nEND_TYPE\n"
    },
    {
      "fileName": "sm3_drive.st",
      "source": "(*\n * SM_Drive_GenericDS402 — generic CiA 402 (DS402) drive bridge.\n *\n * The OpenPLC analogue of CODESYS SM_Drive_ETC_GenericDSP402. One instance per\n * axis, called once per scan (generated by the editor at the top of the scan).\n * It is the ONLY block that copies the CiA 402 PDO image and converts between\n * increments and technical units. Data flow forms a one-scan pipeline:\n *   - copy this scan's drive TxPDO inputs  -> Axis.Drive + engineering feedback\n *   - copy last scan's MC_* command words  -> drive RxPDO outputs\n * The MC_* blocks run in between and act on Axis / Axis.Drive.\n *)\nFUNCTION_BLOCK SM_Drive_GenericDS402\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\t(* from drive TxPDOs *)\n\twStatusWord : UINT;                    (* 0x6041 *)\n\tsiModesDisplay : SINT;                 (* 0x6061 *)\n\tdiActualPosition : DINT;               (* 0x6064 *)\n\tdiActualVelocity : DINT;               (* 0x606C *)\n\tiActualTorque : INT;                   (* 0x6077 *)\n\tbOnline : BOOL := TRUE;                (* fieldbus/slave operational *)\nEND_VAR\nVAR_OUTPUT\n\t(* to drive RxPDOs *)\n\twControlWord : UINT;                   (* 0x6040 *)\n\tsiModes : SINT;                        (* 0x6060 *)\n\tdiTargetPosition : DINT;               (* 0x607A *)\n\tudiProfileVelocity : UDINT;            (* 0x6081 *)\n\tdiTargetVelocity : DINT;               (* 0x60FF *)\n\tiTargetTorque : INT;                   (* 0x6071 *)\nEND_VAR\n\n(* ---- 1. Ingest drive feedback into the raw CiA 402 image ---- *)\nAxis.Drive.StatusWord := wStatusWord;\nAxis.Drive.Modes_of_operation_display := siModesDisplay;\nAxis.Drive.Position_Actual_Value := diActualPosition;\nAxis.Drive.Velocity_Actual_Value := diActualVelocity;\nAxis.Drive.Torque_Actual_Value := iActualTorque;\n\n(* ---- 2. Refresh the increments<->units scale factor ---- *)\nIF Axis.dwRatioTechUnitsDenom = DWORD#0 THEN\n\tAxis.dwRatioTechUnitsDenom := DWORD#1;\nEND_IF\nAxis.fIncPerUnit := Axis.fScalefactor\n\t* DINT_TO_LREAL(Axis.iRatioTechUnitsNum)\n\t/ DWORD_TO_LREAL(Axis.dwRatioTechUnitsDenom);\nIF Axis.fIncPerUnit = 0.0 THEN\n\tAxis.fIncPerUnit := 1.0;\nEND_IF\n\n(* ---- 3. Engineering-unit feedback ---- *)\nAxis.fActPosition := DINT_TO_LREAL(Axis.Drive.Position_Actual_Value) / Axis.fIncPerUnit;\nAxis.fActVelocity := DINT_TO_LREAL(Axis.Drive.Velocity_Actual_Value) / Axis.fIncPerUnit;\nAxis.fActTorque := INT_TO_LREAL(Axis.Drive.Torque_Actual_Value);\nAxis.byRealControllerMode := SINT_TO_BYTE(Axis.Drive.Modes_of_operation_display);\n\n(* ---- 4. Communication + error + PLCopen state ---- *)\nAxis.bCommunication := bOnline;\nAxis.wCommunicationState := UINT_TO_WORD(Axis.Drive.StatusWord);\nAxis.bRegulatorRealState := Axis.Drive.StatusWord.2;   (* Operation enabled *)\nAxis.bDriveStartRealState := NOT Axis.Drive.StatusWord.5; (* NOT quick-stop-active *)\nAxis.bError := Axis.Drive.StatusWord.3;                (* Fault *)\n\nIF NOT bOnline THEN\n\tAxis.dwErrorID := DWORD#1;      (* SMC_DI_GENERAL_COMMUNICATION_ERROR *)\n\tAxis.nAxisState := SMC_AXIS_STATE.errorstop;\nELSIF Axis.bError THEN\n\tAxis.dwErrorID := DWORD#2;      (* SMC_DI_AXIS_ERROR *)\n\tAxis.nAxisState := SMC_AXIS_STATE.errorstop;\nELSE\n\tAxis.dwErrorID := DWORD#0;      (* SMC_NO_ERROR *)\n\tIF NOT Axis.Drive.StatusWord.2 THEN\n\t\tAxis.nAxisState := SMC_AXIS_STATE.power_off;        (* not operation-enabled *)\n\tELSIF Axis.Drive.StatusWord.14 THEN\n\t\tAxis.nAxisState := SMC_AXIS_STATE.standstill;       (* SW bit14: standstill *)\n\tELSIF Axis.Drive.Modes_of_operation_display = 3 THEN\n\t\tAxis.nAxisState := SMC_AXIS_STATE.continuous_motion;(* profile velocity *)\n\tELSIF Axis.Drive.Modes_of_operation_display = 6 THEN\n\t\tAxis.nAxisState := SMC_AXIS_STATE.homing;\n\tELSE\n\t\tAxis.nAxisState := SMC_AXIS_STATE.discrete_motion;\n\tEND_IF\nEND_IF\n\n(* ---- 5. Emit the RxPDO command image ---- *)\nwControlWord := Axis.Drive.ControlWord;\nsiModes := Axis.Drive.Modes_of_operation;\ndiTargetPosition := Axis.Drive.Target_Position;\nudiProfileVelocity := Axis.Drive.Profile_Velocity;\ndiTargetVelocity := Axis.Drive.Target_Velocity;\niTargetTorque := Axis.Drive.Target_torque;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "sm3_mc_blocks.st",
      "source": "(*\n * PLCopen MC_* function blocks — CODESYS SoftMotion SM3 compatible.\n *\n * Signatures/units match CODESYS SM3_Basic so CODESYS application code ports\n * unmodified: axis is AXIS_REF_SM3 (VAR_IN_OUT), positions/velocities are LREAL\n * technical units, and the standard PLCopen output set is provided. Each block\n * drives the validated OpenSML CiA 402 engine on the axis's embedded raw drive\n * image (Axis.Drive), converting technical units to increments via\n * Axis.fIncPerUnit (maintained by SM_Drive_GenericDS402).\n *\n * Supported buffering model: single active move (BufferMode Aborting). The\n * BufferMode / Direction inputs are accepted for signature compatibility;\n * blending/queuing across multiple concurrently-executing blocks is not\n * modelled. Acceleration/Deceleration/Jerk are recorded on the axis and, in\n * the drive-side profile modes, honoured by the drive's own ramp objects.\n *)\n\n(* ------------------------------------------------------------------ MC_Power *)\nFUNCTION_BLOCK MC_Power\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tEnable : BOOL;\n\tbRegulatorOn : BOOL := TRUE;   (* enable power stage / closed loop *)\n\tbDriveStart : BOOL := TRUE;    (* release quick stop *)\nEND_VAR\nVAR_OUTPUT\n\tStatus : BOOL;                 (* axis ready to move (operation enabled) *)\n\tbRegulatorRealState : BOOL;\n\tbDriveStartRealState : BOOL;\n\tBusy : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\nEND_VAR\nVAR\n\t_pwr : OpenSML_Power;\nEND_VAR\n\tAxis.bRegulatorOn := Enable AND bRegulatorOn;\n\tAxis.bDriveStart := Enable AND bDriveStart;\n\t_pwr(Axis := Axis.Drive,\n\t     xEnable := Enable AND bRegulatorOn,\n\t     xEmergencyStop := bDriveStart);\n\tStatus := _pwr.xDone;\n\tbRegulatorRealState := Axis.bRegulatorRealState;\n\tbDriveStartRealState := Axis.bDriveStartRealState;\n\tBusy := (Enable AND bRegulatorOn) AND NOT _pwr.xDone AND NOT _pwr.xError;\n\tError := _pwr.xError;\n\tIF _pwr.xError THEN ErrorID := SMC_REGULATOR_OR_START_NOT_SET;\n\tELSE ErrorID := SMC_NO_ERROR; END_IF\nEND_FUNCTION_BLOCK\n\n(* ---------------------------------------------------------- MC_MoveAbsolute *)\nFUNCTION_BLOCK MC_MoveAbsolute\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tExecute : BOOL;\n\tPosition : LREAL;              (* [u] *)\n\tVelocity : LREAL;             (* [u/s] *)\n\tAcceleration : LREAL;\n\tDeceleration : LREAL;\n\tJerk : LREAL;\n\tDirection : MC_DIRECTION := mcd_positive;\n\tBufferMode : MC_BUFFER_MODE := mcbm_aborting;\nEND_VAR\nVAR_OUTPUT\n\tDone : BOOL;\n\tBusy : BOOL;\n\tActive : BOOL;\n\tCommandAborted : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\nEND_VAR\nVAR\n\t_pp : OpenSML_ProfilePosition;\nEND_VAR\n\tIF Execute THEN\n\t\tAxis.byControllerMode := BYTE#3;   (* SMC_position *)\n\t\tAxis.fSetPosition := Position;\n\t\tAxis.fSetVelocity := Velocity;\n\t\tAxis.fSetAcceleration := Acceleration;\n\t\tAxis.fSetDeceleration := Deceleration;\n\t\tAxis.fSetJerk := Jerk;\n\tEND_IF\n\t_pp(Axis := Axis.Drive,\n\t    xEnable := Execute,\n\t    xExecute := Execute,\n\t    xContinueMove := (BufferMode <> mcbm_aborting),\n\t    xRelativeMode := FALSE,\n\t    diTargetPosition := LREAL_TO_DINT(Position * Axis.fIncPerUnit),\n\t    udiProfileVelocity := LREAL_TO_UDINT(ABS(Velocity) * Axis.fIncPerUnit));\n\tDone := _pp.xDone;\n\tBusy := _pp.xBusy;\n\tActive := _pp.xBusy;\n\tCommandAborted := FALSE;\n\tError := _pp.xError;\n\tIF _pp.xError THEN ErrorID := SMC_MA_INVALID_ACCDEC_VALUES;\n\tELSE ErrorID := SMC_NO_ERROR; END_IF\nEND_FUNCTION_BLOCK\n\n(* ---------------------------------------------------------- MC_MoveRelative *)\nFUNCTION_BLOCK MC_MoveRelative\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tExecute : BOOL;\n\tDistance : LREAL;             (* [u] *)\n\tVelocity : LREAL;             (* [u/s] *)\n\tAcceleration : LREAL;\n\tDeceleration : LREAL;\n\tJerk : LREAL;\n\tBufferMode : MC_BUFFER_MODE := mcbm_aborting;\nEND_VAR\nVAR_OUTPUT\n\tDone : BOOL;\n\tBusy : BOOL;\n\tActive : BOOL;\n\tCommandAborted : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\nEND_VAR\nVAR\n\t_pp : OpenSML_ProfilePosition;\nEND_VAR\n\tIF Execute THEN\n\t\tAxis.byControllerMode := BYTE#3;\n\t\tAxis.fSetVelocity := Velocity;\n\tEND_IF\n\t_pp(Axis := Axis.Drive,\n\t    xEnable := Execute,\n\t    xExecute := Execute,\n\t    xContinueMove := (BufferMode <> mcbm_aborting),\n\t    xRelativeMode := TRUE,\n\t    diTargetPosition := LREAL_TO_DINT(Distance * Axis.fIncPerUnit),\n\t    udiProfileVelocity := LREAL_TO_UDINT(ABS(Velocity) * Axis.fIncPerUnit));\n\tDone := _pp.xDone;\n\tBusy := _pp.xBusy;\n\tActive := _pp.xBusy;\n\tCommandAborted := FALSE;\n\tError := _pp.xError;\n\tIF _pp.xError THEN ErrorID := SMC_MA_INVALID_ACCDEC_VALUES;\n\tELSE ErrorID := SMC_NO_ERROR; END_IF\nEND_FUNCTION_BLOCK\n\n(* ---------------------------------------------------------- MC_MoveVelocity *)\nFUNCTION_BLOCK MC_MoveVelocity\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tExecute : BOOL;\n\tVelocity : LREAL;             (* [u/s], signed *)\n\tAcceleration : LREAL;\n\tDeceleration : LREAL;\n\tJerk : LREAL;\n\tDirection : MC_DIRECTION := mcd_current;\n\tBufferMode : MC_BUFFER_MODE := mcbm_aborting;\nEND_VAR\nVAR_OUTPUT\n\tInVelocity : BOOL;\n\tBusy : BOOL;\n\tActive : BOOL;\n\tCommandAborted : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\nEND_VAR\nVAR\n\t_pv : OpenSML_ProfileVelocity;\nEND_VAR\n\tIF Execute THEN\n\t\tAxis.byControllerMode := BYTE#2;   (* SMC_velocity *)\n\t\tAxis.fSetVelocity := Velocity;\n\tEND_IF\n\t_pv(Axis := Axis.Drive,\n\t    xEnable := Execute,\n\t    diTargetVelocity := LREAL_TO_DINT(Velocity * Axis.fIncPerUnit));\n\tBusy := Execute AND NOT _pv.xError;\n\tActive := Busy;\n\tCommandAborted := FALSE;\n\tError := _pv.xError;\n\t(* target reached: commanded, no fault, and actual within 1% of target *)\n\tInVelocity := Execute AND NOT _pv.xError\n\t              AND (ABS(Axis.fActVelocity - Velocity) <= (ABS(Velocity) * 0.01 + 1.0));\n\tIF _pv.xError THEN ErrorID := SMC_MV_INVALID_VELACC_VALUES;\n\tELSE ErrorID := SMC_NO_ERROR; END_IF\nEND_FUNCTION_BLOCK\n\n(* ------------------------------------------------------------------- MC_Halt *)\nFUNCTION_BLOCK MC_Halt\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tExecute : BOOL;\n\tDeceleration : LREAL;\n\tJerk : LREAL;\n\tBufferMode : MC_BUFFER_MODE := mcbm_aborting;\nEND_VAR\nVAR_OUTPUT\n\tDone : BOOL;\n\tBusy : BOOL;\n\tActive : BOOL;\n\tCommandAborted : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\nEND_VAR\nVAR\n\t_stp : OpenSML_Stop;\nEND_VAR\n\tIF Execute THEN\n\t\tAxis.fSetDeceleration := Deceleration;\n\t\tAxis.fSetJerk := Jerk;\n\tEND_IF\n\t_stp(Axis := Axis.Drive, xStop := Execute);\n\t(* standstill reached (SW bit14) => done; axis remains ready for new moves *)\n\tDone := Execute AND Axis.Drive.StatusWord.14;\n\tBusy := Execute AND NOT Done;\n\tActive := Busy;\n\tCommandAborted := FALSE;\n\tError := Axis.Drive.StatusWord.3;\n\tIF Error THEN ErrorID := SMC_STOP_ERROR_DURING_STOP;\n\tELSE ErrorID := SMC_NO_ERROR; END_IF\nEND_FUNCTION_BLOCK\n\n(* ------------------------------------------------------------------- MC_Stop *)\nFUNCTION_BLOCK MC_Stop\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tExecute : BOOL;\n\tDeceleration : LREAL;\n\tJerk : LREAL;\nEND_VAR\nVAR_OUTPUT\n\tDone : BOOL;\n\tBusy : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\nEND_VAR\nVAR\n\t_stp : OpenSML_Stop;\nEND_VAR\n\tIF Execute THEN\n\t\tAxis.fSetDeceleration := Deceleration;\n\t\tAxis.fSetJerk := Jerk;\n\tEND_IF\n\t(* MC_Stop locks the axis while Execute is held (no new motion accepted) *)\n\t_stp(Axis := Axis.Drive, xStop := Execute);\n\tDone := Execute AND Axis.Drive.StatusWord.14;\n\tBusy := Execute AND NOT Done;\n\tError := Axis.Drive.StatusWord.3;\n\tIF Error THEN ErrorID := SMC_STOP_ERROR_DURING_STOP;\n\tELSE ErrorID := SMC_NO_ERROR; END_IF\nEND_FUNCTION_BLOCK\n\n(* ------------------------------------------------------------------ MC_Reset *)\nFUNCTION_BLOCK MC_Reset\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tExecute : BOOL;\nEND_VAR\nVAR_OUTPUT\n\tDone : BOOL;\n\tBusy : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\nEND_VAR\n\t(* CiA 402 fault reset (Controlword bit 7); Done when fault (SW bit3) clears *)\n\tAxis.Drive.ControlWord.7 := Execute;\n\tDone := Execute AND NOT Axis.Drive.StatusWord.3;\n\tBusy := Execute AND Axis.Drive.StatusWord.3;\n\tError := FALSE;\n\tErrorID := SMC_NO_ERROR;\nEND_FUNCTION_BLOCK\n\n(* ------------------------------------------------------------------- MC_Home *)\nFUNCTION_BLOCK MC_Home\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tExecute : BOOL;\n\tPosition : LREAL;             (* absolute position at reference [u] *)\nEND_VAR\nVAR_OUTPUT\n\tDone : BOOL;\n\tBusy : BOOL;\n\tCommandAborted : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\nEND_VAR\nVAR\n\t_hm : OpenSML_Home;\nEND_VAR\n\tIF Execute THEN\n\t\tAxis.fSetPosition := Position;\n\tEND_IF\n\t_hm(Axis := Axis.Drive, xEnable := Execute);\n\tDone := _hm.xDone;\n\tBusy := Execute AND NOT _hm.xDone AND NOT _hm.xError;\n\tCommandAborted := FALSE;\n\tError := _hm.xError;\n\tIF _hm.xError THEN ErrorID := SMC_H_HOMING_TIMEOUT;\n\tELSE ErrorID := SMC_NO_ERROR; END_IF\nEND_FUNCTION_BLOCK\n\n(* ------------------------------------------------------------- MC_ReadStatus *)\nFUNCTION_BLOCK MC_ReadStatus\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tEnable : BOOL;\nEND_VAR\nVAR_OUTPUT\n\tValid : BOOL;\n\tBusy : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\n\tDisabled : BOOL;\n\tErrorstop : BOOL;\n\tStopping : BOOL;\n\tStandStill : BOOL;\n\tDiscreteMotion : BOOL;\n\tContinuousMotion : BOOL;\n\tSynchronizedMotion : BOOL;\n\tHoming : BOOL;\n\tConstantVelocity : BOOL;\n\tAccelerating : BOOL;\n\tDecelerating : BOOL;\n\tFBErrorOccured : BOOL;\nEND_VAR\n\tValid := Enable;\n\tBusy := FALSE;\n\tIF Enable THEN\n\t\tDisabled := Axis.nAxisState = SMC_AXIS_STATE.power_off;\n\t\tErrorstop := Axis.nAxisState = SMC_AXIS_STATE.errorstop;\n\t\tStopping := Axis.nAxisState = SMC_AXIS_STATE.stopping;\n\t\tStandStill := Axis.nAxisState = SMC_AXIS_STATE.standstill;\n\t\tDiscreteMotion := Axis.nAxisState = SMC_AXIS_STATE.discrete_motion;\n\t\tContinuousMotion := Axis.nAxisState = SMC_AXIS_STATE.continuous_motion;\n\t\tSynchronizedMotion := Axis.nAxisState = SMC_AXIS_STATE.synchronized_motion;\n\t\tHoming := Axis.nAxisState = SMC_AXIS_STATE.homing;\n\t\tError := Axis.bError;\n\t\tFBErrorOccured := Axis.bError;\n\t\tIF Axis.bError THEN ErrorID := SMC_DI_AXIS_ERROR;\n\t\tELSE ErrorID := SMC_NO_ERROR; END_IF\n\tEND_IF\nEND_FUNCTION_BLOCK\n\n(* ------------------------------------------------------ MC_ReadActualPosition *)\nFUNCTION_BLOCK MC_ReadActualPosition\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tEnable : BOOL;\nEND_VAR\nVAR_OUTPUT\n\tValid : BOOL;\n\tBusy : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\n\tPosition : LREAL;             (* [u] *)\nEND_VAR\n\tValid := Enable;\n\tBusy := FALSE;\n\tError := FALSE;\n\tErrorID := SMC_NO_ERROR;\n\tIF Enable THEN\n\t\tPosition := Axis.fActPosition;\n\tEND_IF\nEND_FUNCTION_BLOCK\n\n(* ------------------------------------------------------ MC_ReadActualVelocity *)\nFUNCTION_BLOCK MC_ReadActualVelocity\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tEnable : BOOL;\nEND_VAR\nVAR_OUTPUT\n\tValid : BOOL;\n\tBusy : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\n\tVelocity : LREAL;            (* [u/s] *)\nEND_VAR\n\tValid := Enable;\n\tBusy := FALSE;\n\tError := FALSE;\n\tErrorID := SMC_NO_ERROR;\n\tIF Enable THEN\n\t\tVelocity := Axis.fActVelocity;\n\tEND_IF\nEND_FUNCTION_BLOCK\n\n(* ---------------------------------------------------------- MC_ReadAxisError *)\nFUNCTION_BLOCK MC_ReadAxisError\nVAR_IN_OUT\n\tAxis : AXIS_REF_SM3;\nEND_VAR\nVAR_INPUT\n\tEnable : BOOL;\nEND_VAR\nVAR_OUTPUT\n\tValid : BOOL;\n\tBusy : BOOL;\n\tError : BOOL;\n\tErrorID : SMC_ERROR;\n\tAxisError : BOOL;\n\tAxisErrorID : DWORD;\nEND_VAR\n\tValid := Enable;\n\tBusy := FALSE;\n\tError := FALSE;\n\tErrorID := SMC_NO_ERROR;\n\tIF Enable THEN\n\t\tAxisError := Axis.bError;\n\t\tAxisErrorID := Axis.dwErrorID;\n\tEND_IF\nEND_FUNCTION_BLOCK\n"
    }
  ]
}
