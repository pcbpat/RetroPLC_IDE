      "name": "AXIS_REF_SM3",
      "kind": "type",
      "header": "struct AXIS_REF_SM3 {\n    IEC_LREAL FSETPOSITION{};\n    IEC_LREAL FSETVELOCITY{};\n    IEC_LREAL FSETACCELERATION{};\n    IEC_LREAL FSETDECELERATION{};\n    IEC_LREAL FSETJERK{};\n    IEC_BOOL BREGULATORON{};\n    IEC_BOOL BDRIVESTART{};\n    IEC_BYTE BYCONTROLLERMODE{};\n    IEC_LREAL FACTPOSITION{};\n    IEC_LREAL FACTVELOCITY{};\n    IEC_LREAL FACTTORQUE{};\n    IEC_SMC_AXIS_STATE NAXISSTATE{};\n    IEC_BOOL BREGULATORREALSTATE{};\n    IEC_BOOL BDRIVESTARTREALSTATE{};\n    IEC_BYTE BYREALCONTROLLERMODE{};\n    IEC_BOOL BERROR{};\n    IEC_DWORD DWERRORID{};\n    IEC_BOOL BCOMMUNICATION{};\n    IEC_WORD WCOMMUNICATIONSTATE{};\n    IEC_DINT IRATIOTECHUNITSNUM = 1;\n    IEC_DWORD DWRATIOTECHUNITSDENOM = 1;\n    IEC_LREAL FSCALEFACTOR = 1;\n    IEC_LREAL FINCPERUNIT = 1;\n    IEC_LREAL FPOSITIONPERIOD = 360;\n    IEC_BOOL BMODULO{};\n    IEC_LREAL FSWLIMITPOSITIVE{};\n    IEC_LREAL FSWLIMITNEGATIVE{};\n    IEC_BOOL BSWLIMITENABLE{};\n    IEC_LREAL FCYCLETIME = 0.01;\n    OPENSML_AXIS DRIVE{};\n};\n\nusing IEC_AXIS_REF_SM3 = AXIS_REF_SM3;\n",
      "cpp": "",
      "deps": [
        {
          "library": "plcopen-softmotion",
          "name": "OPENSML_AXIS"
        },
        {
          "library": "plcopen-softmotion",
          "name": "SMC_AXIS_STATE"
        }
      ]
    },
    {
      "name": "FB_S7RTT_PLAN",
      "kind": "functionBlock",
      "header": "class FB_S7RTT_PLAN {\npublic:\n    // Inputs\n    IEC_BOOL EXECUTE;\n    IEC_BOOL MODEVELOCITY;\n    ST_MOTIONSTATE STARTSTATE;\n    IEC_LREAL TARGETPOS;\n    IEC_LREAL TARGETVEL;\n    ST_MOTIONLIMITS LIMITS;\n    // Outputs\n    IEC_BOOL DONE;\n    IEC_BOOL ERROR;\n    IEC_INT SEGMENTCOUNT;\n    Array1D<ST_MOTIONSTATE, 1, 32> TRAJECTORY;\n    // Local variables\n    IEC_BOOL TRIG_EXEC;\n    IEC_BOOL PREV_EXEC;\n    IEC_LREAL C_POS;\n    IEC_LREAL C_VEL;\n    IEC_LREAL C_ACC;\n    IEC_INT I;\n    IEC_INT K;\n    IEC_LREAL DIST_REQ;\n    IEC_LREAL T_REC;\n    IEC_LREAL GAP;\n    IEC_LREAL D_UPPER;\n    IEC_LREAL D_LOWER;\n    IEC_LREAL T_CRUISE;\n    IEC_INT ITER;\n    IEC_LREAL SA;\n    IEC_LREAL SB;\n    IEC_LREAL SC;\n    IEC_LREAL FA;\n    IEC_LREAL FB;\n    IEC_LREAL FC;\n    IEC_LREAL SD;\n    IEC_LREAL SE;\n    IEC_LREAL TOL1;\n    IEC_LREAL XM;\n    IEC_LREAL MIN1;\n    IEC_LREAL MIN2;\n    IEC_LREAL FCOEFP;\n    IEC_LREAL FCOEFQ;\n    IEC_LREAL FCOEFR;\n    IEC_LREAL FCOEFS;\n    IEC_BOOL MFLAG;\n    IEC_BOOL USE_OPTIMAL;\n    IEC_BOOL OPT_SUCCESS;\n    IEC_INT J_IDX;\n    IEC_LREAL J_APPLY;\n    IEC_LREAL SEARCH_HORIZON;\n    IEC_LREAL T_EST;\n    IEC_LREAL SIM_P;\n    IEC_LREAL SIM_V;\n    IEC_LREAL SIM_A;\n    IEC_LREAL LIMIT_A;\n    IEC_LREAL DIST_TO_LIM;\n    IEC_LREAL T_RAMP;\n    IEC_LREAL T_HOLD;\n    IEC_LREAL SAT_DT;\n    IEC_LREAL SAT_J;\n    IEC_BOOL VALID_CURR;\n    IEC_LREAL BEST_T_CURR;\n    IEC_LREAL DUR_CURR;\n    IEC_BOOL WINNER_FOUND;\n    IEC_LREAL WINNER_DUR;\n    IEC_LREAL WINNER_T;\n    IEC_LREAL WINNER_J;\n    IEC_LREAL BEST_V;\n    IEC_LREAL V_MID;\n    IEC_LREAL A_MID;\n    IEC_LREAL V_INERTIAL;\n    IEC_LREAL D_INERTIAL;\n    IEC_LREAL T_TO_ZERO;\n    IEC_LREAL J_RESTORE;\n    Array1D<IEC_LREAL, 1, 5> T_SHAPE_BUF;\n    Array1D<IEC_LREAL, 1, 5> J_SHAPE_BUF;\n    IEC_INT SHAPE_CNT;\n    IEC_INT REF_IDX;\n    IEC_LREAL MAX_DT;\n    IEC_LREAL DT_FIX;\n    IEC_LREAL V_CRUISE_START;\n    IEC_LREAL EPS_TIME;\n    IEC_LREAL EPS_VAL;\n    IEC_LREAL EPS_ACC;\n    IEC_LREAL EPS_DIST;\n    IEC_LREAL MATH_EPS;\n    IEC_LREAL SOLVER_TOL;\n    IEC_LREAL SOLVER_EPS;\n    IEC_LREAL SOLVER_COARSE;\n    IEC_INT MAX_ITER;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    FB_S7RTT_PLAN();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~FB_S7RTT_PLAN() = default;\n};\n",
      "cpp": "FB_S7RTT_PLAN::FB_S7RTT_PLAN()\n    : EPS_TIME(1e-10), EPS_VAL(1e-10), EPS_ACC(1e-10), EPS_DIST(1e-10), MATH_EPS(1e-10), SOLVER_TOL(1e-10), SOLVER_EPS(2.22e-16), SOLVER_COARSE(0.0001), MAX_ITER(50)\n{\n    // Initialize variables\n}\n\nvoid FB_S7RTT_PLAN::operator()() {\n    TRIG_EXEC = (EXECUTE) & (!PREV_EXEC);\n    PREV_EXEC = EXECUTE;\n    if (!EXECUTE) {\n        DONE = false;\n        ERROR = false;\n        return;\n    }\n    if (!TRIG_EXEC) {\n        return;\n    }\n    DONE = false;\n    ERROR = false;\n    SEGMENTCOUNT = 0;\n    OPT_SUCCESS = false;\n    if (((LIMITS.FVELMAX <= 0.0) | (LIMITS.FACCMAX <= 0.0)) | (LIMITS.FJERKMAX <= 0.0)) {\n        ERROR = true;\n        return;\n    }\n    C_POS = STARTSTATE.FPOS;\n    C_VEL = STARTSTATE.FVEL;\n    C_ACC = STARTSTATE.FACC;\n    if (C_ACC > LIMITS.FACCMAX + EPS_ACC) {\n        J_RESTORE = -LIMITS.FJERKMAX;\n        LIMIT_A = LIMITS.FACCMAX;\n        T_REC = (C_ACC - LIMIT_A) / (-J_RESTORE);\n        if (T_REC > EPS_TIME) {\n            SEGMENTCOUNT = SEGMENTCOUNT + 1;\n            TRAJECTORY.at(SEGMENTCOUNT).FDURATION = T_REC;\n            TRAJECTORY.at(SEGMENTCOUNT).FJERK = J_RESTORE;\n            C_POS = C_POS + C_VEL * T_REC + 0.5 * C_ACC * T_REC * T_REC + (1.0 / 6.0) * J_RESTORE * T_REC * T_REC * T_REC;\n            C_VEL = C_VEL + C_ACC * T_REC + 0.5 * J_RESTORE * T_REC * T_REC;\n            C_ACC = LIMIT_A;\n        }\n    } else if (C_ACC < -LIMITS.FACCMAX - EPS_ACC) {\n        J_RESTORE = LIMITS.FJERKMAX;\n        LIMIT_A = -LIMITS.FACCMAX;\n        T_REC = (C_ACC - LIMIT_A) / (-J_RESTORE);\n        if (T_REC > EPS_TIME) {\n            SEGMENTCOUNT = SEGMENTCOUNT + 1;\n            TRAJECTORY.at(SEGMENTCOUNT).FDURATION = T_REC;\n            TRAJECTORY.at(SEGMENTCOUNT).FJERK = J_RESTORE;\n            C_POS = C_POS + C_VEL * T_REC + 0.5 * C_ACC * T_REC * T_REC + (1.0 / 6.0) * J_RESTORE * T_REC * T_REC * T_REC;\n            C_VEL = C_VEL + C_ACC * T_REC + 0.5 * J_RESTORE * T_REC * T_REC;\n            C_ACC = LIMIT_A;\n        }\n    }\n    if (MODEVELOCITY) {\n        V_MID = TARGETVEL;\n        if (V_MID > LIMITS.FVELMAX) {\n            V_MID = LIMITS.FVELMAX;\n        }\n        if (V_MID < -LIMITS.FVELMAX) {\n            V_MID = -LIMITS.FVELMAX;\n        }\n        SHAPE_CNT = FC_S7RTT_BUILDPROFILE(C_VEL, C_ACC, V_MID, LIMITS.FACCMAX, LIMITS.FJERKMAX, T_SHAPE_BUF, J_SHAPE_BUF);\n        if (SHAPE_CNT > 0) {\n            for (I = 1; I <= SHAPE_CNT; I++) {\n                if (SEGMENTCOUNT < 32) {\n                    SEGMENTCOUNT = SEGMENTCOUNT + 1;\n                    TRAJECTORY.at(SEGMENTCOUNT).FDURATION = T_SHAPE_BUF.at(I);\n                    TRAJECTORY.at(SEGMENTCOUNT).FJERK = J_SHAPE_BUF.at(I);\n                }\n            }\n        } else {\n            for (I = 1; I <= 31; I++) {\n                SEGMENTCOUNT = SEGMENTCOUNT + 1;\n                TRAJECTORY.at(SEGMENTCOUNT).FDURATION = 0;\n                TRAJECTORY.at(SEGMENTCOUNT).FJERK = 0;\n            }\n        }\n    } else {\n        DIST_REQ = TARGETPOS - C_POS;\n        D_UPPER = FC_S7RTT_CALCTRAJDIST(LIMITS.FVELMAX, C_VEL, C_ACC, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX);\n        D_LOWER = FC_S7RTT_CALCTRAJDIST(-LIMITS.FVELMAX, C_VEL, C_ACC, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX);\n        USE_OPTIMAL = true;\n        if (DIST_REQ > D_UPPER + EPS_DIST) {\n            USE_OPTIMAL = false;\n        }\n        if (DIST_REQ < D_LOWER - EPS_DIST) {\n            USE_OPTIMAL = false;\n        }\n        if (USE_OPTIMAL) {\n            WINNER_FOUND = false;\n            WINNER_DUR = 10000000000.0;\n            T_EST = (ABS(C_VEL) + LIMITS.FVELMAX) / LIMITS.FACCMAX;\n            if (T_EST < 1.0) {\n                T_EST = 1.0;\n            }\n            SEARCH_HORIZON = T_EST * 2.0 + 5.0;\n            for (J_IDX = 0; J_IDX <= 1; J_IDX++) {\n                if (J_IDX == 0) {\n                    J_APPLY = LIMITS.FJERKMAX;\n                } else {\n                    J_APPLY = -LIMITS.FJERKMAX;\n                }\n                VALID_CURR = false;\n                SA = 0.0;\n                SB = SEARCH_HORIZON;\n                SIM_P = C_POS;\n                SIM_V = C_VEL;\n                SIM_A = C_ACC;\n                SHAPE_CNT = FC_S7RTT_BUILDPROFILE(SIM_V, SIM_A, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX, T_SHAPE_BUF, J_SHAPE_BUF);\n                for (K = 1; K <= SHAPE_CNT; K++) {\n                    SIM_P = SIM_P + SIM_V * T_SHAPE_BUF.at(K) + 0.5 * SIM_A * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) + (1.0 / 6.0) * J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                    SIM_V = SIM_V + SIM_A * T_SHAPE_BUF.at(K) + 0.5 * J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                    SIM_A = SIM_A + J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                }\n                FA = SIM_P - TARGETPOS;\n                if (ABS(FA) < SOLVER_COARSE) {\n                    BEST_T_CURR = 0.0;\n                    VALID_CURR = true;\n                } else {\n                    SIM_P = C_POS;\n                    SIM_V = C_VEL;\n                    SIM_A = C_ACC;\n                    LIMIT_A = LIMITS.FACCMAX;\n                    if (J_APPLY < 0) {\n                        LIMIT_A = -LIMITS.FACCMAX;\n                    }\n                    DIST_TO_LIM = LIMIT_A - SIM_A;\n                    if ((((J_APPLY > 0) & (DIST_TO_LIM > -MATH_EPS))) | (((J_APPLY < 0) & (DIST_TO_LIM < MATH_EPS)))) {\n                        T_RAMP = DIST_TO_LIM / J_APPLY;\n                    } else {\n                        T_RAMP = 0.0;\n                    }\n                    if (SB <= T_RAMP) {\n                        SIM_P = SIM_P + SIM_V * SB + 0.5 * SIM_A * SB * SB + (1.0 / 6.0) * J_APPLY * SB * SB * SB;\n                        SIM_V = SIM_V + SIM_A * SB + 0.5 * J_APPLY * SB * SB;\n                        SIM_A = SIM_A + J_APPLY * SB;\n                    } else {\n                        SIM_P = SIM_P + SIM_V * T_RAMP + 0.5 * SIM_A * T_RAMP * T_RAMP + (1.0 / 6.0) * J_APPLY * T_RAMP * T_RAMP * T_RAMP;\n                        SIM_V = SIM_V + SIM_A * T_RAMP + 0.5 * J_APPLY * T_RAMP * T_RAMP;\n                        SIM_A = SIM_A + J_APPLY * T_RAMP;\n                        SIM_A = LIMIT_A;\n                        T_HOLD = SB - T_RAMP;\n                        SIM_P = SIM_P + SIM_V * T_HOLD + 0.5 * SIM_A * T_HOLD * T_HOLD;\n                        SIM_V = SIM_V + SIM_A * T_HOLD;\n                    }\n                    SHAPE_CNT = FC_S7RTT_BUILDPROFILE(SIM_V, SIM_A, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX, T_SHAPE_BUF, J_SHAPE_BUF);\n                    for (K = 1; K <= SHAPE_CNT; K++) {\n                        SIM_P = SIM_P + SIM_V * T_SHAPE_BUF.at(K) + 0.5 * SIM_A * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) + (1.0 / 6.0) * J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                        SIM_V = SIM_V + SIM_A * T_SHAPE_BUF.at(K) + 0.5 * J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                        SIM_A = SIM_A + J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                    }\n                    FB = SIM_P - TARGETPOS;\n                    if (FA * FB <= 0.0) {\n                        SC = SA;\n                        FC = FA;\n                        SD = SB - SA;\n                        SE = SD;\n                        MFLAG = true;\n                        for (ITER = 1; ITER <= MAX_ITER; ITER++) {\n                            if (ABS(FC) < ABS(FB)) {\n                                SA = SB;\n                                SB = SC;\n                                SC = SA;\n                                FA = FB;\n                                FB = FC;\n                                FC = FA;\n                            }\n                            TOL1 = 2.0 * SOLVER_EPS * ABS(SB) + 0.5 * SOLVER_TOL;\n                            XM = 0.5 * (SC - SB);\n                            if ((ABS(XM) <= TOL1) | (FB == 0.0)) {\n                                goto __strucpp_loop_exit_5;\n                            }\n                            if ((ABS(SE) >= TOL1) & (ABS(FA) > ABS(FB))) {\n                                FCOEFS = FB / FA;\n                                if (SA == SC) {\n                                    FCOEFP = 2.0 * XM * FCOEFS;\n                                    FCOEFQ = 1.0 - FCOEFS;\n                                } else {\n                                    FCOEFQ = FA / FC;\n                                    FCOEFR = FB / FC;\n                                    FCOEFP = FCOEFS * (2.0 * XM * FCOEFQ * (FCOEFQ - FCOEFR) - (SB - SA) * (FCOEFR - 1.0));\n                                    FCOEFQ = (FCOEFQ - 1.0) * (FCOEFR - 1.0) * (FCOEFS - 1.0);\n                                }\n                                if (FCOEFP > 0.0) {\n                                    FCOEFQ = -FCOEFQ;\n                                }\n                                FCOEFP = ABS(FCOEFP);\n                                MIN1 = 3.0 * XM * FCOEFQ - ABS(TOL1 * FCOEFQ);\n                                MIN2 = ABS(SE * FCOEFQ);\n                                if (2.0 * FCOEFP < MIN1) {\n                                    if (MFLAG) {\n                                        if (2.0 * FCOEFP < MIN2) {\n                                            SE = SD;\n                                            SD = FCOEFP / FCOEFQ;\n                                            MFLAG = false;\n                                        } else {\n                                            SD = XM;\n                                            SE = SD;\n                                            MFLAG = true;\n                                        }\n                                    } else {\n                                        if (2.0 * FCOEFP < ABS(SD * FCOEFQ)) {\n                                            SE = SD;\n                                            SD = FCOEFP / FCOEFQ;\n                                            MFLAG = false;\n                                        } else {\n                                            SD = XM;\n                                            SE = SD;\n                                            MFLAG = true;\n                                        }\n                                    }\n                                } else {\n                                    SD = XM;\n                                    SE = SD;\n                                    MFLAG = true;\n                                }\n                            } else {\n                                SD = XM;\n                                SE = SD;\n                                MFLAG = true;\n                            }\n                            SA = SB;\n                            FA = FB;\n                            if (ABS(SD) > TOL1) {\n                                SB = SB + SD;\n                            } else {\n                                if (XM > 0.0) {\n                                    SB = SB + TOL1;\n                                } else {\n                                    SB = SB - TOL1;\n                                }\n                            }\n                            SIM_P = C_POS;\n                            SIM_V = C_VEL;\n                            SIM_A = C_ACC;\n                            LIMIT_A = LIMITS.FACCMAX;\n                            if (J_APPLY < 0) {\n                                LIMIT_A = -LIMITS.FACCMAX;\n                            }\n                            DIST_TO_LIM = LIMIT_A - SIM_A;\n                            if ((((J_APPLY > 0) & (DIST_TO_LIM > -MATH_EPS))) | (((J_APPLY < 0) & (DIST_TO_LIM < MATH_EPS)))) {\n                                T_RAMP = DIST_TO_LIM / J_APPLY;\n                            } else {\n                                T_RAMP = 0.0;\n                            }\n                            if (SB <= T_RAMP) {\n                                if (SB > EPS_TIME) {\n                                    SIM_P = SIM_P + SIM_V * SB + 0.5 * SIM_A * SB * SB + (1.0 / 6.0) * J_APPLY * SB * SB * SB;\n                                    SIM_V = SIM_V + SIM_A * SB + 0.5 * J_APPLY * SB * SB;\n                                    SIM_A = SIM_A + J_APPLY * SB;\n                                }\n                            } else {\n                                if (T_RAMP > EPS_TIME) {\n                                    SIM_P = SIM_P + SIM_V * T_RAMP + 0.5 * SIM_A * T_RAMP * T_RAMP + (1.0 / 6.0) * J_APPLY * T_RAMP * T_RAMP * T_RAMP;\n                                    SIM_V = SIM_V + SIM_A * T_RAMP + 0.5 * J_APPLY * T_RAMP * T_RAMP;\n                                    SIM_A = SIM_A + J_APPLY * T_RAMP;\n                                }\n                                SIM_A = LIMIT_A;\n                                T_HOLD = SB - T_RAMP;\n                                if (T_HOLD > EPS_TIME) {\n                                    SIM_P = SIM_P + SIM_V * T_HOLD + 0.5 * SIM_A * T_HOLD * T_HOLD;\n                                    SIM_V = SIM_V + SIM_A * T_HOLD;\n                                }\n                            }\n                            SHAPE_CNT = FC_S7RTT_BUILDPROFILE(SIM_V, SIM_A, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX, T_SHAPE_BUF, J_SHAPE_BUF);\n                            for (K = 1; K <= SHAPE_CNT; K++) {\n                                SIM_P = SIM_P + SIM_V * T_SHAPE_BUF.at(K) + 0.5 * SIM_A * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) + (1.0 / 6.0) * J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                                SIM_V = SIM_V + SIM_A * T_SHAPE_BUF.at(K) + 0.5 * J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                                SIM_A = SIM_A + J_SHAPE_BUF.at(K) * T_SHAPE_BUF.at(K);\n                            }\n                            FB = SIM_P - TARGETPOS;\n                            if ((((FB > 0.0) & (FC > 0.0))) | (((FB < 0.0) & (FC < 0.0)))) {\n                                SC = SA;\n                                FC = FA;\n                                SD = SB - SA;\n                                SE = SD;\n                                MFLAG = true;\n                            }\n                        }\n                        __strucpp_loop_exit_5: ;\n                        BEST_T_CURR = SB;\n                        if (ABS(FB) <= SOLVER_COARSE) {\n                            VALID_CURR = true;\n                        }\n                    }\n                }\n                if (VALID_CURR) {\n                    DUR_CURR = 0.0;\n                    LIMIT_A = LIMITS.FACCMAX;\n                    if (J_APPLY < 0) {\n                        LIMIT_A = -LIMITS.FACCMAX;\n                    }\n                    DIST_TO_LIM = LIMIT_A - C_ACC;\n                    if ((((J_APPLY > 0) & (DIST_TO_LIM > -MATH_EPS))) | (((J_APPLY < 0) & (DIST_TO_LIM < MATH_EPS)))) {\n                        T_RAMP = DIST_TO_LIM / J_APPLY;\n                    } else {\n                        T_RAMP = 0.0;\n                    }\n                    if (BEST_T_CURR <= T_RAMP) {\n                        DUR_CURR = BEST_T_CURR;\n                    } else {\n                        DUR_CURR = BEST_T_CURR;\n                    }\n                    SIM_P = C_POS;\n                    SIM_V = C_VEL;\n                    SIM_A = C_ACC;\n                    if (BEST_T_CURR <= T_RAMP) {\n                        if (BEST_T_CURR > EPS_TIME) {\n                            SIM_V = SIM_V + SIM_A * BEST_T_CURR + 0.5 * J_APPLY * BEST_T_CURR * BEST_T_CURR;\n                            SIM_A = SIM_A + J_APPLY * BEST_T_CURR;\n                        }\n                    } else {\n                        if (T_RAMP > EPS_TIME) {\n                            SIM_V = SIM_V + SIM_A * T_RAMP + 0.5 * J_APPLY * T_RAMP * T_RAMP;\n                            SIM_A = SIM_A + J_APPLY * T_RAMP;\n                        }\n                        SIM_A = LIMIT_A;\n                        T_HOLD = BEST_T_CURR - T_RAMP;\n                        if (T_HOLD > EPS_TIME) {\n                            SIM_V = SIM_V + SIM_A * T_HOLD;\n                        }\n                    }\n                    SHAPE_CNT = FC_S7RTT_BUILDPROFILE(SIM_V, SIM_A, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX, T_SHAPE_BUF, J_SHAPE_BUF);\n                    for (K = 1; K <= SHAPE_CNT; K++) {\n                        DUR_CURR = DUR_CURR + T_SHAPE_BUF.at(K);\n                    }\n                    if (DUR_CURR < WINNER_DUR) {\n                        WINNER_DUR = DUR_CURR;\n                        WINNER_T = BEST_T_CURR;\n                        WINNER_J = J_APPLY;\n                        WINNER_FOUND = true;\n                    }\n                }\n            }\n            if (WINNER_FOUND) {\n                OPT_SUCCESS = true;\n                LIMIT_A = LIMITS.FACCMAX;\n                if (WINNER_J < 0) {\n                    LIMIT_A = -LIMITS.FACCMAX;\n                }\n                DIST_TO_LIM = LIMIT_A - C_ACC;\n                if ((((WINNER_J > 0) & (DIST_TO_LIM > -MATH_EPS))) | (((WINNER_J < 0) & (DIST_TO_LIM < MATH_EPS)))) {\n                    T_RAMP = DIST_TO_LIM / WINNER_J;\n                } else {\n                    T_RAMP = 0.0;\n                }\n                if (WINNER_T <= T_RAMP) {\n                    if (WINNER_T > EPS_TIME) {\n                        if (SEGMENTCOUNT < 32) {\n                            SEGMENTCOUNT = SEGMENTCOUNT + 1;\n                            TRAJECTORY.at(SEGMENTCOUNT).FDURATION = WINNER_T;\n                            TRAJECTORY.at(SEGMENTCOUNT).FJERK = WINNER_J;\n                        }\n                        C_POS = C_POS + C_VEL * WINNER_T + 0.5 * C_ACC * WINNER_T * WINNER_T + (1.0 / 6.0) * WINNER_J * WINNER_T * WINNER_T * WINNER_T;\n                        C_VEL = C_VEL + C_ACC * WINNER_T + 0.5 * WINNER_J * WINNER_T * WINNER_T;\n                        C_ACC = C_ACC + WINNER_J * WINNER_T;\n                    }\n                } else {\n                    if (T_RAMP > EPS_TIME) {\n                        if (SEGMENTCOUNT < 32) {\n                            SEGMENTCOUNT = SEGMENTCOUNT + 1;\n                            TRAJECTORY.at(SEGMENTCOUNT).FDURATION = T_RAMP;\n                            TRAJECTORY.at(SEGMENTCOUNT).FJERK = WINNER_J;\n                        }\n                        C_POS = C_POS + C_VEL * T_RAMP + 0.5 * C_ACC * T_RAMP * T_RAMP + (1.0 / 6.0) * WINNER_J * T_RAMP * T_RAMP * T_RAMP;\n                        C_VEL = C_VEL + C_ACC * T_RAMP + 0.5 * WINNER_J * T_RAMP * T_RAMP;\n                        C_ACC = C_ACC + WINNER_J * T_RAMP;\n                    }\n                    C_ACC = LIMIT_A;\n                    T_HOLD = WINNER_T - T_RAMP;\n                    if (T_HOLD > EPS_TIME) {\n                        if (SEGMENTCOUNT < 32) {\n                            SEGMENTCOUNT = SEGMENTCOUNT + 1;\n                            TRAJECTORY.at(SEGMENTCOUNT).FDURATION = T_HOLD;\n                            TRAJECTORY.at(SEGMENTCOUNT).FJERK = 0.0;\n                        }\n                        C_POS = C_POS + C_VEL * T_HOLD + 0.5 * C_ACC * T_HOLD * T_HOLD;\n                        C_VEL = C_VEL + C_ACC * T_HOLD;\n                    }\n                }\n                SHAPE_CNT = FC_S7RTT_BUILDPROFILE(C_VEL, C_ACC, TARGETVEL, LIMITS.FACCMAX, LIMITS.FJERKMAX, T_SHAPE_BUF, J_SHAPE_BUF);\n                for (I = 1; I <= SHAPE_CNT; I++) {\n                    if (SEGMENTCOUNT < 32) {\n                        SEGMENTCOUNT = SEGMENTCOUNT + 1;\n                        TRAJECTORY.at(SEGMENTCOUNT).FDURATION = T_SHAPE_BUF.at(I);\n                        TRAJECTORY.at(SEGMENTCOUNT).FJERK = J_SHAPE_BUF.at(I);\n                    }\n                }\n            }\n        }\n      