      "header": "enum class MC_DIRECTION { MCD_NEGATIVE = -1, MCD_CURRENT = 0, MCD_POSITIVE = 1, MCD_SHORTEST = 2, MCD_FASTEST = 3 };\n\nusing IEC_MC_DIRECTION = IEC_ENUM<MC_DIRECTION>;\n",
      "cpp": "",
