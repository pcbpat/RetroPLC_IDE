      "kind": "functionBlock",
      "header": "class OPENSML_SYNCPOSITION {\npublic:\n    // In-Out\n    OPENSML_AXIS AXIS;\n    // Inputs\n    IEC_LREAL MAXVELOCITY;\n    IEC_LREAL MAXACCELERATION;\n    IEC_LREAL MAXJERK;\n    IEC_LREAL CYCLETIME;\n    IEC_LREAL TARGETPOSITION;\n    IEC_BOOL XENABLE;\n    IEC_LREAL LRSCALE;\n    IEC_BOOL XSIMULATION;\n    // Outputs\n    IEC_BOOL XERROR;\n    // Local variables\n    FB_S7RTT_OTG OTG;\n    IEC_INT ISTATE;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    OPENSML_SYNCPOSITION();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~OPENSML_SYNCPOSITION() = default;\n};\n",
      "cpp": "OPENSML_SYNCPOSITION::OPENSML_SYNCPOSITION()\n    : MAXVELOCITY(2000), MAXACCELERATION(200), MAXJERK(200), CYCLETIME(0.001), LRSCALE(1.0)\n{\n    // Initialize variables\n}\n\nvoid OPENSML_SYNCPOSITION::operator()() {\n    switch (ISTATE) {\n        case 0:\n            XERROR = false;\n            if (((((XENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY == 8)) & (!((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) {\n                ISTATE = 10;\n            } else if (((XENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY != 8)) {\n                AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((false ? 1ULL : 0ULL) << 3);\n                ISTATE = 10;\n            } else if (XSIMULATION) {\n                ISTATE = 20;\n            } else if (XENABLE) {\n                ISTATE = 999;\n            }\n            break;\n        case 10:\n            AXIS.MODES_OF_OPERATION = 8;\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((AXIS.MODES_OF_OPERATION_DISPLAY == 8 ? 1ULL : 0ULL) << 3);\n            OTG.CURRENTPOSITION = TO_LREAL(AXIS.POSITION_ACTUAL_VALUE) / LRSCALE;\n            if ((((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1)) & (AXIS.MODES_OF_OPERATION_DISPLAY == 8)) {\n                ISTATE = 20;\n            }\n            break;\n        case 20:\n            OTG.CONTROLINTERFACE = false;\n            OTG.TARGETPOSITION = TARGETPOSITION;\n            OTG.TARGETVELOCITY = 0;\n            OTG.CYCLETIME = CYCLETIME;\n            OTG.MAXVELOCITY = MAXVELOCITY;\n            OTG.MAXACCELERATION = MAXACCELERATION;\n            OTG.MAXJERK = MAXJERK;\n            OTG();\n            OTG.ENO = true;\n            if (OTG.NEWPOSITION >= 0) {\n                AXIS.TARGET_POSITION = TO_DINT(OTG.NEWPOSITION * LRSCALE);\n            } else {\n                AXIS.TARGET_POSITION = -TO_DINT(-OTG.NEWPOSITION * LRSCALE);\n            }\n            if (((((static_cast<uint64_t>(AXIS.STATUSWORD) >> 13) & 1)) | (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) | (OTG.XERROR)) {\n                ISTATE = 999;\n            } else if (!XENABLE) {\n                ISTATE = 0;\n            }\n            break;\n        case 999:\n            XERROR = true;\n            if (!XENABLE) {\n                ISTATE = 0;\n            }\n            break;\n    }\n}\n",
