    {
      "name": "OPENSML_HOME",
      "kind": "functionBlock",
      "header": "class OPENSML_HOME {\npublic:\n    // In-Out\n    OPENSML_AXIS AXIS;\n    // Inputs\n    IEC_BOOL XENABLE;\n    // Outputs\n    IEC_BOOL XDONE;\n    IEC_BOOL XERROR;\n    // Local variables\n    IEC_INT ISTATE;\n    TON TONTIMEOUT;\n    IEC_DINT POS_OLD;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    OPENSML_HOME();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~OPENSML_HOME() = default;\n};\n",
      "cpp": "OPENSML_HOME::OPENSML_HOME() {\n    // Initialize variables\n}\n\nvoid OPENSML_HOME::operator()() {\n    switch (ISTATE) {\n        case 0:\n            XDONE = false;\n            XERROR = false;\n            if (((((XENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY == 6)) & (!((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) {\n                ISTATE = 10;\n            } else if (((XENABLE) & (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 1) & 1))) & (AXIS.MODES_OF_OPERATION_DISPLAY != 6)) {\n                AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((false ? 1ULL : 0ULL) << 3);\n                ISTATE = 10;\n            } else if (XENABLE) {\n                ISTATE = 999;\n            }\n            break;\n        case 10:\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 4)) | ((false ? 1ULL : 0ULL) << 4);\n            AXIS.MODES_OF_OPERATION = 6;\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 3)) | ((AXIS.MODES_OF_OPERATION_DISPLAY == 6 ? 1ULL : 0ULL) << 3);\n            if (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 2) & 1)) {\n                ISTATE = 20;\n            }\n            break;\n        case 20:\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 4)) | ((true ? 1ULL : 0ULL) << 4);\n            TONTIMEOUT.IN = AXIS.POSITION_ACTUAL_VALUE == POS_OLD;\n            TONTIMEOUT.PT = 10000000000LL;\n            TONTIMEOUT();\n            TONTIMEOUT.ENO = true;\n            POS_OLD = AXIS.POSITION_ACTUAL_VALUE;\n            if (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 12) & 1)) {\n                TONTIMEOUT.IN = false;\n                TONTIMEOUT();\n                TONTIMEOUT.ENO = true;\n                AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 4)) | ((false ? 1ULL : 0ULL) << 4);\n                AXIS.TARGET_POSITION = AXIS.POSITION_ACTUAL_VALUE;\n                ISTATE = 30;\n            } else if ((((TONTIMEOUT.Q) | (!XENABLE)) | (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 3) & 1))) | (((static_cast<uint64_t>(AXIS.STATUSWORD) >> 13) & 1))) {\n                ISTATE = 999;\n            }\n            break;\n        case 30:\n            XDONE = true;\n            if (!XENABLE) {\n                ISTATE = 0;\n            }\n            break;\n        case 999:\n            TONTIMEOUT.IN = false;\n            TONTIMEOUT();\n            TONTIMEOUT.ENO = true;\n            AXIS.CONTROLWORD = (AXIS.CONTROLWORD & ~(1ULL << 4)) | ((false ? 1ULL : 0ULL) << 4);\n            XERROR = true;\n            if (!XENABLE) {\n                ISTATE = 0;\n            }\n            break;\n    }\n}\n",
